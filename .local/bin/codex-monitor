#!/usr/bin/env python3
"""Open the terminal CLI, or --gui, on Codex Monitor's shared native server."""
import os
from pathlib import Path
import shutil
import sys


def main():
    arguments = sys.argv[1:]
    if arguments[:1] in (['--help'], ['-h']):
        print('Usage: codex-monitor [CLI options]\n'
              '     codex-monitor --gui [application options]\n\n'
              'Without --gui, opens the CLI in the terminal. Both use the same server.\n'
              'Use codex-monitor -- --help to see CLI options.')
        return 0
    gui = arguments[:1] == ['--gui']
    if gui or arguments[:1] == ['--']:
        arguments = arguments[1:]
    try:
        application = shutil.which('chatgpt')
        if application is None:
            raise RuntimeError('chatgpt was not found in PATH; check the application installation.')
        directory = Path(application).resolve(strict=True).parent
        control = Path(__file__).resolve(strict=True).with_name('codex-session-stats')
        command = [str(control), 'monitor-gitlab', 'launch-app' if gui else 'launch-cli',
                   '--codex', str(directory / 'resources/codex')]
        if gui:
            command.extend(['--app', str(directory / 'ChatGPT')])
        else:
            cli = shutil.which('codex')
            if cli is None:
                raise RuntimeError('codex was not found in PATH; check the CLI installation.')
            command.extend(['--cli', cli])
        python = control.parents[2] / 'scripts/.venv/bin/python'
        if not python.is_file():
            raise RuntimeError('The monitor Python environment was not found; in ~/scripts, '
                               'run poetry install --with monitor-tools.')
        os.execv(python, [str(python), *command, '--', *arguments])
    except (OSError, RuntimeError) as error:
        print('Codex Monitor — could not open: ' + str(error), file=sys.stderr)
        if gui:
            import subprocess
            dialog = shutil.which('zenity')
            if dialog:
                subprocess.run([dialog, '--error', '--title=Codex Monitor', '--text=' + str(error)], check=False)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
