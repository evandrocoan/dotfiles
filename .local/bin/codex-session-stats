#!/usr/bin/env python3
from __future__ import annotations

import argparse
import csv
import datetime
import hashlib
import json
import os
import re
import sqlite3
import sys
from collections import defaultdict
from pathlib import Path
from urllib.parse import quote
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


TIMESTAMP_PATTERN = re.compile(br'^\{"timestamp":"([^"]+)"')
STATE_DATABASE_PATTERN = re.compile(r"state_(\d+)\.sqlite$")
LOG_DATABASE_PATTERN = re.compile(r"logs_(\d+)\.sqlite$")
NATIVE_LOG_FIELD_PATTERN = re.compile(
    r'([A-Za-z_][A-Za-z0-9_.]*)=("(?:[^"\\]|\\.)*"|[^\s{}"]+)'
)
FINISHED_EVENTS = {
    "task_complete",
    "task_aborted",
    "task_interrupted",
    "task_cancelled",
}
CURRENT_FINISHED_EVENTS = FINISHED_EVENTS | {"turn_aborted"}


class CurrentStateUnavailable(RuntimeError):
    """The state index cannot locate this thread; not a rollout validation failure."""


def positive_integer(value: str) -> int:
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("the value must be greater than zero")
    return number


def parse_arguments() -> argparse.Namespace:
    default_codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    parser = argparse.ArgumentParser(
        description="List the longest Codex executions recorded in local session history.",
        epilog="Use 'codex-session-stats current --help' for current client settings or "
        "'codex-session-stats find --help' to search conversations.",
    )
    parser.add_argument(
        "--limit",
        type=positive_integer,
        default=20,
        help="maximum number of executions to show (default: 20)",
    )
    parser.add_argument(
        "--project",
        help="case-insensitive filter applied to the working directory, session name and request",
    )
    parser.add_argument(
        "--since",
        metavar="YYYY-MM-DD",
        help="include executions started on or after this local date",
    )
    parser.add_argument(
        "--until",
        metavar="YYYY-MM-DD",
        help="include executions started on or before this local date",
    )
    parser.add_argument(
        "--format",
        choices=("markdown", "csv", "json"),
        default="markdown",
        help="output format (default: markdown)",
    )
    parser.add_argument(
        "--timezone",
        default="America/Sao_Paulo",
        help="IANA timezone used for dates (default: America/Sao_Paulo)",
    )
    parser.add_argument(
        "--codex-home",
        type=Path,
        default=default_codex_home,
        help="Codex state directory (default: CODEX_HOME or ~/.codex)",
    )
    parser.add_argument(
        "--include-active",
        action="store_true",
        help="include executions without a completion event",
    )
    parser.add_argument(
        "--all-agents",
        action="store_true",
        help="include subagents and automatic reviewers",
    )
    parser.add_argument(
        "--skip-gap-analysis",
        action="store_true",
        help="skip calculation of the largest interval without events",
    )
    parser.add_argument(
        "--max-description",
        type=positive_integer,
        default=160,
        help="maximum request length in Markdown output (default: 160)",
    )
    return parser.parse_args()


def parse_timestamp(value: str | bytes) -> float:
    if isinstance(value, bytes):
        value = value.decode("ascii")
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()


def timestamp_from_line(line: bytes) -> float | None:
    match = TIMESTAMP_PATTERN.match(line)
    if not match:
        return None
    try:
        return parse_timestamp(match.group(1))
    except ValueError:
        return None


def find_state_database(codex_home: Path) -> Path:
    candidates = []
    for path in codex_home.glob("state_*.sqlite"):
        match = STATE_DATABASE_PATTERN.search(path.name)
        if match:
            candidates.append((int(match.group(1)), path))
    if not candidates:
        raise RuntimeError(f"no state_*.sqlite database found in {codex_home}")
    return max(candidates, key=lambda item: item[0])[1]


def open_read_only_database(path: Path) -> sqlite3.Connection:
    encoded_path = quote(str(path.resolve()), safe="/")
    connection = sqlite3.connect(f"file:{encoded_path}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    return connection


def load_session_names(codex_home: Path) -> dict[str, str]:
    names = {}
    index_path = codex_home / "session_index.jsonl"
    if not index_path.exists():
        return names
    with index_path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            thread_id = item.get("id")
            thread_name = item.get("thread_name")
            if thread_id and thread_name:
                names[thread_id] = thread_name
    return names


def load_threads(codex_home: Path) -> list[dict[str, object]]:
    state_database = find_state_database(codex_home)
    with open_read_only_database(state_database) as connection:
        available_columns = {
            row[1] for row in connection.execute("pragma table_info(threads)")
        }
        required_columns = {"id", "rollout_path"}
        missing_columns = required_columns - available_columns
        if missing_columns:
            missing = ", ".join(sorted(missing_columns))
            raise RuntimeError(f"threads table is missing required columns: {missing}")

        optional_columns = (
            "source",
            "thread_source",
            "agent_path",
            "name",
            "title",
            "first_user_message",
            "cwd",
            "model",
            "reasoning_effort",
        )
        expressions = ["id", "rollout_path"]
        expressions.extend(
            column if column in available_columns else f"null as {column}"
            for column in optional_columns
        )
        query = f"select {', '.join(expressions)} from threads"
        return [dict(row) for row in connection.execute(query)]


def load_current_rollout(codex_home: Path, thread_id: str) -> Path:
    try:
        state_database = find_state_database(codex_home)
    except RuntimeError as error:
        raise CurrentStateUnavailable(str(error)) from error
    try:
        with open_read_only_database(state_database) as connection:
            row = connection.execute(
                "select rollout_path from threads where id = ?", (thread_id,)
            ).fetchone()
    except (OSError, sqlite3.Error) as error:
        raise CurrentStateUnavailable(f"session state index is unavailable: {error}") from error
    if row is None:
        raise CurrentStateUnavailable(f"no state record for acting thread {thread_id}")
    rollout_path = Path(str(row["rollout_path"])).expanduser()
    if not rollout_path.is_absolute():
        raise RuntimeError(f"acting thread {thread_id} has no absolute rollout path")
    return rollout_path


def native_log_span(body: str, position: int, name: str) -> tuple[dict, int] | None:
    marker = name + "{"
    if not body.startswith(marker, position):
        return None
    start = position + len(marker)
    end = body.find("}", start)
    if end == -1 or body[end + 1:end + 2] != ":":
        raise RuntimeError("malformed native log span")
    fields = {}
    position = start
    while position < end:
        if body[position].isspace():
            position += 1
            continue
        match = NATIVE_LOG_FIELD_PATTERN.match(body, position, end)
        if match is None or (match.end() != end and not body[match.end()].isspace()):
            raise RuntimeError("malformed native log span fields")
        key, value = match.groups()
        if key in fields:
            raise RuntimeError("conflicting duplicate native log span fields")
        fields[key] = json.loads(value) if value.startswith('"') else value
        position = match.end()
    return fields, end + 2


def codex_log_envelope(body: object, thread_id: str) -> dict | None:
    if body is None:
        return None
    if not isinstance(body, str):
        raise RuntimeError("malformed native log message")
    root = native_log_span(body, 0, "session_loop")
    if root is None:
        return None
    root_fields, position = root
    if root_fields.get("thread_id") != thread_id:
        raise RuntimeError("native log session identity mismatch")
    parents = {}
    for name in ("submission_dispatch", "codex.turn_input"):
        span = native_log_span(body, position, name)
        if span is not None:
            parents[name], position = span
    task = native_log_span(body, position, "turn")
    if task is None:
        return None
    fields, _ = task
    if fields.get("otel.name") != "session_task.turn":
        return None
    if fields.get("thread.id") != thread_id:
        raise RuntimeError("native log turn thread identity mismatch")
    turn_id = validate_session_id(fields.get("turn.id"))
    if "codex.turn_input" in parents:
        parent = parents["codex.turn_input"]
        if parent.get("conversation.id") != thread_id or parent.get("turn.id") != turn_id:
            raise RuntimeError("native log input identity mismatch")
    if "submission_dispatch" in parents:
        parent = parents["submission_dispatch"]
        if parent.get("submission.id") != turn_id or parent.get("codex.op") != "turn_input":
            raise RuntimeError("native log submission identity mismatch")
    return fields


def codex_log_settings(codex_home: Path, thread_id: str) -> dict:
    candidates = [(int(match.group(1)), path) for path in codex_home.glob("logs_*.sqlite")
                  if (match := LOG_DATABASE_PATTERN.fullmatch(path.name))]
    if not candidates:
        raise RuntimeError("no runtime logs database available")
    database_path = max(candidates, key=lambda item: item[0])[1]
    with open_read_only_database(database_path) as connection:
        # Use the thread/timestamp index and stop at the newest task-owned span.
        # Message/tool payloads and parent sessions cannot supply settings.
        rows = connection.execute(
            "select ts, ts_nanos, feedback_log_body from logs where thread_id = ? "
            "and target in (?, ?, ?) order by ts desc, ts_nanos desc, id desc",
            (thread_id, "codex_core::session::turn", "codex_core::tools::parallel",
             "codex_core::session::handlers"),
        )
        for row in rows:
            fields = codex_log_envelope(row["feedback_log_body"], thread_id)
            if fields is None:
                continue
            model = require_runtime_string(fields.get("model"), "native log model")
            effort = require_runtime_string(fields.get("codex.turn.reasoning_effort"), "native log effort")
            if effort.lower() in {"unknown", "unspecified", "default", "null", "unset"}:
                raise RuntimeError("native log has no known reasoning effort")
            seconds, nanos = row["ts"], row["ts_nanos"]
            if type(seconds) is not int or type(nanos) is not int or not 0 <= nanos < 1_000_000_000:
                raise RuntimeError("malformed native log timestamp")
            try:
                observed_at = datetime.datetime.fromtimestamp(seconds, datetime.UTC).strftime("%Y-%m-%dT%H:%M:%S")
            except (OSError, OverflowError, ValueError) as error:
                raise RuntimeError("malformed native log timestamp") from error
            # Logs authenticate the last used settings, not ongoing activity.
            return {
                "turn_id": fields["turn.id"], "model": model, "reasoning_effort": effort,
                "source": "runtime_log", "settings_status": "last_logged",
                "observed_at": f"{observed_at}.{nanos:09d}Z",
            }
    raise RuntimeError(f"no authenticated native log settings for acting thread {thread_id}")


def codex_current_settings(codex_home: Path, thread_id: str) -> dict:
    try:
        rollout_path = load_current_rollout(codex_home, thread_id)
    except CurrentStateUnavailable as state_error:
        try:
            return codex_log_settings(codex_home, thread_id)
        except (OSError, RuntimeError, sqlite3.Error, ValueError) as log_error:
            raise RuntimeError(f"{state_error}; log fallback failed: {log_error}") from log_error
    # A present rollout's identity/lifecycle validation must not be bypassed.
    return current_turn_settings(rollout_path, thread_id)


def current_turn_settings(rollout_path: Path, thread_id: str) -> dict[str, str]:
    metadata_id = None
    metadata_count = 0
    latest_turn_id = None
    latest_turn_finished = False
    started_turns: set[str] = set()
    finished_turns: set[str] = set()
    contexts: dict[str, dict[str, object]] = {}

    with rollout_path.open("rb") as handle:
        for line_number, line in enumerate(handle, start=1):
            try:
                item = json.loads(line)
            except (json.JSONDecodeError, UnicodeDecodeError) as error:
                raise RuntimeError(
                    f"malformed rollout record at line {line_number}"
                ) from error
            if not isinstance(item, dict):
                raise RuntimeError(f"malformed rollout record at line {line_number}")
            item_type = item.get("type")
            payload = item.get("payload")
            if item_type not in {"session_meta", "event_msg", "turn_context"}:
                continue
            if not isinstance(payload, dict):
                raise RuntimeError(f"malformed {item_type} at line {line_number}")

            if item_type == "session_meta":
                metadata_count += 1
                metadata_id = payload.get("id")
            elif item_type == "turn_context":
                turn_id = payload.get("turn_id")
                if not isinstance(turn_id, str) or not turn_id:
                    raise RuntimeError(f"turn context lacks identity at line {line_number}")
                contexts[turn_id] = payload
            elif item_type == "event_msg":
                event_type = payload.get("type")
                if event_type == "task_started":
                    turn_id = payload.get("turn_id")
                    if not isinstance(turn_id, str) or not turn_id:
                        raise RuntimeError(f"task start lacks identity at line {line_number}")
                    started_turns.add(turn_id)
                    latest_turn_id = turn_id
                    latest_turn_finished = False
                elif event_type in CURRENT_FINISHED_EVENTS:
                    turn_id = payload.get("turn_id")
                    if not isinstance(turn_id, str) or not turn_id:
                        raise RuntimeError(f"task finish lacks identity at line {line_number}")
                    finished_turns.add(turn_id)
                    if turn_id == latest_turn_id:
                        latest_turn_finished = True

    if metadata_count != 1 or metadata_id != thread_id:
        raise RuntimeError(f"rollout identity does not match acting thread {thread_id}")
    unstarted_contexts = set(contexts) - started_turns
    if unstarted_contexts:
        turn_id = sorted(unstarted_contexts)[0]
        raise RuntimeError(f"turn context {turn_id} has no matching task start")
    unstarted_finishes = finished_turns - started_turns
    if unstarted_finishes:
        turn_id = sorted(unstarted_finishes)[0]
        raise RuntimeError(f"task finish {turn_id} has no matching task start")
    if latest_turn_id is None:
        raise RuntimeError(f"acting thread {thread_id} has no started turn")
    if latest_turn_finished:
        raise RuntimeError(f"latest turn {latest_turn_id} is no longer active")
    context = contexts.get(latest_turn_id)
    if context is None:
        raise RuntimeError(f"latest turn {latest_turn_id} has no context")
    model = context.get("model")
    if not isinstance(model, str) or not model.strip():
        raise RuntimeError(f"latest turn {latest_turn_id} has no model")
    primary_effort = context.get("effort")
    alternate_effort = context.get("reasoning_effort")
    if primary_effort and alternate_effort and primary_effort != alternate_effort:
        raise RuntimeError(f"latest turn {latest_turn_id} has conflicting effort values")
    effort = primary_effort or alternate_effort
    if not isinstance(effort, str) or not effort.strip():
        raise RuntimeError(f"latest turn {latest_turn_id} has no reasoning effort")
    return {
        "thread_id": thread_id,
        "turn_id": latest_turn_id,
        "model": model,
        "reasoning_effort": effort,
        "source": "turn_context",
    }


def new_execution(
    thread: dict[str, object],
    session_name: str,
    rollout_path: Path,
    turn_id: str,
    started_at: float,
) -> dict[str, object]:
    return {
        "thread_id": str(thread["id"]),
        "turn_id": turn_id,
        "rollout_path": rollout_path,
        "started_at": started_at,
        "ended_at": None,
        "status": "active",
        "request": "",
        "session_name": session_name,
        "title": str(thread.get("title") or ""),
        "first_user_message": str(thread.get("first_user_message") or ""),
        "source": str(thread.get("source") or ""),
        "thread_source": str(thread.get("thread_source") or ""),
        "agent_path": str(thread.get("agent_path") or ""),
        "cwd": str(thread.get("cwd") or ""),
        "models": [],
        "reasoning_levels": [],
        "fallback_model": str(thread.get("model") or ""),
        "fallback_reasoning_level": str(thread.get("reasoning_effort") or ""),
        "lines_added": 0,
        "lines_removed": 0,
        "max_gap_seconds": None,
        "overlaps": False,
    }


def append_model(execution: dict[str, object], model: object) -> None:
    if not model:
        return
    models = execution["models"]
    assert isinstance(models, list)
    model_name = str(model)
    if not models or models[-1] != model_name:
        models.append(model_name)


def append_reasoning_level(execution: dict[str, object], level: object) -> None:
    if not level:
        return
    levels = execution["reasoning_levels"]
    assert isinstance(levels, list)
    level_name = str(level)
    if not levels or levels[-1] != level_name:
        levels.append(level_name)


def parse_executions(
    threads: list[dict[str, object]], session_names: dict[str, str]
) -> list[dict[str, object]]:
    executions = []
    for thread in threads:
        rollout_path = Path(str(thread["rollout_path"])).expanduser()
        if not rollout_path.is_absolute():
            rollout_path = Path.cwd() / rollout_path
        if not rollout_path.exists():
            continue

        thread_id = str(thread["id"])
        session_name = session_names.get(thread_id) or str(thread.get("name") or "")
        active: dict[str, dict[str, object]] = {}
        pending_models: dict[str, list[str]] = defaultdict(list)
        pending_reasoning_levels: dict[str, list[str]] = defaultdict(list)
        last_started_turn_id: str | None = None
        last_event_timestamp: float | None = None

        with rollout_path.open("rb") as handle:
            for line in handle:
                timestamp = timestamp_from_line(line)
                if timestamp is not None:
                    last_event_timestamp = timestamp

                relevant_event = (
                    b'"type":"event_msg"' in line
                    and (
                        b'"type":"task_' in line
                        or b'"type":"user_message"' in line
                    )
                )
                relevant_context = b'"type":"turn_context"' in line
                if not relevant_event and not relevant_context:
                    continue

                try:
                    item = json.loads(line)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue
                item_type = item.get("type")
                payload = item.get("payload") or {}

                if item_type == "turn_context":
                    turn_id = payload.get("turn_id")
                    model = payload.get("model")
                    reasoning_level = payload.get("effort") or payload.get(
                        "reasoning_effort"
                    )
                    if not turn_id:
                        continue
                    if turn_id in active:
                        append_model(active[turn_id], model)
                        append_reasoning_level(active[turn_id], reasoning_level)
                    else:
                        if model and (
                            not pending_models[turn_id]
                            or pending_models[turn_id][-1] != model
                        ):
                            pending_models[turn_id].append(str(model))
                        if reasoning_level and (
                            not pending_reasoning_levels[turn_id]
                            or pending_reasoning_levels[turn_id][-1] != reasoning_level
                        ):
                            pending_reasoning_levels[turn_id].append(
                                str(reasoning_level)
                            )
                    continue

                if item_type != "event_msg":
                    continue
                event_type = payload.get("type")
                if event_type == "task_started":
                    turn_id = payload.get("turn_id")
                    if not turn_id or timestamp is None:
                        continue
                    if turn_id not in active:
                        active[turn_id] = new_execution(
                            thread,
                            session_name,
                            rollout_path,
                            turn_id,
                            timestamp,
                        )
                        for model in pending_models.pop(turn_id, []):
                            append_model(active[turn_id], model)
                        for level in pending_reasoning_levels.pop(turn_id, []):
                            append_reasoning_level(active[turn_id], level)
                    last_started_turn_id = turn_id
                elif event_type == "user_message":
                    if last_started_turn_id not in active:
                        continue
                    execution = active[last_started_turn_id]
                    if not execution["request"]:
                        execution["request"] = str(payload.get("message") or "")
                elif event_type in FINISHED_EVENTS:
                    turn_id = payload.get("turn_id")
                    if turn_id not in active or timestamp is None:
                        continue
                    execution = active.pop(turn_id)
                    execution["ended_at"] = timestamp
                    execution["status"] = event_type.removeprefix("task_")
                    executions.append(execution)
                    if last_started_turn_id == turn_id:
                        last_started_turn_id = max(
                            active,
                            key=lambda key: float(active[key]["started_at"]),
                            default=None,
                        )

        for execution in active.values():
            execution["ended_at"] = last_event_timestamp or execution["started_at"]
            executions.append(execution)

    return executions


def is_subagent(execution: dict[str, object]) -> bool:
    if execution["agent_path"]:
        return True
    thread_source = str(execution["thread_source"]).casefold()
    source = str(execution["source"]).casefold()
    return thread_source == "subagent" or "subagent" in source


def local_date_boundary(value: str, timezone: ZoneInfo, end: bool) -> float:
    try:
        date = datetime.date.fromisoformat(value)
    except ValueError as error:
        raise RuntimeError(f"invalid date {value!r}; expected YYYY-MM-DD") from error
    if end:
        date += datetime.timedelta(days=1)
    return datetime.datetime.combine(date, datetime.time.min, timezone).timestamp()


def execution_description(execution: dict[str, object]) -> str:
    return " ".join(
        str(
            execution["request"]
            or execution["session_name"]
            or execution["title"]
            or execution["first_user_message"]
        ).split()
    )


def filter_executions(
    executions: list[dict[str, object]], arguments: argparse.Namespace, timezone: ZoneInfo
) -> list[dict[str, object]]:
    since = local_date_boundary(arguments.since, timezone, end=False) if arguments.since else None
    until = local_date_boundary(arguments.until, timezone, end=True) if arguments.until else None
    if since is not None and until is not None and since >= until:
        raise RuntimeError("--since must not be later than --until")

    project_filter = arguments.project.casefold() if arguments.project else None
    selected = []
    for execution in executions:
        status = execution["status"]
        if status != "complete" and not (arguments.include_active and status == "active"):
            continue
        if not arguments.all_agents:
            thread_source = str(execution["thread_source"]).casefold()
            if is_subagent(execution) or thread_source not in {"", "user"}:
                continue

        started_at = float(execution["started_at"])
        ended_at = float(execution["ended_at"] or started_at)
        if since is not None and started_at < since:
            continue
        if until is not None and started_at >= until:
            continue

        description = execution_description(execution)
        if project_filter:
            searchable = "\n".join(
                (str(execution["cwd"]), str(execution["session_name"]), description)
            ).casefold()
            if project_filter not in searchable:
                continue

        execution["description"] = description
        execution["duration_seconds"] = max(0.0, ended_at - started_at)
        selected.append(execution)

    selected.sort(key=lambda item: float(item["duration_seconds"]), reverse=True)
    return selected


def content_line_count(content: object) -> int:
    return len(content.splitlines()) if isinstance(content, str) else 0


def unified_diff_line_counts(unified_diff: object) -> tuple[int, int]:
    if not isinstance(unified_diff, str):
        return 0, 0

    added = 0
    removed = 0
    in_hunk = False
    for line in unified_diff.splitlines():
        if line.startswith("@@"):
            in_hunk = True
        elif in_hunk and line.startswith("+"):
            added += 1
        elif in_hunk and line.startswith("-"):
            removed += 1
    return added, removed


def patch_line_counts(changes: object) -> tuple[int, int]:
    if not isinstance(changes, dict):
        return 0, 0

    added = 0
    removed = 0
    for change in changes.values():
        if not isinstance(change, dict):
            continue
        change_type = change.get("type")
        if change_type == "add":
            added += content_line_count(change.get("content"))
        elif change_type == "delete":
            removed += content_line_count(change.get("content"))
        else:
            change_added, change_removed = unified_diff_line_counts(
                change.get("unified_diff")
            )
            added += change_added
            removed += change_removed
    return added, removed


def analyze_execution_events(
    executions: list[dict[str, object]], calculate_gaps: bool
) -> None:
    by_rollout_path: dict[Path, list[dict[str, object]]] = defaultdict(list)
    for execution in executions:
        by_rollout_path[execution["rollout_path"]].append(execution)

    for rollout_path, path_executions in by_rollout_path.items():
        executions_by_turn_id = {
            str(execution["turn_id"]): execution for execution in path_executions
        }
        previous_timestamps: dict[str, float] = {}
        with rollout_path.open("rb") as handle:
            for line in handle:
                timestamp = timestamp_from_line(line)
                if calculate_gaps and timestamp is not None:
                    for execution in path_executions:
                        started_at = float(execution["started_at"])
                        ended_at = float(execution["ended_at"] or started_at)
                        if not started_at <= timestamp <= ended_at:
                            continue
                        turn_id = str(execution["turn_id"])
                        previous = previous_timestamps.get(turn_id)
                        if previous is not None:
                            gap = timestamp - previous
                            current_gap = execution["max_gap_seconds"]
                            if current_gap is None or gap > float(current_gap):
                                execution["max_gap_seconds"] = gap
                        previous_timestamps[turn_id] = timestamp

                if b'"type":"patch_apply_end"' not in line:
                    continue
                try:
                    item = json.loads(line)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue
                if item.get("type") != "event_msg":
                    continue
                payload = item.get("payload") or {}
                if payload.get("type") != "patch_apply_end":
                    continue
                if (
                    payload.get("success") is not True
                    and payload.get("status") != "completed"
                ):
                    continue
                execution = executions_by_turn_id.get(str(payload.get("turn_id") or ""))
                if execution is None:
                    continue
                added, removed = patch_line_counts(payload.get("changes"))
                execution["lines_added"] = int(execution["lines_added"]) + added
                execution["lines_removed"] = int(execution["lines_removed"]) + removed


def mark_overlaps(
    executions: list[dict[str, object]], comparison_pool: list[dict[str, object]]
) -> None:
    for execution in executions:
        start = float(execution["started_at"])
        end = float(execution["ended_at"] or start)
        for other in comparison_pool:
            if execution is other:
                continue
            other_start = float(other["started_at"])
            other_end = float(other["ended_at"] or other_start)
            if max(start, other_start) < min(end, other_end):
                execution["overlaps"] = True
                break


def format_duration(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    total_seconds = int(round(seconds))
    hours, remainder = divmod(total_seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    if hours:
        return f"{hours}h {minutes:02d}min {seconds:02d}s"
    if minutes:
        return f"{minutes}min {seconds:02d}s"
    return f"{seconds}s"


def format_local_timestamp(timestamp: float, timezone: ZoneInfo) -> str:
    return datetime.datetime.fromtimestamp(timestamp, timezone).strftime("%Y-%m-%d %H:%M:%S")


def model_name(execution: dict[str, object]) -> str:
    models = execution["models"]
    assert isinstance(models, list)
    if models:
        return " → ".join(models)
    return str(execution["fallback_model"] or "desconhecido")


def reasoning_level(execution: dict[str, object]) -> str:
    levels = execution["reasoning_levels"]
    assert isinstance(levels, list)
    if levels:
        return " → ".join(levels)
    return str(execution["fallback_reasoning_level"] or "desconhecido")


def project_name(execution: dict[str, object]) -> str:
    cwd = str(execution["cwd"])
    return Path(cwd).name if cwd else "—"


def markdown_escape(value: object) -> str:
    return str(value).replace("\\", "\\\\").replace("|", "\\|").replace("\n", " ")


def public_record(
    rank: int, execution: dict[str, object], timezone: ZoneInfo
) -> dict[str, object]:
    started_at = float(execution["started_at"])
    ended_at = float(execution["ended_at"] or started_at)
    return {
        "rank": rank,
        "duration": format_duration(float(execution["duration_seconds"])),
        "duration_seconds": round(float(execution["duration_seconds"]), 3),
        "model": model_name(execution),
        "reasoning_level": reasoning_level(execution),
        "lines_added": execution["lines_added"],
        "lines_removed": execution["lines_removed"],
        "largest_gap": format_duration(execution["max_gap_seconds"]),
        "largest_gap_seconds": (
            round(float(execution["max_gap_seconds"]), 3)
            if execution["max_gap_seconds"] is not None
            else None
        ),
        "started_at": format_local_timestamp(started_at, timezone),
        "ended_at": format_local_timestamp(ended_at, timezone),
        "timezone": str(timezone),
        "overlaps": bool(execution["overlaps"]),
        "status": execution["status"],
        "project": project_name(execution),
        "cwd": execution["cwd"],
        "session": execution["session_name"],
        "request": execution["description"],
        "thread_id": execution["thread_id"],
        "turn_id": execution["turn_id"],
        "rollout_path": str(execution["rollout_path"]),
    }


def print_markdown(records: list[dict[str, object]], max_description: int) -> None:
    print(
        "| # | Duração | Modelo | Reasoning | Linhas (+/-) | Maior intervalo | Início | Fim | Sobreposição | Projeto | Pedido |"
    )
    print("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for record in records:
        description = str(record["request"])
        if len(description) > max_description:
            description = description[: max_description - 1].rstrip() + "…"
        values = (
            record["rank"],
            record["duration"],
            record["model"],
            record["reasoning_level"],
            f"+{record['lines_added']}/-{record['lines_removed']}",
            record["largest_gap"],
            record["started_at"],
            record["ended_at"],
            "sim" if record["overlaps"] else "não",
            record["project"],
            description,
        )
        print("| " + " | ".join(markdown_escape(value) for value in values) + " |")


def print_csv(records: list[dict[str, object]]) -> None:
    fieldnames = list(records[0]) if records else [
        "rank",
        "duration",
        "duration_seconds",
        "model",
        "reasoning_level",
        "lines_added",
        "lines_removed",
        "largest_gap",
        "largest_gap_seconds",
        "started_at",
        "ended_at",
        "timezone",
        "overlaps",
        "status",
        "project",
        "cwd",
        "session",
        "request",
        "thread_id",
        "turn_id",
        "rollout_path",
    ]
    writer = csv.DictWriter(sys.stdout, fieldnames=fieldnames)
    writer.writeheader()
    writer.writerows(records)


def require_runtime_string(value: object, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise RuntimeError(f"runtime has no {label}")
    return value.strip()


def validate_session_id(value: object) -> str:
    identity = require_runtime_string(value, "session identity")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", identity):
        raise RuntimeError("invalid session identity")
    return identity


def runtime_records(path: Path):
    with path.open("rb") as handle:
        for line_number, line in enumerate(handle, 1):
            try:
                item = json.loads(line)
            except (json.JSONDecodeError, UnicodeDecodeError) as error:
                raise RuntimeError(f"malformed runtime record at line {line_number}") from error
            if not isinstance(item, dict):
                raise RuntimeError(f"malformed runtime record at line {line_number}")
            require_runtime_string(item.get("type"), "record type")
            yield item


def client_settings(client: str, session_id: str, agent_id: str | None, turn_id: str,
                    model: object, effort: object, source: str, *, unsupported=False) -> dict:
    model = require_runtime_string(model, "effective model")
    if model.lower() in {"auto", "default", "<synthetic>"}:
        raise RuntimeError("runtime has no resolved effective model")
    return {
        "client": client,
        "session_id": session_id,
        "agent_id": agent_id,
        "turn_id": require_runtime_string(turn_id, "active turn identity"),
        "model": model,
        "reasoning_effort": None if unsupported else require_runtime_string(effort, "reasoning effort"),
        "reasoning_effort_status": "unsupported" if unsupported else "known",
        "source": source,
    }


def claude_current_settings(home: Path, session_id: str, agent_id: str | None) -> dict:
    session_id = validate_session_id(session_id)
    if agent_id:
        agent_id = validate_session_id(agent_id)
        paths = list((home / "projects").glob(
            f"*/{session_id}/subagents/agent-{agent_id}.jsonl"))
    else:
        paths = list((home / "projects").glob(f"*/{session_id}.jsonl"))
        session_path = home / "sessions" / f"{session_id}.jsonl"
        if session_path.is_file():
            paths.append(session_path)
    paths = sorted({path.resolve() for path in paths if path.is_file()})
    if len(paths) != 1:
        raise RuntimeError(f"expected one Claude transcript for {agent_id or session_id}; found {len(paths)}")

    latest = None
    pending_tools = set()
    completed_tools = set()
    latest_tool_completed = False
    turn_finished = False
    for item in runtime_records(paths[0]):
        kind = item.get("type")
        if kind not in {"user", "assistant"}:
            continue
        if item.get("sessionId") != session_id:
            raise RuntimeError("Claude transcript session identity mismatch")
        if item.get("agentId") != agent_id or bool(item.get("isSidechain")) != bool(agent_id):
            raise RuntimeError("Claude transcript agent identity mismatch; select its own --agent-id")
        message = item.get("message")
        if not isinstance(message, dict):
            raise RuntimeError("malformed Claude message")
        content = message.get("content")
        if kind == "user":
            if isinstance(content, str) or (isinstance(content, list) and any(
                not isinstance(block, dict) or block.get("type") != "tool_result" for block in content
            )):
                latest = None
                pending_tools.clear()
                latest_tool_completed = False
                turn_finished = False
            elif isinstance(content, list):
                for block in content:
                    tool_id = require_runtime_string(block.get("tool_use_id"), "Claude result tool identity")
                    if tool_id in pending_tools:
                        latest_tool_completed = True
                    completed_tools.add(tool_id)
                    pending_tools.discard(tool_id)
            else:
                raise RuntimeError("malformed Claude user content")
            continue

        message_id = require_runtime_string(message.get("id"), "Claude message identity")
        if latest is None or latest["message_id"] != message_id:
            latest = {"message_id": message_id, "turn_id": item.get("requestId") or message_id,
                      "model": message.get("model"), "effort": None, "perTurnEffort": None}
            pending_tools.clear()
            latest_tool_completed = False
        else:
            if message.get("model") != latest["model"]:
                raise RuntimeError("conflicting Claude model values in one message")
        for field in ("effort", "perTurnEffort"):
            if item.get(field) is not None:
                if latest[field] is not None and item[field] != latest[field]:
                    raise RuntimeError("conflicting Claude effort values in one message")
                latest[field] = item[field]
        latest["observed_at"] = item.get("timestamp")
        if not isinstance(content, list):
            raise RuntimeError("malformed Claude assistant content")
        for block in content:
            if not isinstance(block, dict):
                raise RuntimeError("malformed Claude content block")
            if block.get("type") == "tool_use":
                tool_id = require_runtime_string(block.get("id"), "Claude tool identity")
                if tool_id not in completed_tools:
                    pending_tools.add(tool_id)
        if message.get("stop_reason") not in (None, "tool_use"):
            turn_finished = True
            pending_tools.clear()

    if latest is None or turn_finished or not (pending_tools or latest_tool_completed):
        raise RuntimeError("Claude transcript has no active turn with tool metadata in its latest message")
    # Native effort records the outgoing request's output_config.effort.
    # perTurnEffort is separate, optional API-system metadata, not its replacement.
    effort = latest["effort"] if latest["effort"] is not None else latest["perTurnEffort"]
    environment_effort = os.environ.get("CLAUDE_EFFORT", "").strip()
    if effort and environment_effort and effort != environment_effort:
        raise RuntimeError("Claude transcript and tool environment have conflicting effort values")
    settings = client_settings("claude", session_id, agent_id, latest["turn_id"], latest["model"],
                               effort, "claude_transcript")
    if not pending_tools:
        # Desktop tools can be logged only after completion. Their message's
        # settings are the last observed values, not proof of a pending call.
        observed_at = require_runtime_string(latest["observed_at"], "Claude observation timestamp")
        try:
            observed = datetime.datetime.fromisoformat(observed_at.replace("Z", "+00:00"))
        except ValueError as error:
            raise RuntimeError("malformed Claude observation timestamp") from error
        if observed.tzinfo is None:
            raise RuntimeError("Claude observation timestamp has no timezone")
        settings.update(settings_status="last_logged", observed_at=observed_at)
    return settings


def claude_statusline_settings(arguments: argparse.Namespace) -> dict:
    snapshot = json.load(sys.stdin)
    if not isinstance(snapshot, dict):
        raise RuntimeError("malformed Claude status-line input")
    session_id = validate_session_id(snapshot.get("session_id"))
    environment_id = os.environ.get("CLAUDE_CODE_SESSION_ID", "").strip()
    if arguments.session_id and environment_id and arguments.session_id != environment_id:
        raise RuntimeError("--session-id does not match acting CLAUDE_CODE_SESSION_ID")
    expected_id = require_runtime_string(environment_id or arguments.session_id, "Claude status-line caller identity")
    if expected_id != session_id:
        raise RuntimeError("Claude status-line session identity mismatch")
    if arguments.agent_id:
        raise RuntimeError("root Claude status-line input cannot identify a subagent")
    turn_id = require_runtime_string(snapshot.get("prompt_id"), "Claude prompt identity")
    model = snapshot.get("model")
    if not isinstance(model, dict):
        raise RuntimeError("malformed Claude status-line model")
    # In the documented status-line schema, effort is absent for unsupported models.
    effort = snapshot.get("effort")
    if "effort" in snapshot and not isinstance(effort, dict):
        raise RuntimeError("malformed Claude status-line effort")
    return client_settings("claude", session_id, None, turn_id, model.get("id"),
                           effort.get("level") if effort is not None else None,
                           "claude_statusline", unsupported="effort" not in snapshot)


def copilot_effort_settings(data: dict) -> dict:
    owner = data.get("reasoningEffortModel")
    if "reasoningEffortModel" in data:
        owner = require_runtime_string(owner, "Copilot reasoning effort model identity")
    managed = data.get("reasoningEffortManaged", False)
    if not isinstance(managed, bool):
        raise RuntimeError("malformed Copilot reasoning effort ownership")
    if managed and owner is None:
        raise RuntimeError("Copilot managed reasoning effort has no model identity")
    return {"level": data.get("reasoningEffort"), "model": owner}


def copilot_current_settings(home: Path, session_id: str, agent_id: str | None) -> dict:
    session_id = validate_session_id(session_id)
    if agent_id:
        agent_id = validate_session_id(agent_id)
    path = home / "session-state" / session_id / "events.jsonl"
    identities = 0
    seen_ids = set()
    effort = {"level": None, "model": None}
    configured_model = None
    latest = None
    active = False
    for event in runtime_records(path):
        event_id = require_runtime_string(event.get("id"), "Copilot event identity")
        if event_id in seen_ids:
            raise RuntimeError("duplicate Copilot event identity")
        seen_ids.add(event_id)
        kind = event.get("type")
        data = event.get("data")
        if not isinstance(data, dict):
            raise RuntimeError("malformed Copilot event data")
        if kind == "session.start":
            identities += 1
            if data.get("sessionId") != session_id:
                raise RuntimeError("Copilot event session identity mismatch")
        if kind in {"session.shutdown", "abort"} and (
            event.get("agentId") is None or event.get("agentId") == agent_id
        ):
            active = False
        if kind == "session.resume" and (
            event.get("agentId") is None or event.get("agentId") == agent_id
        ) and data.get("continuePendingWork") is not True and data.get("sessionWasActive") is not True:
            active = False
            if agent_id:
                configured_model = None
                effort = {"level": None, "model": None}
        if event.get("agentId") != agent_id:
            continue
        if kind in {"session.start", "session.resume", "session.model_change"}:
            # An omitted/cleared effort does not prove a default or lack of support.
            effort = copilot_effort_settings(data)
            configured_model = None
        elif kind == "subagent.configured" and agent_id:
            configured_model = require_runtime_string(data.get("model"), "Copilot configured subagent model")
            effort = {"level": data.get("reasoningEffort"), "model": configured_model}
        elif kind in {"subagent.completed", "subagent.failed"} and agent_id:
            active = False
        # Model deselection preserves effort and its ownership in the native contract.
        elif kind == "user.message":
            active = False
        elif kind in {"assistant.turn_start", "assistant.turn_retry"}:
            if kind == "assistant.turn_retry" and (
                latest is None or not active or data.get("turnId") != latest["turn_id"]
            ):
                raise RuntimeError("Copilot turn retry has no matching active start")
            model = data.get("model")
            if model is None and kind == "assistant.turn_start":
                model = configured_model
            latest = {"turn_id": require_runtime_string(data.get("turnId"), "Copilot turn identity"),
                      "model": model, "effort": effort,
                      "retry": kind == "assistant.turn_retry"}
            active = True
        elif kind == "assistant.message" and active and latest is not None and (
            data.get("turnId") == latest["turn_id"] and not latest["retry"]
        ) and data.get("model") is not None:
            # Messages identify a turn, but cannot distinguish a retry attempt
            # from a delayed fragment of the preceding attempt in that turn.
            model = require_runtime_string(data["model"], "Copilot message model")
            if latest["model"] is None or (
                isinstance(latest["model"], str) and
                latest["model"].strip().lower() in {"auto", "default", "<synthetic>"}
            ):
                latest["model"] = model
            elif model != latest["model"]:
                raise RuntimeError("conflicting Copilot model values in one turn")
        elif kind == "assistant.turn_end":
            if latest is None or data.get("turnId") != latest["turn_id"]:
                raise RuntimeError("Copilot turn end has no matching start")
            active = False
    if identities != 1:
        raise RuntimeError("Copilot event log must contain one session identity")
    if latest is None or not active:
        raise RuntimeError("Copilot event log has no active latest turn")
    if latest["effort"]["model"] is not None and latest["effort"]["model"] != latest["model"]:
        raise RuntimeError("Copilot reasoning effort belongs to another model")
    return client_settings("copilot", session_id, agent_id, latest["turn_id"],
                           latest["model"], latest["effort"]["level"], "copilot_events")


def parse_current_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="codex-session-stats current",
        description="Show the acting client's effective model and reasoning effort.",
    )
    parser.add_argument("--format", choices=("text", "json"), default="text")
    parser.add_argument("--client", choices=("auto", "codex", "claude", "copilot"), default="auto",
                        help="use an explicit client when another client launched this session")
    parser.add_argument("--session-id", help="Copilot ID supplied by its session-context hook; "
                        "for Codex/Claude it must match the client's environment")
    parser.add_argument("--agent-id", help="native Claude/Copilot subagent identity; never use its parent")
    parser.add_argument("--claude-statusline", action="store_true",
                        help="read documented Claude status-line JSON from stdin instead of its transcript")
    parser.add_argument("--claude-home", type=Path,
                        default=Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")))
    parser.add_argument("--copilot-home", type=Path,
                        default=Path(os.environ.get("COPILOT_HOME", "~/.copilot")))
    parser.add_argument(
        "--codex-home",
        type=Path,
        default=Path(os.environ.get("CODEX_HOME", "~/.codex")),
    )
    return parser.parse_args(sys.argv[2:])


def current_main() -> int:
    arguments = parse_current_arguments()
    try:
        client = arguments.client
        if arguments.claude_statusline and client != "claude":
            raise RuntimeError("--claude-statusline requires explicit --client claude")
        if client == "auto":
            if arguments.session_id:
                raise RuntimeError("--session-id requires an explicit --client")
            candidates = [name for name, key in (("codex", "CODEX_THREAD_ID"),
                          ("claude", "CLAUDE_CODE_SESSION_ID")) if os.environ.get(key, "").strip()]
            if len(candidates) > 1:
                raise RuntimeError("ambiguous inherited client identities; select --client explicitly")
            if not candidates:
                raise RuntimeError("CODEX_THREAD_ID and CLAUDE_CODE_SESSION_ID are unavailable; "
                                   "Copilot requires --client copilot --session-id from its runtime")
            client = candidates[0]
        if arguments.claude_statusline:
            settings = claude_statusline_settings(arguments)
        elif client in {"codex", "claude"}:
            key = "CODEX_THREAD_ID" if client == "codex" else "CLAUDE_CODE_SESSION_ID"
            session_id = require_runtime_string(os.environ.get(key), key)
            if arguments.session_id and arguments.session_id != session_id:
                raise RuntimeError(f"--session-id does not match acting {key}")
            if client == "codex":
                if arguments.agent_id:
                    raise RuntimeError("Codex subagents use their own CODEX_THREAD_ID, not --agent-id")
                native = codex_current_settings(arguments.codex_home.expanduser().resolve(), session_id)
                settings = client_settings("codex", session_id, None, native["turn_id"],
                                           native["model"], native["reasoning_effort"], native["source"])
                settings["thread_id"] = session_id
                if native["source"] == "runtime_log":
                    settings["settings_status"] = native["settings_status"]
                    settings["observed_at"] = native["observed_at"]
            else:
                settings = claude_current_settings(arguments.claude_home.expanduser().resolve(),
                                                   session_id, arguments.agent_id)
        else:
            session_id = require_runtime_string(arguments.session_id, "Copilot --session-id")
            settings = copilot_current_settings(arguments.copilot_home.expanduser().resolve(),
                                                session_id, arguments.agent_id)
    except (OSError, RuntimeError, sqlite3.Error, json.JSONDecodeError, UnicodeDecodeError) as error:
        print(f"codex-session-stats current: {error}", file=sys.stderr)
        return 1

    if arguments.format == "json":
        json.dump(settings, sys.stdout, ensure_ascii=False)
        print()
    else:
        print(f"Model: {settings['model']}")
        effort = settings['reasoning_effort'] if settings['reasoning_effort_status'] == 'known' else 'unsupported'
        print(f"Reasoning effort: {effort}")
        print(f"Client: {settings['client']}")
        print(f"Session: {settings['session_id']}")
        if settings['agent_id']:
            print(f"Agent: {settings['agent_id']}")
        print(f"Turn: {settings['turn_id']}")
        print(f"Source: {settings['source']}")
        if settings.get("settings_status") == "last_logged":
            print(f"Settings status: {settings['settings_status']}")
            print(f"Observed at: {settings['observed_at']}")
    return 0


def session_context_main() -> int:
    parser = argparse.ArgumentParser(prog="codex-session-stats session-context",
                                     description="Emit current-session identity from a Copilot SessionStart hook.")
    parser.add_argument("--client", choices=("copilot",), required=True)
    parser.parse_args(sys.argv[2:])
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise RuntimeError("malformed session-start input")
        camel_id = payload.get("sessionId")
        snake_id = payload.get("session_id")
        if camel_id and snake_id and camel_id != snake_id:
            raise RuntimeError("conflicting session identities")
        session_id = validate_session_id(camel_id or snake_id)
        if payload.get("hook_event_name", "SessionStart") != "SessionStart":
            raise RuntimeError("session-context requires SessionStart input")
    except (ValueError, RuntimeError, UnicodeDecodeError) as error:
        print(f"codex-session-stats session-context: {error}", file=sys.stderr)
        return 1
    context = (
        f"Copilot CLI root session ID: {session_id}. For this root agent, read effective settings with "
        f"codex-session-stats current --client copilot --session-id {session_id} --format json. "
        "A subagent must add its own runtime --agent-id or use its accepted launcher assignment; "
        "this root session context does not establish a subagent's model or effort."
    )
    print(json.dumps({"additionalContext": context}))
    return 0


def parse_search_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="codex-session-stats find",
        description="Search local Codex and Claude messages without changing client data.",
        epilog="Prefer a complete MR URL to distinguish projects. A match is evidence of a mention, "
        "not proof that a review was performed. Search is literal and case-insensitive.",
    )
    parser.add_argument("query", nargs="?", help="literal text or complete MR URL")
    parser.add_argument("--mr", type=positive_integer, help="MR number in a URL, MR 34, or !34 notation")
    parser.add_argument("--agent", choices=("both", "codex", "claude"), default="both")
    parser.add_argument("--project", help="literal filter on cwd, current title, or matching message")
    parser.add_argument("--session", help="exact session ID")
    parser.add_argument("--role", choices=("both", "user", "assistant"), default="both")
    parser.add_argument("--since", metavar="YYYY-MM-DD", help="earliest local message date")
    parser.add_argument("--until", metavar="YYYY-MM-DD", help="latest local message date (inclusive)")
    parser.add_argument("--timezone", default="America/Sao_Paulo")
    parser.add_argument("--limit", type=positive_integer, default=20, help="maximum conversations")
    parser.add_argument("--matches-per-session", type=positive_integer, default=3)
    parser.add_argument("--max-description", type=positive_integer, default=280, help="excerpt length")
    parser.add_argument("--format", choices=("markdown", "json", "csv"), default="markdown")
    parser.add_argument("--all-agents", action="store_true", help="include subagents and automatic reviewers")
    parser.add_argument("--include-inherited", action="store_true", help="include labelled compacted history; original dates may be unknown")
    parser.add_argument("--codex-home", type=Path, default=Path(os.environ.get("CODEX_HOME", "~/.codex")))
    parser.add_argument("--claude-home", type=Path, default=Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")))
    args = parser.parse_args(sys.argv[2:])
    if not (args.query and args.query.strip()) and args.mr is None:
        parser.error("provide literal query text or --mr")
    return args


def search_patterns(arguments: argparse.Namespace) -> tuple[list[re.Pattern], list[re.Pattern]]:
    patterns = []
    byte_patterns = []
    if arguments.query:
        pattern = re.escape(arguments.query)
        if re.search(r"/merge_requests/\d+$", arguments.query):
            pattern += r"(?!\d)"
        patterns.append(pattern)
        if arguments.query.isascii() and not any(c in arguments.query for c in '\\"\n\r\t'):
            byte_patterns.append(re.compile(pattern.encode(), re.IGNORECASE))
    if arguments.mr is not None:
        patterns.append(r"(?:/merge_requests/|\bMR\s*!?\s*|\bmerge\s+request\s*!?\s*|!)"
                        + str(arguments.mr) + r"(?!\d)")
        # Notation whitespace may be JSON-escaped; only the number is a safe prefilter.
        byte_patterns.append(re.compile(str(arguments.mr).encode() + rb"(?!\d)"))
    text_patterns = [re.compile(p, re.IGNORECASE) for p in patterns]
    # Unicode queries and escaped Unicode JSON need decoding; ASCII queries can reject most
    # lines before JSON parsing. Tools, world-state snapshots and reasoning stay unsearchable.
    return text_patterns, byte_patterns


def conversation_text(content: object) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    return "\n".join(
        part["text"] for part in content
        if isinstance(part, dict) and part.get("type") in {"text", "Text", "input_text", "output_text"}
        and isinstance(part.get("text"), str)
    )


def conversation_messages(item: dict, agent: str, inherited: bool = False):
    """Yield role, text, timestamp, origin, preference; never flatten tool/thinking payloads."""
    kind = item.get("type")
    timestamp = item.get("timestamp")
    if agent == "claude":
        message = item.get("message")
        if kind in {"user", "assistant"} and isinstance(message, dict):
            if item.get("isCompactSummary"):
                if inherited:
                    yield kind, conversation_text(message.get("content")), None, "inherited", 0
            else:
                yield kind, conversation_text(message.get("content")), timestamp, "message", 2
        return
    payload = item.get("payload")
    if not isinstance(payload, dict):
        return
    if kind == "response_item":
        if payload.get("type") == "message" and payload.get("channel") not in {"analysis", "summary"}:
            role = payload.get("role")
            if role in {"user", "assistant"}:
                yield role, conversation_text(payload.get("content")), timestamp, "message", 2
    elif kind == "event_msg":
        event_type = payload.get("type")
        if event_type in {"user_message", "agent_message"}:
            role = "user" if event_type == "user_message" else "assistant"
            yield role, conversation_text(payload.get("message")), timestamp, "message", 1
        elif event_type == "item_completed":
            message = payload.get("item") or {}
            if isinstance(message, dict) and message.get("type") in {"AgentMessage", "UserMessage"}:
                role = "assistant" if message["type"] == "AgentMessage" else "user"
                yield role, conversation_text(message.get("content")), timestamp, "message", 1
    elif kind == "compacted" and inherited:
        history = payload.get("replacement_history")
        for message in history if isinstance(history, list) else []:
            if not isinstance(message, dict):
                continue
            for role, text, _, _, _ in conversation_messages(
                {"type": "response_item", "payload": message}, "codex"
            ):
                yield role, text, message.get("timestamp"), "inherited", 0


def search_json(line: bytes, coverage: dict) -> dict:
    try:
        value = json.loads(line)
        if isinstance(value, dict):
            return value
    except (ValueError, UnicodeDecodeError):
        pass
    coverage["malformed_records"] += 1
    return {}


def search_titles(codex_home: Path, coverage: dict) -> dict:
    titles = {}
    path = codex_home / "session_index.jsonl"
    if not path.exists():
        return titles
    try:
        with path.open("rb") as handle:
            for number, line in enumerate(handle, 1):
                item = search_json(line, coverage)
                if item.get("id") and item.get("thread_name"):
                    titles[item["id"]] = {
                        "title": item["thread_name"], "path": str(path), "line": number,
                        "timestamp": item.get("updated_at"), "rank": 3,
                    }
    except OSError as error:
        coverage["errors"].append(f"{path}: {error}")
    return titles


def history_files(root: Path, coverage: dict):
    if not root.exists():
        coverage["missing_roots"].append(str(root))
        return

    def on_error(error):
        coverage["errors"].append(str(error))

    for directory, directories, filenames in os.walk(root, onerror=on_error):
        directories.sort()
        for name in sorted(filenames):
            if name.endswith(".jsonl"):
                yield Path(directory) / name


def safe_message_timestamp(value: object) -> float | None:
    if not isinstance(value, str):
        return None
    try:
        return parse_timestamp(value)
    except (ValueError, OverflowError):
        return None


def search_excerpt(text: str, patterns: list[re.Pattern], maximum: int) -> str:
    text = " ".join(text.split())
    if len(text) <= maximum:
        return text
    found = next((p.search(text) for p in patterns if p.search(text)), None)
    start = max(0, found.start() - maximum // 3) if found else 0
    return ("…" if start else "") + text[start:start + maximum] + ("…" if start + maximum < len(text) else "")


def remember_search_match(matches: dict, fingerprint: str, match: dict) -> None:
    # Mirror events differ slightly in timestamp. Repeated messages on another date are
    # separate evidence and must survive date filtering; copied rollouts remain one hit.
    occurrences = matches.setdefault(fingerprint, [])
    for index, previous in enumerate(occurrences):
        left, right = previous["epoch"], match["epoch"]
        same_time = left == right or (left is not None and right is not None and abs(left - right) <= 2)
        if same_time:
            if match["preference"] > previous["preference"]:
                occurrences[index] = match
            return
    occurrences.append(match)


def scan_history_file(path: Path, agent: str, args: argparse.Namespace, patterns: list,
                      byte_patterns: list, titles: dict, coverage: dict, sessions: dict) -> None:
    metadata = {"session_id": path.stem, "cwd": "", "title": "", "rank": 0}
    matches = {}
    # Top-level types occur before large content fields in both clients' JSONL envelopes.
    type_pattern = re.compile(rb'"type"\s*:\s*"([^"]+)"')
    title_kinds = {"custom-title", "ai-title", "summary"}
    try:
        modified = path.stat().st_mtime_ns
        with path.open("rb") as handle:
            for number, raw in enumerate(handle, 1):
                header = type_pattern.search(raw, 0, 1024)
                kind = header.group(1).decode("ascii", errors="replace") if header else ""
                if kind not in {"session_meta", "response_item", "event_msg", "compacted", "user", "assistant"} | title_kinds:
                    continue
                if kind == "compacted" and not args.include_inherited:
                    continue
                if kind == "response_item":
                    payload_type = type_pattern.search(raw, header.end(), 1024)
                    if payload_type and payload_type.group(1) != b"message":
                        continue
                metadata_line = kind == "session_meta" or kind in title_kinds
                needs_claude_identity = agent == "claude" and not metadata["cwd"] and kind in {"user", "assistant"}
                candidate = (b"\\u" in raw or b"\\/" in raw or all(p.search(raw) for p in byte_patterns))
                if not metadata_line and not needs_claude_identity and not candidate:
                    continue
                item = search_json(raw, coverage)
                if not item:
                    continue
                if agent == "codex" and kind == "session_meta":
                    meta = item.get("payload") or {}
                    if not isinstance(meta, dict):
                        continue
                    if not args.all_agents and ("subagent" in str(meta.get("source", "")).lower()
                                               or meta.get("agent_path")
                                               or meta.get("thread_source") not in {None, "", "user"}):
                        coverage["subagent_files_skipped"] += 1
                        return
                    metadata["session_id"] = meta.get("id") or meta.get("session_id") or path.stem
                    metadata["cwd"] = meta.get("cwd") or ""
                    if args.session and args.session != metadata["session_id"]:
                        coverage["session_files_skipped"] += 1
                        return
                    continue
                if agent == "claude":
                    if not args.all_agents and item.get("isSidechain"):
                        continue
                    metadata["session_id"] = item.get("sessionId") or metadata["session_id"]
                    metadata["cwd"] = item.get("cwd") or metadata["cwd"]
                    if args.session and args.session != metadata["session_id"]:
                        coverage["session_files_skipped"] += 1
                        return
                    title = item.get("customTitle") or item.get("aiTitle") or item.get("summary")
                    rank = 2 if kind == "custom-title" else 1
                    if kind in title_kinds and isinstance(title, str) and rank >= metadata["rank"]:
                        metadata.update(title=title, rank=rank, path=str(path), line=number,
                                        timestamp=item.get("timestamp"))
                for role, text, timestamp, origin, preference in conversation_messages(item, agent, args.include_inherited):
                    if not text:
                        continue
                    if not metadata["title"] and role == "user":
                        metadata["title"] = " ".join(text.split())[:160]
                    if args.role not in {"both", role} or not all(p.search(text) for p in patterns):
                        continue
                    match = {
                        "role": role, "origin": origin, "epoch": safe_message_timestamp(timestamp),
                        "path": str(path), "line": number,
                        "excerpt": search_excerpt(text, patterns, args.max_description),
                        "project_match": bool(args.project and args.project.casefold() in text.casefold()),
                        "preference": preference,
                    }
                    key = hashlib.sha256((role + "\0" + origin + "\0" + text).encode()).hexdigest()
                    remember_search_match(matches, key, match)
        coverage["files_scanned"] += 1
    except OSError as error:
        coverage["errors"].append(f"{path}: {error}")
        return
    if agent == "codex" and metadata["session_id"] in titles:
        metadata.update(titles[metadata["session_id"]])
    key = (agent, metadata["session_id"])
    session = sessions.setdefault(key, {"agent": agent, "matches": {}, "metadata_order": (-1, -1)})
    order = (metadata["rank"], modified)
    if order > session["metadata_order"]:
        session.update(metadata)
        session["metadata_order"] = order
    for key, occurrences in matches.items():
        for match in occurrences:
            remember_search_match(session["matches"], key, match)


def find_conversations(args: argparse.Namespace) -> dict:
    timezone = ZoneInfo(args.timezone)
    since = local_date_boundary(args.since, timezone, False) if args.since else None
    until = local_date_boundary(args.until, timezone, True) if args.until else None
    if since is not None and until is not None and since >= until:
        raise RuntimeError("--since must not be later than --until")
    patterns, byte_patterns = search_patterns(args)
    coverage = {"files_discovered": 0, "files_scanned": 0, "subagent_files_skipped": 0,
                "session_files_skipped": 0, "malformed_records": 0, "missing_roots": [], "errors": []}
    sessions = {}
    codex_home = args.codex_home.expanduser().resolve()
    claude_home = args.claude_home.expanduser().resolve()
    titles = search_titles(codex_home, coverage) if args.agent in {"both", "codex"} else {}
    roots = []
    if args.agent in {"both", "codex"}:
        roots.append(("codex", codex_home / "sessions"))
        if (codex_home / "archived_sessions").exists():
            roots.append(("codex", codex_home / "archived_sessions"))
    if args.agent in {"both", "claude"}:
        roots.extend(("claude", claude_home / name) for name in ("projects", "sessions"))
    for agent, root in roots:
        for path in history_files(root, coverage):
            coverage["files_discovered"] += 1
            if agent == "claude" and not args.all_agents and "subagents" in path.relative_to(root).parts:
                coverage["subagent_files_skipped"] += 1
                continue
            scan_history_file(path, agent, args, patterns, byte_patterns, titles, coverage, sessions)
    results = []
    for session in sessions.values():
        if args.session and session["session_id"] != args.session:
            continue
        matches = [match for occurrences in session["matches"].values() for match in occurrences]
        if args.role == "both" and session.get("rank", 0) > 0 and all(p.search(session["title"]) for p in patterns):
            matches.append({"role": "metadata", "origin": "title", "epoch": safe_message_timestamp(session.get("timestamp")),
                            "path": session["path"], "line": session["line"],
                            "excerpt": search_excerpt(session["title"], patterns, args.max_description), "project_match": False})
        project_match = not args.project or args.project.casefold() in (
            session.get("cwd", "") + "\n" + session.get("title", "")).casefold()
        matches = [m for m in matches if (project_match or m["project_match"])
                   and (since is None or m["epoch"] is not None and m["epoch"] >= since)
                   and (until is None or m["epoch"] is not None and m["epoch"] < until)]
        if not matches:
            continue
        matches.sort(key=lambda m: m["epoch"] if m["epoch"] is not None else float("-inf"), reverse=True)
        public_matches = []
        for match in matches[:args.matches_per_session]:
            public_matches.append({
                "timestamp": format_local_timestamp(match["epoch"], timezone) if match["epoch"] is not None else None,
                **{field: match[field] for field in ("role", "origin", "path", "line", "excerpt")},
            })
        results.append({"agent": session["agent"], "session_id": session["session_id"],
                        "title": session.get("title") or session["session_id"], "cwd": session.get("cwd", ""),
                        "match_count": len(matches), "matches": public_matches,
                        "latest": matches[0]["epoch"] or float("-inf")})
    results.sort(key=lambda r: (-r["latest"], r["agent"], r["session_id"]))
    total = len(results)
    results = results[:args.limit]
    for result in results:
        result.pop("latest")
    return {"conversations": results, "total_conversations": total, "timezone": str(timezone), "coverage": coverage}


def search_main() -> int:
    args = parse_search_arguments()
    try:
        result = find_conversations(args)
    except (OSError, RuntimeError, sqlite3.Error, ZoneInfoNotFoundError) as error:
        print(f"codex-session-stats find: {error}", file=sys.stderr)
        return 1
    coverage = result["coverage"]
    summary = (f"Scanned {coverage['files_scanned']} of {coverage['files_discovered']} history files; "
               f"skipped {coverage['subagent_files_skipped']} subagent files; "
               f"{coverage['session_files_skipped']} files outside --session; "
               f"{coverage['malformed_records']} malformed candidate/metadata records.")
    print(summary, file=sys.stderr)
    for root in coverage["missing_roots"]:
        print(f"History root absent: {root}", file=sys.stderr)
    for error in coverage["errors"]:
        print(f"Incomplete search: {error}", file=sys.stderr)
    if args.format == "json":
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.format == "csv":
        fields = ["agent", "session_id", "title", "cwd", "match_count", "timestamp", "role", "origin", "path", "line", "excerpt"]
        writer = csv.DictWriter(sys.stdout, fieldnames=fields)
        writer.writeheader()
        for conversation in result["conversations"]:
            for match in conversation["matches"]:
                writer.writerow({**{key: conversation[key] for key in fields[:5]}, **match})
    else:
        print(f"Found {result['total_conversations']} conversations; showing {len(result['conversations'])}. Times: {result['timezone']}.")
        for conversation in result["conversations"]:
            print(f"\n**{markdown_escape(conversation['title'])}** — {conversation['agent']}")
            print(f"\nSession: `{conversation['session_id']}` · Directory: `{conversation['cwd']}` · Matches: {conversation['match_count']}")
            print()
            for match in conversation["matches"]:
                location = f"{match['path']}:{match['line']}"
                print(f"- {match['timestamp'] or 'date unknown'} · {match['role']} · {match['origin']} · "
                      f"[source](<{location}>) — {markdown_escape(match['excerpt'])}")
    return 0


MONITOR_PERMISSION_PROFILE = "codex-session-stats-gitlab-monitor"
MONITOR_RELAY_LIMIT = 64 * 1024 * 1024


def monitor_process(pid: int) -> dict:
    root = Path(f"/proc/{pid}")
    fields = (root / "stat").read_text().rsplit(")", 1)[1].split()
    if fields[0] in {"Z", "X"} or root.stat().st_uid != os.getuid():
        raise RuntimeError("shared application process is no longer live or owned")
    return {"pid": pid, "birth": fields[19], "parent": int(fields[1]),
            "exe": str((root / "exe").resolve(strict=True))}


def monitor_private(path: Path, *, directory=False):
    import stat
    metadata = path.lstat()
    valid = stat.S_ISDIR(metadata.st_mode) if directory else stat.S_ISREG(metadata.st_mode)
    if not valid or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
        raise RuntimeError("shared application runtime must be private, owned and without symlinks")
    return metadata


def monitor_shared_runtime(config: dict, *, create=False) -> Path:
    base = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")).resolve()
    monitor_private(base, directory=True)
    root = base / "codex-session-stats"
    target = root / ("shared-" + hashlib.sha256(config["codex_home"].encode()).hexdigest()[:20])
    if target.is_relative_to(Path(config["state_file"]).parent.resolve()):
        raise RuntimeError("shared runtime must be outside the monitor's writable state directory")
    for directory in (root, target):
        if create:
            directory.mkdir(mode=0o700, exist_ok=True)
        monitor_private(directory, directory=True)
    return target


def monitor_runtime_write(path: Path, value: dict):
    temporary = path.with_name(path.name + "." + monitor_id())
    try:
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as stream:
            json.dump(value, stream)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def monitor_shared_owner(config: dict) -> dict:
    """Read-only proof of the GUI relay's live lease, never a stale receipt alone."""
    try:
        runtime = monitor_shared_runtime(config)
        receipt_path = runtime / "ready.json"
        monitor_private(receipt_path)
        receipt = json.loads(receipt_path.read_text())
        if receipt["codex_home"] != config["codex_home"] or receipt["socket"] != config["socket"]:
            raise RuntimeError("shared server endpoint or Codex home differs from the monitor")
        for role in ("gui", "proxy", "native"):
            if monitor_process(receipt[role]["pid"]) != receipt[role]:
                raise RuntimeError("shared server process identity changed")
        if (receipt["proxy"]["parent"] != receipt["gui"]["pid"]
                or receipt["native"]["parent"] != receipt["proxy"]["pid"]):
            raise RuntimeError("shared server does not belong to the recorded GUI relay")
        lease = monitor_private(runtime / "lease")
        identity = f"{os.major(lease.st_dev):02x}:{os.minor(lease.st_dev):02x}:{lease.st_ino}"
        locked = any(len(parts := line.split()) >= 6 and parts[1:4] == ["FLOCK", "ADVISORY", "WRITE"]
                     and parts[4] == str(receipt["proxy"]["pid"]) and parts[5] == identity
                     for line in Path("/proc/locks").read_text().splitlines())
        metadata = Path(config["socket"]).stat()
        import stat
        if (not locked or [lease.st_dev, lease.st_ino] != receipt["lease"]
                or not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.getuid()
                or [metadata.st_dev, metadata.st_ino] != receipt["socket_identity"]):
            raise RuntimeError("shared server lease or socket identity is no longer valid")
        return receipt
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        raise RuntimeError("shared Codex application is unavailable or unverified; close the app and use "
                           "monitor-gitlab launch-app --app PATH --codex PATH") from error


def monitor_shared_peer(config: dict, connection):
    import socket
    import struct
    receipt = monitor_shared_owner(config)
    peer = connection.transport.get_extra_info("socket")
    if peer is None:
        raise RuntimeError("shared native connection did not expose its Unix peer")
    pid, uid, _ = struct.unpack("3i", peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    if pid != receipt["native"]["pid"] or uid != os.getuid():
        raise RuntimeError("connected native peer is not the GUI's shared server")


def monitor_launch_app(config: dict, path: Path, app: Path, codex: Path, app_args: list):
    import fcntl
    if not Path(config["codex_home"]).is_dir():
        raise RuntimeError("selected Codex home must already exist; sign in through the ordinary app first")
    app, codex = app.expanduser().resolve(strict=True), codex.expanduser().resolve(strict=True)
    for executable in (app, codex):
        if not executable.is_file() or not os.access(executable, os.X_OK):
            raise RuntimeError("application and Codex paths must be executable files")
    # Inspect exact executable identities, never kill a running application or native daemon.
    for entry in Path("/proc").iterdir():
        if entry.name.isdigit() and int(entry.name) != os.getpid():
            try:
                process = monitor_process(int(entry.name))
            except (FileNotFoundError, ProcessLookupError, PermissionError, RuntimeError):
                continue
            if process["exe"] == str(app):
                raise RuntimeError("the selected application is already running; close it before launch-app")
    alias = Path(config["_socket_alias"])
    if alias.exists() or Path(config["socket"]).exists():
        raise RuntimeError("native endpoint already exists; stop its owning application/daemon before launch-app")
    runtime = monitor_shared_runtime(config, create=True)
    # Serialize launch preparation, and retain an exact GUI PID/birth reservation across exec.
    descriptor = os.open(runtime / "launch.lock", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        monitor_private(runtime / "launch.lock")
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        launch_path = runtime / "launch.json"
        if launch_path.exists():
            monitor_private(launch_path)
            old = json.loads(launch_path.read_text())
            try:
                current = monitor_process(old["gui"]["pid"])
            except (FileNotFoundError, ProcessLookupError, RuntimeError):
                current = None
            if current and current["birth"] == old["gui"]["birth"]:
                raise RuntimeError("a shared application launch is already reserved by a live process")
        wrapper = runtime / "codex-proxy"
        content = (f"#!{sys.executable}\nimport runpy\n"
                   f"raise SystemExit(runpy.run_path({str(Path(__file__).resolve())!r})['monitor_app_proxy_main']())\n")
        temporary = runtime / ("wrapper-" + monitor_id())
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o700), "w") as stream:
            stream.write(content)
        os.replace(temporary, wrapper)
        launch = {"gui": monitor_process(os.getpid()), "app": str(app), "codex": str(codex),
                  "config": str(path), "codex_home": config["codex_home"], "wrapper": str(wrapper)}
        monitor_runtime_write(launch_path, launch)
        environment = {key: value for key, value in os.environ.items() if key in {
            "PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "DISPLAY", "WAYLAND_DISPLAY",
            "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME",
            "XDG_CACHE_HOME", "XDG_STATE_HOME", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "XDG_SESSION_ID",
            "XDG_SESSION_DESKTOP", "DESKTOP_SESSION", "GDK_BACKEND", "GTK_THEME"} or key.startswith("LC_")}
        environment.update({"CODEX_HOME": config["codex_home"], "CODEX_CLI_PATH": str(wrapper),
                            "CODEX_STATS_APP_LAUNCH": str(launch_path)})
        os.execve(app, [str(app), *app_args], environment)
    finally:
        os.close(descriptor)


def monitor_main_bootstrap(arguments: list) -> bool:
    # Both main GUI plugin keys distinguish its server from startup probes/helpers.
    overrides, words = {}, []
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word in {"-c", "--config"} and index + 1 < len(arguments):
            key, separator, value = arguments[index + 1].partition("=")
            if separator:
                overrides[key] = value
            index += 2
        else:
            words.append(word)
            index += 1
    return (words == ["app-server", "--analytics-default-enabled"]
        and overrides.get("features.code_mode_host") == "true"
        and all(key in overrides for key in (
            "plugins.codex-app-tools@openai-bundled.mcp_servers.codex_app.enabled",
            "plugins.code-review@openai-bundled.mcp_servers.code-review.enabled")))


def monitor_app_proxy_main() -> int:
    """Invoked only by the private CODEX_CLI_PATH executable generated by launch-app."""
    import asyncio
    import fcntl
    import subprocess
    import signal
    child, lease, runtime, lease_owned = None, None, None, False
    def interrupted(signum, frame):
        raise KeyboardInterrupt
    for signum in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, interrupted)
    try:
        launch_path = Path(os.environ["CODEX_STATS_APP_LAUNCH"])
        monitor_private(launch_path)
        launch = json.loads(launch_path.read_text())
        parent = monitor_process(os.getppid())
        config = mq_config(Path(launch["config"]))
        runtime = monitor_shared_runtime(config)
        if launch_path != runtime / "launch.json":
            raise RuntimeError("unexpected application launch descriptor")
        environment = dict(os.environ)
        environment.pop("CODEX_STATS_APP_LAUNCH", None)
        environment["CODEX_CLI_PATH"] = launch["codex"]
        main = (parent["pid"] == launch["gui"]["pid"] and parent["birth"] == launch["gui"]["birth"]
                and parent["exe"] == launch["app"]
                and str(Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser().resolve()) == launch["codex_home"]
                and os.environ.get("CODEX_INTERNAL_ORIGINATOR_OVERRIDE") == "Codex Desktop"
                and monitor_main_bootstrap(sys.argv[1:]))
        if not main:
            os.execve(launch["codex"], [launch["codex"], *sys.argv[1:]], environment)
        try:
            from websockets.client import unix_connect
        except ImportError as error:
            raise RuntimeError("shared application relay requires the optional websockets package") from error
        lease = os.open(runtime / "lease", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        lease_metadata = monitor_private(runtime / "lease")
        fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
        lease_owned = True
        ready = runtime / "ready.json"
        ready.unlink(missing_ok=True)
        alias = Path(config["_socket_alias"])
        if alias.exists() or Path(config["socket"]).exists():
            raise RuntimeError("native endpoint appeared before the GUI relay started")
        parent_pid = os.getpid()
        def parent_exit_signal():
            import ctypes
            if ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM, 0, 0, 0) != 0:
                raise OSError("could not bind native server lifetime to its relay")
            if os.getppid() != parent_pid:
                os._exit(1)
        default_alias = Path(config["codex_home"]) / "app-server-control/app-server-control.sock"
        listener = "unix://" if alias == default_alias else "unix://" + str(alias)
        child = subprocess.Popen([launch["codex"], *sys.argv[1:], "--listen", listener],
                                 env=environment, stdin=subprocess.DEVNULL, stdout=sys.stderr,
                                 preexec_fn=parent_exit_signal)

        async def relay():
            connection = None
            deadline = asyncio.get_running_loop().time() + config["native_timeout"]
            while asyncio.get_running_loop().time() < deadline:
                if child.poll() is not None:
                    raise RuntimeError("owned native server exited during startup")
                endpoint = str(alias.resolve())
                try:
                    connection = await unix_connect(endpoint, compression=None, open_timeout=1,
                        close_timeout=3, max_size=MONITOR_RELAY_LIMIT, max_queue=4)
                    break
                except (FileNotFoundError, ConnectionRefusedError):
                    await asyncio.sleep(0.05)
            if connection is None:
                raise RuntimeError("owned native server did not become ready")
            import socket
            import struct
            try:
                peer = connection.transport.get_extra_info("socket")
                pid, uid, _ = struct.unpack("3i", peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                if pid != child.pid or uid != os.getuid():
                    raise RuntimeError("GUI relay connected to another native server")
                live = mq_config(Path(launch["config"]))
                if live["socket"] != endpoint:
                    raise RuntimeError("native control alias does not match the configured endpoint")
                monitor_permission_status_value = monitor_permission_status(live)["state"]
                if monitor_permission_status_value == "conflict_or_unreadable":
                    raise RuntimeError("existing monitor profile does not match the live endpoint")
                metadata = Path(endpoint).stat()
                receipt = {"codex_home": live["codex_home"], "socket": endpoint,
                    "gui": parent, "proxy": monitor_process(os.getpid()), "native": monitor_process(child.pid),
                    "lease": [lease_metadata.st_dev, lease_metadata.st_ino],
                    "socket_identity": [metadata.st_dev, metadata.st_ino]}
                reader = asyncio.StreamReader(limit=MONITOR_RELAY_LIMIT + 1)
                transport, _ = await asyncio.get_running_loop().connect_read_pipe(
                    lambda: asyncio.StreamReaderProtocol(reader), sys.stdin.buffer)
                loop = asyncio.get_running_loop()
                output_transport, output_protocol = await loop.connect_write_pipe(
                    lambda: asyncio.streams.FlowControlMixin(loop=loop), sys.stdout.buffer)
                writer = asyncio.StreamWriter(output_transport, output_protocol, None, loop)
                initialization = []
                initialized = asyncio.Event()

                async def startup_watchdog():
                    await asyncio.wait_for(initialized.wait(), max(0, deadline - loop.time()))
                    # Successful startup removes the deadline, not the live relay.
                    await loop.create_future()

                async def to_native():
                    while raw := await reader.readline():
                        if len(raw) > MONITOR_RELAY_LIMIT:
                            raise RuntimeError("GUI relay message exceeds 64 MiB")
                        message = json.loads(raw)
                        if message.get("method") == "initialize" and "id" in message:
                            initialization.append(message["id"])
                        await connection.send(raw.decode().rstrip("\n"))

                async def to_gui():
                    async for raw in connection:
                        if not isinstance(raw, str) or len(raw.encode()) > MONITOR_RELAY_LIMIT:
                            raise RuntimeError("native GUI relay message exceeds 64 MiB or is binary")
                        message = json.loads(raw)
                        writer.write((raw + "\n").encode())
                        await writer.drain()
                        if (message.get("id") in initialization and "result" in message
                                and "error" not in message and "method" not in message):
                            monitor_runtime_write(ready, receipt)
                            initialized.set()
                            initialization.clear()

                tasks = [asyncio.create_task(to_native()), asyncio.create_task(to_gui()),
                         asyncio.create_task(startup_watchdog())]
                try:
                    done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
                    for task in done:
                        task.result()
                finally:
                    ready.unlink(missing_ok=True)
                    for task in tasks:
                        task.cancel()
                    await asyncio.gather(*tasks, return_exceptions=True)
                    transport.close()
                    output_transport.close()
            finally:
                ready.unlink(missing_ok=True)
                await connection.close()

        asyncio.run(relay())
        return 0
    except (Exception, KeyboardInterrupt) as error:
        print(f"codex-session-stats application relay: {type(error).__name__}: {error}", file=sys.stderr)
        return 1
    finally:
        if lease is not None:
            if runtime is not None and lease_owned:
                (runtime / "ready.json").unlink(missing_ok=True)
            if child is not None and child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=5)
            os.close(lease)


def monitor_permission_definition(config: dict) -> dict:
    from urllib.parse import urlsplit
    state_dir = Path(config["state_file"]).parent.resolve()
    codex_home = Path(config["codex_home"]).resolve()
    roots = [config["cwd"]]
    binding = config.get("codex_project_binding")
    if binding:
        roots.extend(binding["roots"])
        for context in binding["existing_threads"].values():
            roots.extend(context["roots"])
    protected = (Path.home().resolve(), codex_home, *(Path(root).resolve() for root in roots))
    if (any(path.is_relative_to(state_dir) for path in protected)
            or state_dir.is_relative_to(codex_home)):
        raise RuntimeError("monitor state directory must be private and separate from workspace/Codex roots")
    if state_dir.exists():
        metadata = state_dir.stat()
        if (not state_dir.is_dir() or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o077):
            raise RuntimeError("monitor state directory must be an owned private directory (chmod 700)")
    return {"description": "Managed by codex-session-stats monitor-gitlab.", "extends": ":read-only",
        "filesystem": {str(state_dir): "write"},
        "network": {"enabled": True, "allow_local_binding": True,
            "domains": {urlsplit(config["gitlab_url"]).hostname: "allow"},
            "unix_sockets": {config["socket"]: "allow"}}}


def monitor_permission_missing(actual, expected: dict) -> bool:
    if actual is None:
        return True
    if not isinstance(actual, dict) or any(key not in expected for key in actual):
        raise RuntimeError("monitor permission profile has conflicting or unknown rules; inspect Codex configuration")
    missing = len(actual) != len(expected)
    for key, value in actual.items():
        wanted = expected[key]
        if isinstance(wanted, dict):
            if not isinstance(value, dict):
                raise RuntimeError("monitor permission profile has invalid nested rules; inspect Codex configuration")
            missing = monitor_permission_missing(value, wanted) or missing
        elif type(value) is not type(wanted) or value != wanted:
            raise RuntimeError("monitor permission profile has conflicting rules; inspect Codex configuration")
    return missing


def monitor_permission_user_layer(config: dict, response: dict) -> dict:
    layers = response.get("layers")
    if not isinstance(layers, list):
        raise RuntimeError("native configuration did not provide versioned user layers")
    active = [layer for layer in layers if layer.get("disabledReason") is None]
    users = [layer for layer in active if layer["name"].get("type") == "user"
             and layer["name"].get("profile") is None]
    target = (Path(config["codex_home"]) / "config.toml").resolve()
    if (len(users) != 1 or not isinstance(users[0].get("version"), str)
            or not users[0]["version"] or Path(users[0]["name"]["file"]).resolve() != target
            or not isinstance(users[0].get("config"), dict)):
        raise RuntimeError("native user configuration layer does not match the selected codex_home")
    for layer in active:
        permissions = layer.get("config", {}).get("permissions", {})
        if not isinstance(permissions, dict):
            raise RuntimeError("monitor permission profile layer has invalid rules")
        if layer is not users[0] and MONITOR_PERMISSION_PROFILE in permissions:
            raise RuntimeError("monitor permission profile is overridden by another configuration layer")
    return users[0]


def monitor_unrelated_configuration(data: dict) -> dict:
    other = {key: value for key, value in data.items() if key != "permissions"}
    permissions = {key: value for key, value in data.get("permissions", {}).items()
                   if key != MONITOR_PERMISSION_PROFILE}
    if permissions:
        other["permissions"] = permissions
    return other


def monitor_ensure_permissions(config: dict, *, check_only=False) -> dict:
    expected = monitor_permission_definition(config)
    params = {"cwd": config["cwd"], "includeLayers": True}
    before = monitor_permission_user_layer(config, monitor_native(config, "config/read", params))
    actual = before["config"].get("permissions", {}).get(MONITOR_PERMISSION_PROFILE)
    target = str((Path(config["codex_home"]) / "config.toml").resolve())
    result = {"name": MONITOR_PERMISSION_PROFILE, "config_file": target, "changed": False}
    if not monitor_permission_missing(actual, expected):
        return result
    if check_only:
        raise RuntimeError("monitor permission profile is missing or incomplete; restore the existing named profile before enabling Codex review")
    uncertain = None
    try:
        written = monitor_native(config, "config/batchWrite", {"filePath": target,
            "expectedVersion": before["version"], "reloadUserConfig": False,
            "edits": [{"keyPath": "permissions." + MONITOR_PERMISSION_PROFILE,
                       "value": expected, "mergeStrategy": "upsert"}]})
        if (written.get("status") not in {"ok", "okOverridden"}
                or written.get("filePath") != target or not written.get("version")):
            raise RuntimeError("native configuration write returned an uncertain acknowledgement")
    except RuntimeError as error:
        uncertain = error
    # A lost acknowledgement or concurrent edit is never a reason to repeat a stale write.
    after = monitor_permission_user_layer(config, monitor_native(config, "config/read", params))
    if monitor_unrelated_configuration(before["config"]) != monitor_unrelated_configuration(after["config"]):
        raise RuntimeError("Codex configuration changed concurrently; inspect it before rerunning")
    if monitor_permission_missing(after["config"].get("permissions", {}).get(MONITOR_PERMISSION_PROFILE), expected):
        raise RuntimeError("monitor permission profile was not registered; inspect Codex configuration before retry") from uncertain
    return {**result, "changed": True, "reconciled": uncertain is not None}


def monitor_permission_status(config: dict) -> dict:
    import tomllib
    target = Path(config["codex_home"]) / "config.toml"
    result = {"name": MONITOR_PERMISSION_PROFILE, "config_file": str(target), "state": "missing"}
    try:
        if target.exists():
            data = tomllib.loads(target.read_text(encoding="utf-8"))
            profile = data.get("permissions", {}).get(MONITOR_PERMISSION_PROFILE)
            if profile is not None:
                result["state"] = "incomplete" if monitor_permission_missing(
                    profile, monitor_permission_definition(config)) else "configured_on_disk"
    except (OSError, ValueError, RuntimeError, TypeError, AttributeError):
        result["state"] = "conflict_or_unreadable"
    return result


def monitor_verify_permission_selection(response: dict):
    if response.get("activePermissionProfile") != {"id": MONITOR_PERMISSION_PROFILE, "extends": ":read-only"}:
        raise RuntimeError("native conversation did not select the monitor permission profile")


def monitor_trusted_control_path(path: Path, state_dir: Path, *, private: bool, diagnostic=False):
    import stat
    label = "configuration" if private else "script"
    metadata = path.lstat()
    if ((state_dir is not None and path.is_relative_to(state_dir)) or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid() or metadata.st_nlink != 1
            or (private and metadata.st_mode & 0o077)
            or (not private and not os.access(path, os.X_OK))):
        requirement = "private" if private else "executable"
        raise RuntimeError(f"trusted {label} must be owned, regular, outside writable state and {requirement}")
    for parent in path.parents:
        metadata = parent.lstat()
        # A read-only sandbox can remap root-owned ancestors to an overflow UID.
        # Only offline diagnostics may omit this ownership proof; types stay strict.
        if (not stat.S_ISDIR(metadata.st_mode)
                or (not diagnostic and metadata.st_uid not in {0, os.getuid()})):
            raise RuntimeError(f"trusted {label} directory must be owned by the current user or root: {parent}")


def monitor_digest(value) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                     ensure_ascii=False).encode()).hexdigest()


def monitor_id() -> str:
    import uuid
    return str(uuid.uuid4())


def monitor_now() -> datetime.datetime:
    return datetime.datetime.now(datetime.timezone.utc)


def monitor_project_url(value: str) -> tuple[str, str]:
    from urllib.parse import unquote, urlsplit
    parsed = urlsplit(value)
    if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password
            or parsed.query or parsed.fragment or any(ord(c) < 33 for c in value)):
        raise RuntimeError("project URL must be HTTPS without credentials, query or fragment")
    path = unquote(parsed.path).strip("/")
    if (len(path.split("/")) < 2 or any(part in {"", ".", ".."}
            or not re.fullmatch(r"[A-Za-z0-9_.-]+", part) for part in path.split("/"))):
        raise RuntimeError("project URL must contain a valid namespace/project path")
    return f"https://{parsed.netloc}", path


def monitor_default_config(project_url: str, project_id: int, server: str) -> dict:
    origin, project_path = monitor_project_url(project_url)
    codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    state_root = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser()
    return {
        "version": 1, "gitlab_url": origin, "project_id": project_id,
        "project_path": project_path, "credential_mcp_server": server,
        "codex_home": str(codex_home), "cwd": str(Path.home()),
        "socket": str(codex_home / "app-server-control/app-server-control.sock"),
        "state_file": str(state_root / "codex-session-stats/gitlab-monitor.sqlite3"),
        "timezone": "America/Sao_Paulo", "weekdays": [0, 1, 2, 3, 4, 5],
        "open_hour": 7, "close_hour": 22, "interval_minutes": 15,
        "model": "gpt-6.1-sol", "effort": "xhigh", "http_timeout": 15,
        "native_timeout": 30, "max_response_bytes": 8 * 1024 * 1024,
        "max_pages": 100, "max_notes_per_mr": 10000, "max_mrs": 500,
        "cycle_seconds": 120, "max_history_pages": 100,
    }


MONITOR_TOML_PROJECT = {"gitlab_url", "project_path", "project_id"}
MONITOR_TOML_SCHEDULE = {"timezone", "weekdays", "open_hour", "close_hour", "interval_minutes"}
MONITOR_TOML_OPTIONS = MONITOR_TOML_PROJECT | MONITOR_TOML_SCHEDULE | {"parallel", "projects"}


def monitor_project_roots(roots, state_dir: Path, *, existing=True) -> list:
    if not isinstance(roots, list) or not roots or len(roots) > 100:
        raise RuntimeError("invalid Codex project roots")
    for root in roots:
        if (not isinstance(root, str) or not Path(root).is_absolute()
                or os.path.normpath(root) != root
                or existing and (str(Path(root).resolve()) != root or not Path(root).is_dir())):
            raise RuntimeError("Codex project roots must be canonical existing absolute directories")
        if Path(root).is_relative_to(state_dir):
            raise RuntimeError("Codex project root must be outside agent-writable state")
    if len(set(roots)) != len(roots):
        raise RuntimeError("duplicate Codex project roots")
    return list(roots)


def monitor_project_binding(binding, name: str, state_dir: Path, *, existing=True) -> dict:
    if (not isinstance(binding, dict) or set(binding) != {"id", "name", "roots", "existing_threads"}
            or binding["name"] != name
            or not re.fullmatch(r"[a-f0-9-]{36}", str(binding["id"]))
            or not isinstance(binding["existing_threads"], dict)):
        raise RuntimeError("invalid Codex project binding; run select-project --name NAME")
    monitor_project_roots(binding["roots"], state_dir, existing=existing)
    for thread_id, context in binding["existing_threads"].items():
        if (not re.fullmatch(r"[a-f0-9-]{36}", thread_id) or not isinstance(context, dict)
                or set(context) != {"cwd", "project_id", "roots"}
                or context["project_id"] is not None
                and not re.fullmatch(r"[a-f0-9-]{36}", str(context["project_id"]))):
            raise RuntimeError("invalid existing conversation project context")
        roots = monitor_project_roots(context["roots"], state_dir, existing=existing)
        if context["cwd"] != roots[0]:
            raise RuntimeError("invalid existing conversation primary directory")
    return binding


def monitor_resolve_project(config: dict, name: str) -> dict:
    if (not isinstance(name, str) or not name.strip() or len(name) > 256
            or any(ord(c) < 32 for c in name)):
        raise RuntimeError("invalid Codex project name")
    matches, cursor, seen = [], None, set()
    for _ in range(config["max_history_pages"]):
        params = {"limit": 100}
        if cursor:
            params["cursor"] = cursor
        page = monitor_native(config, "project/list", params)
        if (not isinstance(page.get("data"), list) or "nextCursor" not in page
                or page["nextCursor"] is not None and
                (not isinstance(page["nextCursor"], str) or not page["nextCursor"])
                or any(not isinstance(p, dict) or not isinstance(p.get("name"), str)
                       or not re.fullmatch(r"[a-f0-9-]{36}", str(p.get("id", ""))) for p in page["data"])):
            raise RuntimeError("invalid Codex project inventory page")
        matches.extend(p for p in page["data"] if p["name"] == name)
        cursor = page["nextCursor"]
        if cursor is None:
            break
        if cursor in seen:
            raise RuntimeError("repeated Codex project inventory cursor")
        seen.add(cursor)
    else:
        raise RuntimeError("Codex project inventory exceeds page bound")
    if len(matches) != 1:
        raise RuntimeError("Codex project name must match exactly one project: " + name)
    selected = matches[0]
    entries = selected.get("roots")
    if not isinstance(entries, list) or any(not isinstance(r, dict) or "path" not in r for r in entries):
        raise RuntimeError("invalid Codex project roots")
    return {"id": selected["id"], "name": name,
            "roots": monitor_project_roots([r["path"] for r in entries], Path(config["state_file"]).parent)}


def monitor_verify_project(config: dict):
    if config.get("codex_project_name"):
        actual = monitor_resolve_project(config, config["codex_project_name"])
        expected = {k: config["codex_project_binding"][k] for k in ("id", "name", "roots")}
        if actual != expected:
            raise RuntimeError("Codex project identity or ordered roots changed; inspect and run select-project")


def monitor_thread_context(config: dict, thread_id: str) -> dict:
    binding = config["codex_project_binding"]
    return binding["existing_threads"].get(thread_id, {
        "cwd": binding["roots"][0], "project_id": binding["id"], "roots": binding["roots"]})


def monitor_cold_roots(config, thread):
    path = Path(thread.get('path') or '')
    home = Path(config['codex_home']).resolve()
    if (not path.is_absolute() or path.resolve() != path or not any(
            path.is_relative_to(home / folder) for folder in ('sessions','archived_sessions'))):
        raise RuntimeError('native cold context path is outside protected history')
    import stat
    monitor_private(home,directory=True)
    with os.fdopen(os.open(path,os.O_RDONLY | os.O_NOFOLLOW),'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid!=os.getuid():
            raise RuntimeError('native cold context must be an owned regular file')
        raw = stream.read(config['max_response_bytes']+1)
    if len(raw)>config['max_response_bytes']:
        raise RuntimeError('native cold context exceeds configured bound')
    metadata, latest = [], None
    for line in raw.splitlines():
        row = json.loads(line)
        if not isinstance(row,dict):
            raise RuntimeError('invalid native cold context record')
        if row.get('type')=='session_meta':
            metadata.append(row.get('payload'))
        elif row.get('type')=='turn_context':
            latest = row.get('payload')
            if not isinstance(latest,dict):
                raise RuntimeError('invalid latest native cold context')
    if (len(metadata)!=1 or not isinstance(metadata[0],dict)
            or metadata[0].get('id')!=thread['id'] or metadata[0].get('cwd')!=thread['cwd']):
        raise RuntimeError('native cold context identity mismatch')
    if latest is None:
        raise RuntimeError('latest native cold context is missing')
    context = latest
    roots = context.get('workspace_roots')
    if (context.get('cwd')!=thread['cwd'] or not isinstance(roots,list) or not roots
            or any(not isinstance(r,str) for r in roots)):
        raise RuntimeError('native cold workspace roots are unavailable or changed')
    return roots


def monitor_thread_source_roots(config: dict, thread: dict) -> list:
    environments = thread.get("environments")
    if environments is None and thread.get('status',{}).get('type')=='notLoaded':
        roots = monitor_cold_roots(config,thread)
    elif (not isinstance(environments, list) or len(environments) != 1
            or not isinstance(environments[0], dict) or environments[0].get("environmentId") != "local"
            or environments[0].get("cwd") != thread.get("cwd")):
        raise RuntimeError("native project workspace environment is unavailable or ambiguous")
    else:
        roots = environments[0].get("runtimeWorkspaceRoots")
    if not isinstance(roots, list) or any(not isinstance(r, str) for r in roots):
        raise RuntimeError("native project workspace roots are unavailable")
    hosting = set()
    if type(thread.get("createdAt")) is int:
        date = datetime.datetime.fromtimestamp(thread["createdAt"], datetime.timezone.utc).date()
        for delta in (-1, 0, 1):
            day = date + datetime.timedelta(days=delta)
            hosting.add(str(Path(config["codex_home"]) / "visualizations" /
                            day.strftime("%Y/%m/%d") / thread["id"]))
    extras = [r for r in roots if r in hosting]
    if len(extras) > 1 or len(set(roots)) != len(roots):
        raise RuntimeError("native project workspace has conflicting hosting roots")
    for root in extras:
        if str(Path(root).resolve()) != root:
            raise RuntimeError("native project hosting workspace is not canonical")
    return [r for r in roots if r not in hosting]


def monitor_verify_thread_context(config: dict, thread: dict, thread_id: str):
    context = monitor_thread_context(config, thread_id)
    if (thread.get("id") != thread_id or thread.get("cwd") != context["cwd"]
            or monitor_thread_source_roots(config, thread) != context["roots"]):
        raise RuntimeError("native conversation project/workspace context mismatch")


def monitor_analysis_values(settings: dict, path: Path, state_dir: Path) -> dict:
    required = {"model", "model_reasoning_effort"}
    if not required <= set(settings) or set(settings) - required - {"workspace", "codex_project_name"} - MONITOR_TOML_OPTIONS:
        raise RuntimeError("unknown or missing TOML settings")
    project_group = {"gitlab_url"} if "projects" in settings else MONITOR_TOML_PROJECT
    if "projects" in settings:
        monitor_project_entries(settings)
    for group in (project_group, MONITOR_TOML_SCHEDULE):
        if set(settings) & group and not group <= set(settings):
            raise RuntimeError("incomplete TOML project or schedule group")
    if not isinstance(settings["model"], str) or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", settings["model"]):
        raise RuntimeError("invalid model")
    if settings["model_reasoning_effort"] not in {"none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"}:
        raise RuntimeError("invalid model_reasoning_effort")
    result = {"model": settings["model"], "effort": settings["model_reasoning_effort"],
              **{k: v for k, v in settings.items() if k in MONITOR_TOML_OPTIONS}}
    if "codex_project_name" in settings:
        name = settings["codex_project_name"]
        if ("workspace" in settings or not isinstance(name, str) or not name.strip()
                or len(name) > 256 or any(ord(c) < 32 for c in name)):
            raise RuntimeError("codex_project_name requires a nonempty name and excludes workspace")
        return {**result, "codex_project_name": name}
    workspace = settings.get("workspace", "workspace")
    if not isinstance(workspace, str) or not workspace.strip():
        raise RuntimeError("invalid workspace: expected a nonempty path")
    workspace = Path(workspace).expanduser()
    if not workspace.is_absolute():
        workspace = path.parent / workspace
    workspace = workspace.resolve()
    if not workspace.is_dir():
        raise RuntimeError("workspace directory does not exist")
    if workspace.is_relative_to(state_dir):
        raise RuntimeError("workspace must be outside agent-writable state")
    return {**result, "cwd": str(workspace)}


def monitor_analysis_settings(path: Path, state_dir: Path, *, diagnostic=False) -> dict:
    """Read the monitor's small analysis TOML, outside its writable state."""
    import stat
    import tomllib
    try:
        monitor_trusted_control_path(path, state_dir, private=True, diagnostic=diagnostic)
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as stream:
            metadata = os.fstat(stream.fileno())
            if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                    or metadata.st_nlink != 1 or metadata.st_mode & 0o077):
                raise RuntimeError("expected an owned private regular file")
            raw = stream.read(65537)
        if len(raw) > 65536:
            raise RuntimeError("file exceeds 64 KiB")
        settings = tomllib.loads(raw.decode("utf-8"))
        return monitor_analysis_values(settings, path, state_dir)
    except (OSError, RuntimeError, ValueError, TypeError) as error:
        raise RuntimeError(f"invalid analysis configuration: {error}") from error


def monitor_config_data(path: Path, data: dict, *, diagnostic=False, analysis_settings=None, saved_project=False) -> dict:
    data = dict(data)
    if data.get("version") != 1:
        raise RuntimeError("unsupported monitor configuration version")
    if os.name == "posix" and path.stat().st_mode & 0o077:
        raise RuntimeError("monitor configuration must be private (chmod 600)")
    if "projects" in data:
        raise RuntimeError("projects belongs only in the analysis TOML")
    if "codex_project_name" in data:
        raise RuntimeError("codex_project_name belongs only in the analysis TOML")
    if "analysis_config" in data:
        if any(key in data for key in ("model", "effort", "cwd")):
            raise RuntimeError("duplicate analysis settings: use only analysis_config, without model/effort/cwd")
        reference = data["analysis_config"]
        if not isinstance(reference, str) or not reference:
            raise RuntimeError("invalid analysis configuration path")
        target = Path(reference).expanduser()
        if not target.is_absolute():
            target = path.parent / target
        target = Path(os.path.abspath(target))
        settings = analysis_settings if analysis_settings is not None else monitor_analysis_settings(target,
            Path(data["state_file"]).expanduser().resolve().parent, diagnostic=diagnostic)
        if MONITOR_TOML_OPTIONS & set(settings) & set(data):
            raise RuntimeError("duplicate TOML/JSON project, schedule or parallel settings; run migrate-config")
        data.update(settings)
        data["analysis_config"] = str(target)
    data.setdefault("parallel", 1)
    if data.get("codex_project_name"):
        monitor_trusted_control_path(path, Path(data["state_file"]).expanduser().resolve().parent,
                                     private=True, diagnostic=diagnostic)
        binding = monitor_project_binding(data.get("codex_project_binding"), data["codex_project_name"],
                                          Path(data["state_file"]).expanduser().resolve().parent,
                                          existing=not saved_project)
        data["cwd"] = binding["roots"][0]
    elif "codex_project_binding" in data:
        raise RuntimeError("Codex project binding requires codex_project_name in the analysis TOML")
    if "projects" in data:
        entries = monitor_project_entries(data)
        data["_multi"] = True
        data["project_id"], data["project_path"] = entries[0]["id"], entries[0]["path"]
    origin, project = monitor_project_url(data["gitlab_url"] + "/" + data["project_path"])
    if origin != data["gitlab_url"] or project != data["project_path"]:
        raise RuntimeError("noncanonical monitor project identity")
    for name in ("project_id", "parallel", "interval_minutes", "http_timeout", "native_timeout",
                 "max_response_bytes", "max_pages", "max_notes_per_mr", "max_mrs",
                 "cycle_seconds", "max_history_pages"):
        if type(data.get(name)) is not int or data[name] < 1:
            raise RuntimeError(f"{name} must be a positive integer")
    if (type(data.get("open_hour")) is not int or type(data.get("close_hour")) is not int
            or not 0 <= data["open_hour"] < data["close_hour"] <= 24):
        raise RuntimeError("invalid operating hours")
    if (not isinstance(data.get("weekdays"), list) or not data["weekdays"]
            or any(type(d) is not int or not 0 <= d <= 6 for d in data["weekdays"])):
        raise RuntimeError("invalid weekdays")
    ZoneInfo(data["timezone"])
    for name in ("codex_home", "cwd", "socket", "state_file"):
        if name == "socket":
            data["_socket_alias"] = str(Path(data[name]).expanduser().absolute())
        data[name] = str(Path(data[name]).expanduser().resolve())
    if Path(data["state_file"]).is_relative_to(Path(data["codex_home"])):
        raise RuntimeError("monitor state must be outside Codex runtime storage")
    if not (saved_project and data.get('codex_project_name')) and not Path(data["cwd"]).is_dir():
        raise RuntimeError("configured workspace directory does not exist")
    data["_config_path"] = str(path)
    return data


def monitor_project_entries(settings):
    entries = settings.get("projects")
    if (not isinstance(entries, list) or not entries or "project_id" in settings
            or "project_path" in settings or not isinstance(settings.get("gitlab_url"), str)):
        raise RuntimeError("projects requires a nonempty list and excludes legacy project_id/project_path")
    ids, paths = set(), set()
    for entry in entries:
        if (not isinstance(entry, dict) or set(entry) != {"id", "path"}
                or type(entry["id"]) is not int or entry["id"] <= 0 or not isinstance(entry["path"], str)):
            raise RuntimeError("each project requires only a positive id and canonical path")
        origin, path = monitor_project_url(settings["gitlab_url"] + "/" + entry["path"])
        if origin != settings["gitlab_url"] or path != entry["path"] or entry["id"] in ids or path in paths:
            raise RuntimeError("duplicate or noncanonical project identity")
        ids.add(entry["id"]); paths.add(path)
    return entries


def monitor_native(config: dict, method: str, params: dict, *, followup=None) -> dict:
    """The optional dependency belongs exclusively to native-connection operations."""
    if config.get("_native_guard"):
        config["_native_guard"]()
    monitor_shared_owner(config)
    import asyncio
    try:
        from websockets.client import unix_connect
        from websockets.exceptions import WebSocketException
    except ImportError as error:
        raise RuntimeError("native Codex connection requires the optional websockets package; "
                           "other commands remain available") from error

    async def exchange():
        async with unix_connect(config["socket"], compression=None,
                open_timeout=mq_io_timeout(config,"native_timeout"), close_timeout=3,
                max_size=config["max_response_bytes"], max_queue=32) as socket:
            monitor_shared_peer(config, socket)
            await socket.send(json.dumps({"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "codex_stats_gitlab_monitor", "version": "1"},
                "capabilities": {"experimentalApi": True}}}))
            while True:
                response = json.loads(await socket.recv())
                if response.get("id") == 1:
                    if "error" in response:
                        raise RuntimeError("native Codex initialization rejected")
                    break
            await socket.send(json.dumps({"method": "initialized", "params": {}}))
            request_id = 1

            async def request(name, arguments):
                nonlocal request_id
                request_id += 1
                if config.get("_native_guard"):
                    config["_native_guard"]()
                monitor_shared_owner(config)
                monitor_shared_peer(config, socket)
                await socket.send(json.dumps({"id": request_id, "method": name, "params": arguments}))
                while True:
                    response = json.loads(await socket.recv())
                    if response.get("id") == request_id:
                        if "error" in response:
                            raise MonitorNativeRejected(f"native {name} failed (code {response['error'].get('code')})")
                        if not isinstance(response.get("result"), dict):
                            raise RuntimeError(f"invalid native {name} response")
                        return response["result"]

            response = await request(method, params)
            return await followup(request, response) if followup else response

    async def bounded():
        timeout = mq_io_timeout(config,"native_timeout")
        return await asyncio.wait_for(exchange(),timeout)
    try:
        return asyncio.run(bounded())
    except (OSError, TimeoutError, WebSocketException) as error:
        if mq_expired(config):
            raise MonitorCycleYield('cycle ended during native RPC; reconcile delivery',issued=True) from error
        diagnostic = f"{type(error).__name__}, errno={getattr(error, 'errno', None)}"
        raise RuntimeError(f"native {method} transport failed or timed out ({diagnostic}); reconcile before retry") from error


def monitor_credential(config: dict) -> tuple[str, str]:
    import tomllib
    from urllib.parse import urlsplit
    source = Path(config["codex_home"]) / "config.toml"
    server = tomllib.loads(source.read_text())["mcp_servers"][config["credential_mcp_server"]]
    environment = server.get("env", {})
    token = environment.get("GITLAB_PERSONAL_ACCESS_TOKEN")
    endpoint = environment.get("GITLAB_API_URL", "").rstrip("/")
    parsed = urlsplit(endpoint)
    if (not token or parsed.username or parsed.password or parsed.query or parsed.fragment
            or f"{parsed.scheme}://{parsed.netloc}" != config["gitlab_url"]
            or parsed.path not in {"", "/api/v4"}):
        raise RuntimeError("selected MCP credential is missing or does not match the configured HTTPS origin")
    return config["gitlab_url"] + "/api/v4", token


class MonitorGitLab:
    def __init__(self, config: dict, guard=None):
        if config.get("_multi") and not config.get("_project_id"):
            raise RuntimeError("GitLab access requires an explicit project")
        import urllib.request
        self.config = config
        self.base, self._token = monitor_credential(config)

        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *args, **kwargs):
                return None
        self.opener = urllib.request.build_opener(NoRedirect)
        self.last_date = None
        self.last_headers = {}
        self.guard = guard or config.get("_io_guard")

    def get(self, route: str):
        import urllib.error
        import urllib.request
        if not route.startswith("/") or route.startswith("//") or ".." in route:
            raise RuntimeError("invalid GitLab API route")
        if self.guard:
            self.guard()
        request = urllib.request.Request(self.base + route, headers={
            "PRIVATE-TOKEN": self._token, "Accept": "application/json"})
        try:
            with mq_http_deadline(self.config):
                with self.opener.open(request, timeout=mq_io_timeout(self.config,"http_timeout")) as response:
                    body = response.read(self.config["max_response_bytes"] + 1)
                    if len(body) > self.config["max_response_bytes"]:
                        raise RuntimeError("GitLab response exceeds configured byte bound")
                    self.last_date = response.headers.get("Date")
                    self.last_headers = response.headers
                    return json.loads(body)
        except urllib.error.HTTPError as error:
            raise RuntimeError(f"GitLab GET rejected (HTTP {error.code}); no redirect followed") from error
        except (urllib.error.URLError,OSError) as error:
            if mq_expired(self.config):
                raise MonitorCycleYield('cycle ended during GitLab read') from error
            raise RuntimeError("GitLab GET transport failed") from error

    def project(self):
        project = self.get(f"/projects/{self.config['project_id']}")
        if (project.get("id") != self.config["project_id"]
                or project.get("path_with_namespace") != self.config["project_path"]
                or project.get("web_url") != self.config["gitlab_url"] + "/" + self.config["project_path"]):
            raise RuntimeError("authenticated GitLab project identity mismatch")
        self.config["_verified_project"] = {"id": project["id"], "path": project["path_with_namespace"]}
        return project

    def mr(self, iid: int):
        result = self.get(f"/projects/{self.config['project_id']}/merge_requests/{iid}")
        if (result.get("iid") != iid or result.get("project_id") != self.config["project_id"]
                or result.get("web_url") != self.config["gitlab_url"] + "/" +
                self.config["project_path"] + f"/-/merge_requests/{iid}"
                or not re.fullmatch(r"[a-f0-9]{40,64}", result.get("sha", ""))
                or result.get("state") not in {"opened", "closed", "merged", "locked"}
                or not isinstance(result.get("title"), str)):
            raise RuntimeError("authenticated merge request identity mismatch")
        return result

    def pages(self, route: str, *, start_page=1):
        from urllib.parse import urlsplit, urljoin, parse_qs
        endpoint = self.base + route.split("?", 1)[0]
        separator = "&" if "?" in route else "?"
        for page in range(start_page, self.config["max_pages"] + 1):
            data = self.get(f"{route}{separator}per_page=100&page={page}")
            if not isinstance(data, list) or any(not isinstance(item, dict) for item in data):
                raise RuntimeError("invalid GitLab paginated response")
            for href, relation in re.findall(r'<([^>]+)>;\s*rel="?([a-z]+)"?',
                                             self.last_headers.get("Link", "")):
                parsed = urlsplit(urljoin(endpoint, href))
                if f"{parsed.scheme}://{parsed.netloc}{parsed.path}" != endpoint:
                    raise RuntimeError("unexpected GitLab pagination destination")
                if relation == "next" and parse_qs(parsed.query).get("page") != [str(page + 1)]:
                    raise RuntimeError("nonsequential GitLab pagination")
            next_page = self.last_headers.get("X-Next-Page")
            if next_page is not None and next_page not in {"", str(page + 1)}:
                raise RuntimeError("invalid GitLab next-page header")
            final = next_page == "" or (next_page is None and len(data) < 100)
            yield data, final
            if final:
                return
        raise MonitorDeferred("note_or_inventory_page_cap")


class MonitorCycleYield(Exception):
    """Normal bounded-cycle completion, never a reviewer or publication failure."""
    def __init__(self,message,*,issued=False):
        super().__init__(message)
        self.issued = issued


def mq_expired(config):
    import time
    return '_cycle_deadline' in config and time.monotonic()>=config['_cycle_deadline']


def mq_http_deadline(config,*,issued=False):
    from contextlib import contextmanager
    @contextmanager
    def bounded():
        if '_cycle_deadline' not in config:
            yield
            return
        import signal
        import threading
        import time
        mq_budget(config)
        if threading.current_thread() is not threading.main_thread():
            raise RuntimeError('bounded periodic HTTP requires the consumer main thread')
        previous = signal.getsignal(signal.SIGALRM)
        timer = signal.getitimer(signal.ITIMER_REAL)
        started = time.monotonic()
        def expired(signum,frame):
            raise MonitorCycleYield('HTTP wall-clock cycle deadline',issued=issued)
        signal.signal(signal.SIGALRM,expired)
        try:
            signal.setitimer(signal.ITIMER_REAL,max(.000001,config['_cycle_deadline']-started))
            yield
        finally:
            signal.setitimer(signal.ITIMER_REAL,0)
            signal.signal(signal.SIGALRM,previous)
            if timer[0]:
                signal.setitimer(signal.ITIMER_REAL,max(.000001,timer[0]-(time.monotonic()-started)),timer[1])
    return bounded()


def mq_io_timeout(config, key):
    import time
    timeout = config[key]
    if '_cycle_deadline' in config:
        remaining = config['_cycle_deadline'] - time.monotonic()
        if remaining <= 0:
            raise MonitorCycleYield('cycle budget exhausted')
        timeout = min(timeout, remaining)
    return timeout


def mq_budget(config):
    if mq_expired(config):
        raise MonitorCycleYield('cycle budget exhausted')


class MonitorClaudeError(RuntimeError):
    def __init__(self, operation, message, *, not_started=False, returncode=None):
        super().__init__('Claude CLI ' + operation + ' failed: ' + message)
        self.operation, self.not_started, self.returncode = operation, not_started, returncode


class MonitorNativeRejected(RuntimeError):
    pass


class MonitorDeferred(RuntimeError):
    """A visible resource/window bound, not an empty or completed scan."""


def monitor_is_open(config: dict, now=None) -> bool:
    local = (now or monitor_now()).astimezone(ZoneInfo(config["timezone"]))
    return local.weekday() in config["weekdays"] and config["open_hour"] <= local.hour < config["close_hour"]


class MonitorGate:
    def __init__(self, config: dict, *, manual_pilot=False):
        import time
        self.config = config
        self.manual_pilot = manual_pilot
        self.deadline = time.monotonic() + config["cycle_seconds"]

    def check(self):
        import time
        if not self.manual_pilot and not monitor_is_open(self.config):
            raise MonitorDeferred("outside_window")
        if time.monotonic() >= self.deadline:
            raise MonitorDeferred("global_cycle_budget")


def monitor_note(note: dict, discussion: str) -> dict:
    if (type(note.get("id")) is not int or note["id"] < 1 or not isinstance(note.get("body"), str)
            or type(note.get("author", {}).get("id")) is not int or note["author"]["id"] < 1
            or any(type(note.get(key, False)) is not bool for key in ("system", "resolvable", "resolved"))):
        raise RuntimeError("invalid authenticated discussion note")
    created = datetime.datetime.fromisoformat(note["created_at"].replace("Z", "+00:00"))
    if created.tzinfo is None:
        raise RuntimeError("discussion note lacks an aware provider timestamp")
    return {"id": int(note["id"]), "discussion": discussion,
            "revision": monitor_digest(note["body"]), "author_id": int(note["author"]["id"]),
            "created_at": note["created_at"], "system": note.get("system", False),
            "resolvable": note.get("resolvable", False), "resolved": note.get("resolved", False)}


def monitor_thread_snapshot(thread: dict) -> dict:
    return {"id": thread["id"], "notes": [monitor_note(n, thread["id"]) for n in thread["notes"]]}


def monitor_assign_app_project(config: dict, thread_id: str):
    """Use the app's separate project namespace for a newly created chat only."""
    def call(tool, arguments):
        response = monitor_native(config, "mcpServer/tool/call", {"threadId": thread_id,
            "server": "codex_app", "tool": tool, "arguments": arguments})
        blocks = response.get("content") if isinstance(response, dict) else None
        if (not isinstance(blocks, list) or len(blocks) != 1 or response.get("isError")
                or not isinstance(blocks[0], dict) or blocks[0].get("type") != "text"
                or not isinstance(blocks[0].get("text"), str)):
            raise RuntimeError(f"Codex app {tool} returned an error or unsupported envelope")
        try:
            result = json.loads(blocks[0]["text"])
        except ValueError as error:
            raise RuntimeError(f"Codex app {tool} returned invalid JSON") from error
        if not isinstance(result, dict):
            raise RuntimeError(f"Codex app {tool} returned an unsupported result")
        return result

    inventory = call("list_projects", {})
    projects = inventory.get("projects")
    if (inventory.get("schemaVersion") != 2 or not isinstance(projects, list)
            or any(not isinstance(project, dict) for project in projects)):
        raise RuntimeError("Codex app project inventory is unavailable or unsupported")
    matches = [project for project in projects if project.get("projectKind") == "local"
               and project.get("hostId") == "local" and project.get("label") == config["codex_project_name"]]
    if len(matches) != 1:
        raise RuntimeError("Codex app project name must match exactly one local project")
    project = matches[0]
    project_id = project.get("projectId")
    if (not isinstance(project_id, str) or not re.fullmatch(r"[a-f0-9-]{36}", project_id)
            or project.get("path") != config["codex_project_binding"]["roots"][0]):
        raise RuntimeError("Codex app project identity or primary directory mismatch")
    expected = {"source": "codex", "threadId": thread_id, "hostId": "local", "projectId": project_id}
    acknowledgement = call("move_thread_to_project", expected)
    if any(acknowledgement.get(key) != value for key, value in expected.items()):
        raise RuntimeError("Codex app did not acknowledge the requested chat/project assignment")


def monitor_turn_page(config, thread_id, cursor=None):
    params = {"threadId": thread_id, "limit": 100, "itemsView": "notLoaded", "sortDirection": "desc"}
    if cursor:
        params["cursor"] = cursor
    result = monitor_native(config, "thread/turns/list", params)
    if (not isinstance(result.get("data"), list) or "nextCursor" not in result
            or not (result["nextCursor"] is None
                    or isinstance(result["nextCursor"], str) and result["nextCursor"])):
        raise RuntimeError("invalid native history page/cursor; completeness is unverified")
    return result


def monitor_turns(config: dict, thread_id: str, *, stop_ids=()) -> list:
    turns, cursor = [], None
    for _ in range(config["max_history_pages"]):
        result = monitor_turn_page(config, thread_id, cursor)
        turns.extend(result["data"])
        cursor = result["nextCursor"]
        if cursor is None or stop_ids and set(stop_ids).issubset(t['id'] for t in turns):
            return turns
    raise RuntimeError("native thread history exceeds configured page bound")


def main() -> int:
    if sys.argv[1:2] == ["current"]:
        return current_main()
    if sys.argv[1:2] == ["session-context"]:
        return session_context_main()
    if sys.argv[1:2] == ["find"]:
        return search_main()
    if sys.argv[1:2] == ["monitor-gitlab"]:
        return mq_main()
    arguments = parse_arguments()
    codex_home = arguments.codex_home.expanduser().resolve()
    try:
        timezone = ZoneInfo(arguments.timezone)
        threads = load_threads(codex_home)
        session_names = load_session_names(codex_home)
        executions = parse_executions(threads, session_names)
        filtered = filter_executions(executions, arguments, timezone)
        selected = filtered[: arguments.limit]
        analyze_execution_events(
            selected, calculate_gaps=not arguments.skip_gap_analysis
        )
        mark_overlaps(selected, filtered)
    except (OSError, RuntimeError, sqlite3.Error, ZoneInfoNotFoundError) as error:
        print(f"codex-session-stats: {error}", file=sys.stderr)
        return 1

    records = [
        public_record(rank, execution, timezone)
        for rank, execution in enumerate(selected, start=1)
    ]
    if arguments.format == "json":
        json.dump(records, sys.stdout, ensure_ascii=False, indent=2)
        print()
    elif arguments.format == "csv":
        print_csv(records)
    else:
        print_markdown(records, arguments.max_description)
    return 0


# Simple monitor queue. The consumer, never a model, owns transitions and public effects.
MQ_SCHEMA = 1
MQ_REVIEWERS = {'claude', 'codex'}
MQ_PERMISSION_PROFILE = 'codex-session-stats-gitlab-review'
MQ_INSTRUCTIONS_VERSION = 2


def mq_reviewers(value):
    if (not isinstance(value, list) or not value or len(value) > 2
            or any(not isinstance(item, str) or item not in MQ_REVIEWERS for item in value)
            or len(set(value)) != len(value)):
        raise RuntimeError('reviewers must be a nonempty ordered unique list of claude/codex')
    return list(value)


def mq_stamp():
    return monitor_now().timestamp()


class MonitorQueue:
    """One transactional FIFO. Native attempts and effects are fields of its jobs."""
    def __init__(self, config, *, readonly=False):
        self.config = config
        self.path = Path(config['queue_file'])
        self.readonly = readonly
        identity = {'schema': MQ_SCHEMA, 'origin': config['gitlab_url'],
                    'codex_home': config['codex_home']}
        if self.path.exists() and self.path.stat().st_size:
            monitor_private(self.path)
            probe = sqlite3.connect(self.path.as_uri() + '?mode=ro', uri=True, timeout=15)
            try:
                tables = {row[0] for row in probe.execute("SELECT name FROM sqlite_master WHERE type='table'")}
                if not {'metadata', 'jobs', 'mrs', 'effects'} <= tables:
                    raise RuntimeError('not a fresh monitor queue; predecessor databases are never imported')
                row = probe.execute("SELECT value FROM metadata WHERE key='identity'").fetchone()
                if row is None or json.loads(row[0]) != identity:
                    raise RuntimeError('fresh queue identity mismatch; no migration is performed')
            finally:
                probe.close()
        if readonly:
            self.db = sqlite3.connect(self.path.as_uri() + '?mode=ro', uri=True, timeout=15)
        else:
            self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            monitor_private(self.path.parent, directory=True)
            if not self.path.exists():
                descriptor = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
                os.close(descriptor)
            monitor_private(self.path)
            self.db = sqlite3.connect(self.path, timeout=15, isolation_level=None)
            self.db.execute('PRAGMA journal_mode=WAL')
            self.db.execute('PRAGMA synchronous=FULL')
            self.db.executescript('''
                CREATE TABLE IF NOT EXISTS metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);
                CREATE TABLE IF NOT EXISTS mrs (
                    repository INTEGER NOT NULL, iid INTEGER NOT NULL, value TEXT NOT NULL,
                    PRIMARY KEY(repository,iid));
                CREATE TABLE IF NOT EXISTS jobs (
                    sequence INTEGER PRIMARY KEY AUTOINCREMENT,
                    id TEXT NOT NULL UNIQUE, source_key TEXT NOT NULL UNIQUE,
                    repository INTEGER NOT NULL, iid INTEGER NOT NULL,
                    state TEXT NOT NULL CHECK(state IN ('pending','running','completed')),
                    value TEXT NOT NULL);
                CREATE UNIQUE INDEX IF NOT EXISTS one_running ON jobs(state) WHERE state='running';
                CREATE TABLE IF NOT EXISTS effects (
                    key TEXT PRIMARY KEY, repository INTEGER NOT NULL, iid INTEGER NOT NULL,
                    value TEXT NOT NULL);
            ''')
        self.db.row_factory = sqlite3.Row
        saved = self.meta('identity')
        if saved is None and not readonly:
            with self.atomic():
                if self.meta('identity') is None:
                    self.set_meta('identity', identity)
                    self.set_meta('epoch', monitor_id())
        if self.meta('identity') != identity:
            self.db.close()
            raise RuntimeError('fresh queue identity mismatch; no migration is performed')
        self.epoch = self.meta('epoch')

    def close(self):
        self.db.close()

    def atomic(self):
        from contextlib import contextmanager
        @contextmanager
        def transaction():
            if self.readonly:
                raise RuntimeError('queue is read-only')
            self.db.execute('BEGIN IMMEDIATE')
            try:
                yield
                self.db.execute('COMMIT')
            except BaseException:
                self.db.execute('ROLLBACK')
                raise
        return transaction()

    def meta(self, key):
        row = self.db.execute('SELECT value FROM metadata WHERE key=?', (key,)).fetchone()
        return json.loads(row['value']) if row else None

    def set_meta(self, key, value):
        self.db.execute('INSERT INTO metadata VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
                        (key, json.dumps(value, ensure_ascii=False)))

    def mr(self, repository, iid):
        row = self.db.execute('SELECT value FROM mrs WHERE repository=? AND iid=?', (repository, iid)).fetchone()
        return json.loads(row['value']) if row else {'repository_id': repository, 'iid': iid,
            'chats': {}, 'reviewed_head': None, 'hold': None}

    def put_mr(self, record):
        self.db.execute('INSERT INTO mrs VALUES(?,?,?) ON CONFLICT(repository,iid) DO UPDATE SET value=excluded.value',
            (record['repository_id'], record['iid'], json.dumps(record, ensure_ascii=False)))

    def mrs(self):
        return [json.loads(r['value']) for r in self.db.execute('SELECT value FROM mrs ORDER BY repository,iid')]

    @staticmethod
    def decode(row):
        if row is None:
            return None
        return {**json.loads(row['value']), 'sequence': row['sequence'], 'state': row['state']}

    def jobs(self, state=None):
        sql, values = 'SELECT * FROM jobs', ()
        if state is not None:
            sql, values = sql+' WHERE state=?', (state,)
        return [self.decode(row) for row in self.db.execute(sql+' ORDER BY sequence', values)]

    def job(self, identifier):
        return self.decode(self.db.execute('SELECT * FROM jobs WHERE id=?', (identifier,)).fetchone())

    def save(self, job):
        if job['epoch'] != self.epoch:
            raise RuntimeError('stale queue epoch')
        cursor = self.db.execute('UPDATE jobs SET state=?,value=? WHERE id=? AND repository=? AND iid=?',
            (job['state'], json.dumps(job, ensure_ascii=False), job['id'], job['repository_id'], job['iid']))
        if cursor.rowcount != 1:
            raise RuntimeError('job identity changed')

    @staticmethod
    def admission(job):
        return job.get('admission',{'kind':job['kind'],'head':job['head'],'source':job['source']})

    def _coalesce(self, allowed_repositories):
        """Called only inside enqueue/reserve's write transaction, before reservation freezes work."""
        groups = {}
        effects = {e.get('job_id') for e in self.effects()}
        held = {r['hold'].get('job_id') for r in self.mrs() if r.get('hold')}
        rows = [self.decode(row) for row in self.db.execute(
            "SELECT * FROM jobs WHERE state!='completed' ORDER BY sequence")]
        for job in rows:
            key = (job['repository_id'],job['iid'])
            eligible = (job['repository_id'] in allowed_repositories and job['state']=='pending'
                and job['kind'] in {'code','discussion'} and job['source'].get('origin')=='automatic'
                and not job['stages'] and job['batch'] is None and job['prepared'] is None
                and job['wait_reason'] is None and not job['retry_at'] and job['outcome'] is None
                and not any(job.get(k) for k in ('rounds','workspace','answers','questions',
                    'needs_round_reset','validation_error','resumed_from','coalescing_frozen'))
                and job['id'] not in effects and job['id'] not in held)
            previous = groups.get(key)
            if not eligible:
                groups.pop(key,None)
                continue
            if previous is None or previous['reviewers']!=job['reviewers']:
                groups[key] = job
                continue
            # Flatten contributing admissions, not effective representatives. Otherwise a
            # later discussion could forget code that was absorbed in an earlier transaction.
            members = [previous,*[self.job(i) for i in previous.get('coalesced_jobs',[])],
                       job,*[self.job(i) for i in job.get('coalesced_jobs',[])]]
            members.sort(key=lambda value:value['sequence'])
            latest = members[-1]
            head = self.admission(latest)['head']
            codes = [m for m in members if self.admission(m)['kind']=='code'
                     and self.admission(m)['head']==head]
            previous.setdefault('admission',self.admission(previous))
            previous.update(kind='code' if codes else 'discussion',head=head,context=latest['context'],
                target_event=(codes[-1] if codes else latest)['id'],
                coalesced_jobs=[m['id'] for m in members if m['id']!=previous['id']])
            self.save(previous)
            for member in members:
                if member['id']==previous['id'] or member.get('coalesced_into')==previous['id']:
                    continue
                member.update(state='completed',outcome='coalesced; not reviewed',
                    coalesced_into=previous['id'],completed_at=member.get('completed_at',mq_stamp()))
                self.save(member)

    def enqueue(self, repository, iid, *, source_key, kind, head, source, context,
                prepared=None, reviewers=None):
        if kind not in {'code', 'discussion', 'human', 'intake', 'presentation'}:
            raise RuntimeError('invalid queue job kind')
        with self.atomic():
            if self.config.get('_config_path'):
                mq_admit(self.config,repository)
            existing = self.db.execute('SELECT * FROM jobs WHERE source_key=?', (source_key,)).fetchone()
            if existing:
                saved = self.decode(existing)
                original = self.admission(saved)
                if ((saved['repository_id'],saved['iid'],original['kind'],original['source']) !=
                        (repository,iid,kind,source) or source.get('origin')=='automatic'
                        and kind in {'code','discussion'} and original['head']!=head):
                    raise RuntimeError('repeated source identity changed')
                return saved
            job = {'id': monitor_id(), 'epoch': self.epoch, 'repository_id': repository, 'iid': iid,
                'kind': kind, 'repository_path':next((p['path'] for p in self.config.get('projects',[]) if p['id']==repository),self.config.get('project_path')), 'head': head, 'source': source, 'context': context,
                'state': 'pending', 'created_at': mq_stamp(), 'wait_reason': None, 'retry_at': 0,
                'reviewers': mq_reviewers(reviewers or self.config['reviewers']),
                'stages': [], 'batch': None, 'prepared': prepared, 'outcome': None}
            cursor = self.db.execute('INSERT INTO jobs(id,source_key,repository,iid,state,value) VALUES(?,?,?,?,?,?)',
                (job['id'], source_key, repository, iid, 'pending', json.dumps(job, ensure_ascii=False)))
            job['sequence'] = cursor.lastrowid
            self.save(job)
            self._coalesce({repository})
            return self.job(job['id'])

    def reserve(self, allowed_repositories, now=None):
        now = mq_stamp() if now is None else now
        with self.atomic():
            self._coalesce(allowed_repositories)
            active = self.jobs('running')
            if active:
                return active[0]
            for job in self.jobs('pending'):
                if job['repository_id'] not in allowed_repositories or job['retry_at'] > now:
                    continue
                if job['wait_reason'] in {'human', 'effect_unknown', 'creation_unknown', 'native_unknown'}:
                    continue
                record = self.mr(job['repository_id'], job['iid'])
                if record.get('hold') and not (record['hold']['job_id'] == job['id']
                        and job['wait_reason'] == 'answer_ready' and record.get('pending_answers')) and not (
                        job['kind']=='intake' and job['wait_reason']!='held_request'):
                    continue
                blockers = [j for j in self.jobs('pending') if j['id'] != job['id']
                    and j['repository_id'] == job['repository_id'] and j['iid'] == job['iid']
                    and j['wait_reason'] in {'human','effect_unknown','creation_unknown','native_unknown'}]
                if blockers and not (job['kind']=='intake' and record.get('hold')
                                     and all(j['wait_reason']=='human' for j in blockers)):
                    continue
                job.update(state='running', resumed_from=job['wait_reason'], wait_reason=None,coalescing_frozen=True)
                self.save(job)
                return job
        return None

    def check_running(self, job):
        saved = self.job(job['id'])
        if (saved != job or job['state'] != 'running' or job['epoch'] != self.epoch):
            raise RuntimeError('stale or mismatched running job')

    def stage_start(self, job, reviewer, text, *, session=None):
        with self.atomic():
            self.check_running(job)
            if any(s['state'] == 'running' for s in job['stages']):
                raise RuntimeError('previous reviewer execution is not terminal')
            expected = job['reviewers'][len(job['stages']):]
            if not expected or reviewer != expected[0]:
                raise RuntimeError('reviewer order changed')
            stage = {'id': monitor_id(), 'reviewer': reviewer, 'state': 'running',
                'started_at':mq_stamp(), 'input': text, 'session': session, 'source_id': None, 'turn_id': None,
                'result': None, 'error': None, 'delivery': 'prepared'}
            job['stages'].append(stage)
            self.save(job)
            return stage

    def stage_end(self, job, stage_id, *, result=None, error=None, terminal=False):
        with self.atomic():
            self.check_running(job)
            stage = job['stages'][-1]
            if stage['id'] != stage_id or stage['state'] != 'running' or not terminal:
                raise RuntimeError('reviewer terminal identity is unproven')
            if (result is None) == (error is None):
                raise RuntimeError('stage requires exactly one result or failure')
            stage.update(state='succeeded' if result is not None else 'failed', result=result, error=error)
            self.save(job)

    def next_reviewer(self, job):
        if any(s['state'] == 'running' for s in job['stages']):
            return None
        index = len(job['stages'])
        return job['reviewers'][index] if index < len(job['reviewers']) else None

    def review_result(self, job):
        if self.next_reviewer(job) is not None or any(s['state'] == 'running' for s in job['stages']):
            raise RuntimeError('every enabled reviewer must run before settlement')
        successful = [s for s in job['stages'] if s['state'] == 'succeeded'
                      and s['result'].get('outcome') == 'complete']
        if not successful:
            return None
        return successful[-1]['result']

    def park(self, job, reason, *, retry_at=0):
        with self.atomic():
            self.check_running(job)
            if any(s['state'] == 'running' for s in job['stages']):
                raise RuntimeError('cannot release capacity while native execution is unknown')
            job.update(state='pending', wait_reason=reason, retry_at=retry_at)
            self.save(job)

    def finish(self, job, outcome, *, reviewed=False):
        with self.atomic():
            self.check_running(job)
            if any(s['state'] == 'running' for s in job['stages']):
                raise RuntimeError('native execution must terminate before completion')
            if any(e.get('job_id') == job['id'] and e['state'] not in {'confirmed','cancelled'} for e in self.effects()):
                raise RuntimeError('uncertain effects prohibit completion')
            if reviewed:
                result = self.review_result(job)
                if (job['kind'] != 'code' or result is None or result['head'] != job['head']
                        or self.mr(job['repository_id'],job['iid']).get('hold')):
                    raise RuntimeError('only actual completed code review advances checkpoint')
                if job.get('coalesced_jobs') and not any(
                        self.admission(member)['kind']=='code' and self.admission(member)['head']==job['head']
                        and self.admission(member)['source'].get('origin')=='automatic'
                        for member in [job,*[self.job(i) for i in job['coalesced_jobs']]]):
                    raise RuntimeError('only actual admitted code provenance advances checkpoint')
                record = self.mr(job['repository_id'], job['iid'])
                record['reviewed_head'] = job['head']
                self.put_mr(record)
            job.update(state='completed', outcome=outcome, completed_at=mq_stamp())
            self.save(job)

    def effect(self, key):
        row = self.db.execute('SELECT value FROM effects WHERE key=?', (key,)).fetchone()
        return json.loads(row['value']) if row else None

    def effects(self):
        return [json.loads(r['value']) for r in self.db.execute('SELECT value FROM effects ORDER BY key')]

    def put_effect(self, effect):
        saved = self.effect(effect['key'])
        if saved and any(saved.get(k) != effect.get(k) for k in
                         ('key', 'repository_id', 'iid', 'head', 'body', 'kind', 'target_discussion', 'position')):
            raise RuntimeError('immutable public effect identity changed')
        if saved and saved.get('discussion') != effect.get('discussion') and not (
                saved['kind']=='finding' and saved.get('discussion') is None and effect['state']=='confirmed'
                and isinstance(effect.get('discussion'),str) and effect.get('note_id')):
            raise RuntimeError('public effect receipt discussion changed')
        self.db.execute('INSERT INTO effects VALUES(?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',
            (effect['key'], effect['repository_id'], effect['iid'], json.dumps(effect, ensure_ascii=False)))

MONITOR_TOML_OPTIONS = MONITOR_TOML_OPTIONS | {"reviewers", "claude_model", "claude_effort", "review_timeout_seconds"}

def mq_config(path, *, diagnostic=False):
    # Read existing configuration, not predecessor state or historical chat maps.
    monitor_private(path)
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
        encoded = stream.read(1024*1024+1)
    if len(encoded)>1024*1024:
        raise RuntimeError('monitor configuration exceeds 1 MiB')
    raw = json.loads(encoded)
    if isinstance(raw.get('codex_project_binding'), dict):
        raw['codex_project_binding'] = {**raw['codex_project_binding'], 'existing_threads': {}}
    config = monitor_config_data(path, raw, diagnostic=diagnostic, saved_project=True)
    monitor_trusted_control_path(path,Path(config['state_file']).parent,private=True,diagnostic=diagnostic)
    config['reviewers'] = mq_reviewers(config.get('reviewers', ['claude', 'codex']))
    if config['parallel'] != 1:
        raise RuntimeError('this consumer supports parallel = 1')
    legacy = Path(config['state_file'])
    default = legacy.parent.with_name(legacy.parent.name + '-queue') / 'queue.sqlite3'
    config['queue_file'] = str(Path(config.get('queue_file', default)).expanduser().resolve())
    queue_path = Path(config['queue_file'])
    if queue_path.is_relative_to(legacy.parent) or queue_path.is_relative_to(Path(config['codex_home'])):
        raise RuntimeError('fresh queue must be outside predecessor/agent-writable and native state')
    config['claude_home'] = str(Path(config.get('claude_home', '~/.claude')).expanduser().resolve())
    config.setdefault('claude_model','claude-opus-5-5')
    config.setdefault('review_timeout_seconds',1800)
    if type(config['review_timeout_seconds']) is not int or config['review_timeout_seconds'] < 1:
        raise RuntimeError('review_timeout_seconds must be a positive integer')
    config['claude_bin'] = config.get('claude_bin', str(Path.home()/'.local/bin/claude') if (Path.home()/'.local/bin/claude').is_file() else 'claude')
    for name in ('claude_model', 'claude_effort'):
        if name in config and (not isinstance(config[name], str) or not config[name].strip()):
            raise RuntimeError('invalid ' + name)
    if config.get('claude_effort') not in {None,'low','medium','high','xhigh','max'}:
        raise RuntimeError('unsupported claude_effort; expected low/medium/high/xhigh/max')
    return config


def mq_repositories(config):
    return config.get('projects', [{'id': config['project_id'], 'path': config['project_path']}])


def mq_repository(config, repository):
    selected = next((p for p in mq_repositories(config) if p['id'] == repository), None)
    if selected is None:
        raise RuntimeError('repository is no longer enabled')
    return {**config, '_project_id': repository, 'project_id': repository, 'project_path': selected['path']}


def mq_admit(config, repository):
    current = mq_config(Path(config['_config_path']))
    fresh = mq_repository(current, repository)
    original = mq_repository(config, repository)
    keys = ('gitlab_url', 'project_path', 'queue_file', 'codex_home', 'codex_project_name')
    identity = lambda c: {k:c.get('codex_project_binding',{}).get(k) for k in ('id','name')}
    if (any(fresh.get(k) != original.get(k) for k in keys)
            or identity(fresh) != identity(original)
            or not fresh.get('codex_project_name') and fresh['cwd'] != original['cwd']):
        raise RuntimeError('current repository or queue identity changed')
    return fresh


def mq_pages(api, route):
    result = []
    for items, final in api.pages(route):
        result.extend(items)
    return result


def mq_context(config, iid, *, with_diff=True):
    api = MonitorGitLab(config,guard=config.get('_io_guard'))
    api.project()
    mr = api.mr(iid)
    actor = api.get('/user')
    if type(actor.get('id')) is not int or actor['id'] < 1:
        raise RuntimeError('invalid authenticated publishing actor')
    route = f"/projects/{config['project_id']}/merge_requests/{iid}"
    threads = mq_pages(api, route + '/discussions')
    if sum(len(t.get('notes', [])) for t in threads) > config['max_notes_per_mr']:
        raise MonitorDeferred('discussion note cap')
    for thread in threads:
        if not isinstance(thread.get('id'), str) or not isinstance(thread.get('notes'), list):
            raise RuntimeError('invalid discussion identity')
        monitor_thread_snapshot(thread)
        for note in thread['notes']:
            note['revision'] = monitor_digest(note['body'])
    context = {'repository_id': config['project_id'], 'iid': iid, 'head': mr['sha'],
        'mr': mr, 'threads': threads, 'actor_id': actor['id']}
    if with_diff:
        authors = {n['author']['id'] for t in threads for n in t['notes'] if not n.get('system')}
        if len(authors) > 256:
            raise MonitorDeferred('author metadata cap')
        context['authors'] = {}
        for actor_id in sorted(authors):
            author = api.get('/users/' + str(actor_id))
            if author.get('id') != actor_id:
                raise RuntimeError('discussion author metadata mismatch')
            context['authors'][str(actor_id)] = author
        versions = mq_pages(api, route + '/versions')
        version = next((v for v in versions if v.get('head_commit_sha') == mr['sha']), None)
        if version is None:
            raise RuntimeError('current head has no authenticated diff version')
        diff = api.get(route + '/versions/' + str(version['id']))
        if diff.get('head_commit_sha') != mr['sha'] or not isinstance(diff.get('diffs'), list):
            raise RuntimeError('diff version does not match current head')
        if any(d.get('too_large') or d.get('collapsed') for d in diff['diffs']):
            raise MonitorDeferred('current diff is incomplete')
        context['diff'] = diff
    return context


def mq_fingerprint(context):
    return monitor_digest({'head': context['head'], 'diff_refs':context['mr'].get('diff_refs'),
        'description':context['mr'].get('description'), 'target_branch':context['mr'].get('target_branch'), 'threads': [{'snapshot':monitor_thread_snapshot(t), 'positions':[n.get('position') for n in t['notes']]}
        for t in sorted(context['threads'], key=lambda item: item['id'])]})


def mq_instructions():
    return '''You review a GitLab MR for a local monitor. Read the repository AGENTS.md before
project commands. The monitor alone publishes on GitLab. Never publish, resolve, invoke other
agents, call legacy monitor controls, or write monitor/native state or the immutable input.
The registered input supplies repository/MR/head, exact discussions/diff, original human source,
prior reviewer findings, workspace folders and confirmed receipts.
Review that exact head. The input read_command is a read-only snapshot CLI: append --file PATH
--ref SHA to read exact repository files when needed. For admitted review work, choose the correct
repository from the supplied workspace; you may edit files, change branches, execute commands,
experiment and run tests there and use its shared Git metadata. Preserve pre-existing user work;
do not reset, clean, stash, create worktrees or commit unless explicitly requested. Verify the
actual repository and target SHA before claiming local tests cover this MR. Report commands,
results and any coverage limitation honestly. The monitor does not choose checkouts or tests.
For kind intake and direct human messages without a registered queued review, remain read-only:
classify the input and return its domain assessment; wait for the monitor to admit work. Questions
and held work never authorize local mutation. Do not work around a permission denial.
Report actionable defects inline when possible; consider every existing
concern and response, avoid duplicate findings, and explain fixes or evidenced bot false positives.
For human input, first classify its exact text and bounded effects/discussions. Questions,
explanations, preferences, mixed/automatic input, any text containing ? or ending in w authorize
no mutation. A sufficient human answer must explicitly reference the existing question anchor;
never clear another question or broaden the original scope. An interrupted intake only interprets
its supplied original source; its automatic continuation never supplies human authorization.
Ask a readable Portuguese question when a human decision is needed. Keep its scope unresolved.
Return a final fenced JSON block labelled csm-review with this versioned domain result:
{"version":1,"repository_id":123,"iid":1,"head":"exact SHA","outcome":"complete",
"question":null,"assessment":null,"actions":[],"concerns":[],"dispositions":[]}
Use outcome question for a pending decision, or noop for explanatory input. Question results have
no actions. For a continuation, text_basis includes the original source and each genuine answer text in order.
For human work assessment is {"kind":"action|answer|explanation","text_basis":["exact
original text"],"summary":"request","scope":{"effects":["finding|reply|resolve"],"discussions":[]},
"question_anchor":null}. Never invent administrative IDs, authorization, or receipts.
Each action has a stable semantic key, kind finding/reply/resolve, body in Portuguese, discussion
ID for replies/resolutions, and exact authenticated position for findings. Resolution also needs
basis verified_fix/bot_false_positive and complete assessment of every non-system note (its ID,
body revision, concerns with fixed/invalid disposition and evidence, or no_concern_reason). A fix
names the actual fix_commit. Human disagreement alone cannot close a discussion. The monitor
first publishes/confirms the explanation and rechecks the full context before resolving.
Each concern has key, discussion (nullable), disposition open/fixed/invalid, and evidence. Dispose
of every earlier concern by key as retained/duplicate/rejected/uncertain with evidence; duplicates
name the retained key. Carry unresolved concerns forward; a remaining concern vetoes resolution.
Do not claim an effect was published. End with a brief Portuguese report of the proposed outcome.
'''


def mq_parse_result(text, repository, iid, head):
    matches = re.findall(r'```csm-review\s*\n(.*?)\n```', text, re.S)
    if len(matches) != 1:
        raise RuntimeError('expected exactly one csm-review final result')
    result = json.loads(matches[0])
    required = {'version','repository_id','iid','head','outcome','question','assessment','actions','concerns','dispositions'}
    if (not isinstance(result, dict) or set(result) != required or type(result['version']) is not int or result['version'] != 1
            or type(result['repository_id']) is not int or result['repository_id'] != repository
            or type(result['iid']) is not int or result['iid'] != iid or result['head'] != head
            or result['outcome'] not in {'complete','question','noop'}):
        raise RuntimeError('invalid result identity, head or version')
    for key in ('actions','concerns','dispositions'):
        if not isinstance(result[key], list) or len(result[key]) > 100:
            raise RuntimeError('invalid result '+key)
    if result['outcome'] == 'question':
        outside = re.sub(r'```csm-review\s*\n.*?\n```', '', text, flags=re.S)
        if (not isinstance(result['question'], str) or not result['question'].strip() or result['actions']
                or result['question'] not in outside):
            raise RuntimeError('question requires readable text and no public effects')
    elif result['question'] is not None:
        raise RuntimeError('unexpected result question')
    if result['outcome'] == 'noop' and result['actions']:
        raise RuntimeError('explanation cannot propose public effects')
    keys = set()
    for action in result['actions']:
        key = action.get('key') if isinstance(action, dict) else None
        if (not isinstance(key, str) or not re.fullmatch(r'[A-Za-z0-9_.:-]{1,160}', key)
                or key in keys or action.get('kind') not in {'finding','reply','resolve'}
                or not isinstance(action.get('body'), str) or not 1 <= len(action['body'].strip()) <= 16000
                or '<!-- csmq:' in action['body'] or '<!-- codex-stats-op:' in action['body']):
            raise RuntimeError('invalid or duplicate domain action')
        keys.add(key)
        if action['kind'] in {'reply','resolve'} and not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', str(action.get('discussion',''))):
            raise RuntimeError('reply/resolution requires a discussion identity')
    for key in ('concerns','dispositions'):
        seen = set()
        for value in result[key]:
            if (not isinstance(value, dict) or not isinstance(value.get('key'), str)
                    or value['key'] in seen or not value.get('evidence')):
                raise RuntimeError('invalid or duplicate concern disposition')
            seen.add(value['key'])
            allowed = {'open','fixed','invalid'} if key == 'concerns' else {'retained','duplicate','rejected','uncertain'}
            if value.get('disposition') not in allowed:
                raise RuntimeError('invalid concern disposition')
    return result


def mq_consolidation(job, result):
    chosen = next((i for i in range(len(job['stages'])-1, -1, -1) if job['stages'][i]['state']=='succeeded' and job['stages'][i]['result'].get('outcome')=='complete'), None)
    if chosen is None or job['stages'][chosen]['result'] != result:
        raise RuntimeError('consolidation result is not the last successful reviewer')
    earlier = {c['key']: c for stage in job['stages'][:chosen]
        for c in (stage.get('result') or {}).get('concerns', [])}
    dispositions = {d['key']: d for d in result['dispositions']}
    if not set(earlier) <= set(dispositions):
        raise RuntimeError('consolidation omitted earlier concerns')
    retained = {c['key']: c for c in result['concerns']}
    for key in earlier:
        disposition = dispositions[key]
        if disposition['disposition'] == 'uncertain':
            raise RuntimeError('unresolved reviewer disagreement requires a human decision')
        if disposition['disposition'] == 'retained' and key not in retained:
            raise RuntimeError('retained concern is missing')
        if disposition['disposition'] == 'duplicate' and disposition.get('retained_key') not in retained:
            raise RuntimeError('duplicate concern lacks its retained identity')
    open_threads = {c.get('discussion') for c in result['concerns'] if c['disposition'] == 'open'}
    if any(a['kind'] == 'resolve' and a['discussion'] in open_threads for a in result['actions']):
        raise RuntimeError('an outstanding concern vetoes resolution')


def mq_human_assessment(result, source, hold=None):
    texts = source.get('texts')
    if (source.get('origin') != 'human' or not isinstance(texts, list) or not texts
            or any(not isinstance(t, str) for t in texts)
            or '?' in '\n'.join(texts) or '\n'.join(texts).rstrip().endswith('w')
            or source.get('mixed') or source.get('automated')):
        raise RuntimeError('input grants no mutable human authorization')
    assessment = result.get('assessment')
    if (not isinstance(assessment, dict) or assessment.get('text_basis') != texts
            or assessment.get('kind') not in {'action','answer'}
            or not isinstance(assessment.get('summary'), str) or not assessment['summary'].strip()):
        raise RuntimeError('explicit semantic action or sufficient-answer assessment required')
    scope = assessment.get('scope')
    if (not isinstance(scope, dict) or set(scope) != {'effects','discussions'}
            or not isinstance(scope['effects'], list) or not scope['effects'] or len(scope['effects'])>3
            or any(not isinstance(k,str) or k not in {'finding','reply','resolve'} for k in scope['effects'])
            or len(set(scope['effects'])) != len(scope['effects'])
            or not isinstance(scope['discussions'], list)
            or any(not isinstance(d, str) for d in scope['discussions'])
            or ({'reply','resolve'} & set(scope['effects']) and not scope['discussions'])):
        raise RuntimeError('human action requires bounded effect/discussion scope')
    if hold:
        if assessment['kind'] != 'answer' or assessment.get('question_anchor') != hold['anchor']:
            raise RuntimeError('active question requires its exact sufficient-answer assessment')
        original = hold['scope']
        if not set(scope['effects']) <= set(original['effects']) or not set(scope['discussions']) <= set(original['discussions']):
            raise RuntimeError('answer cannot broaden the held request')
    elif assessment['kind'] != 'action':
        raise RuntimeError('answer has no active question')
    for action in result['actions']:
        if (action['kind'] not in scope['effects'] or action['kind'] in {'reply','resolve'}
                and action['discussion'] not in scope['discussions']):
            raise RuntimeError('proposed effect exceeds human scope')
    return scope


def mq_git_metadata(roots,*,config=None):
    import subprocess
    environment = {k:v for k,v in os.environ.items() if not k.startswith('GIT_')}
    environment['LC_ALL'] = 'C'
    result = []
    for root in roots:
        timeout = min(15,mq_io_timeout(config,'native_timeout')) if config else 15
        try:
            probe = subprocess.run(['git','-C',root,'rev-parse','--path-format=absolute',
                '--git-dir','--git-common-dir'],capture_output=True,text=True,env=environment,timeout=timeout)
        except subprocess.TimeoutExpired as failure:
            if config and mq_expired(config):
                raise MonitorCycleYield('cycle ended reading Git metadata') from failure
            raise RuntimeError('workspace Git metadata probe timed out') from failure
        if probe.returncode:
            if 'not a git repository' in probe.stderr:
                continue
            raise RuntimeError('cannot read workspace Git metadata: '+probe.stderr.strip())
        for path in probe.stdout.splitlines():
            canonical = str(Path(path).resolve())
            if canonical not in result:
                result.append(canonical)
    return result


def mq_workspace(config, queue, job):
    if job.get('workspace') is None:
        project = None
        if config.get('codex_project_name'):
            project = monitor_resolve_project(config,config['codex_project_name'])
            if project['id'] != config['codex_project_binding']['id']:
                raise RuntimeError('configured native project identity changed')
        roots = project['roots'] if project else [config['cwd']]
        snapshot = {'project_id':project['id'] if project else None,
            'project_name':project['name'] if project else None,'cwd':roots[0],
            'roots':roots,'git_metadata':mq_git_metadata(roots,config=config)}
        with queue.atomic():
            queue.check_running(job)
            job['workspace'] = snapshot
            queue.save(job)
    return mq_workspace_config(config,job)


def mq_workspace_config(config, job):
    snapshot = job['workspace']
    scoped = {**config,'cwd':snapshot['cwd'],'_workspace':snapshot,
              '_workspace_write':job['kind'] != 'intake'}
    if snapshot['project_id'] is not None:
        scoped['codex_project_binding'] = {**config['codex_project_binding'],
            'roots':snapshot['roots'],'existing_threads':{}}
    return scoped


def mq_codex_context(record, session):
    context = record.get('codex_contexts',{}).get(session)
    if context is None and session == record['chats'].get('codex'):
        context = record.get('codex_context')
    if context is None:
        raise RuntimeError('Codex source has no registered original context')
    return context


def mq_owned_sessions(record):
    return set(record['chats'].values()) | set(record.get('claude_history',[])) | set(record.get('codex_contexts',{}))


def mq_verify_codex_context(config, record, native, session):
    expected = mq_codex_context(record,session)
    if (native.get('id') != session or native.get('cwd') != expected['cwd']
            or native.get('projectId') != expected['project_id']):
        raise RuntimeError('human source workspace/project changed')
    if expected['project_id'] is not None and monitor_thread_source_roots(config,native) != expected['roots']:
        raise RuntimeError('native conversation project/workspace context mismatch')


def mq_input(queue, job, stage, context):
    directory = queue.path.parent / 'inputs'
    directory.mkdir(mode=0o700, exist_ok=True)
    monitor_private(directory, directory=True)
    target = directory / (stage['id'] + '.json')
    import shlex
    read_command = shlex.join([str(Path(__file__).resolve()),'monitor-gitlab','--config',
        str(queue.config['_config_path']),'snapshot','--project',str(job['repository_id']),
        '--mr',str(job['iid'])])
    data = {'read_command':read_command, 'reviewer': stage['reviewer'], 'kind': job['kind'], 'context': context,
        'workspace':job['workspace'],
        'original_source': queue.admission(queue.job(job.get('target_event',job['id'])))['source'],
        'answers':job.get('answers',[]),
        'previous_rounds':job.get('rounds',[])[-1:], 'validation_error':job.get('validation_error'),
        'question_history':queue.mr(job['repository_id'],job['iid']).get('hold_history',[]), 'prior_stages': job['stages'][:-1],
        'hold': queue.mr(job['repository_id'], job['iid']).get('hold'),
        'confirmed_receipts': [e for e in queue.effects() if e['repository_id'] == job['repository_id']
                              and e['iid'] == job['iid'] and e['state'] == 'confirmed']}
    encoded = json.dumps(data, ensure_ascii=False, indent=2).encode()
    if target.exists():
        if target.read_bytes() != encoded:
            raise RuntimeError('immutable reviewer input changed')
    else:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), 'wb') as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
    return ('Registered automatic GitLab MR review. Read the complete immutable input file '
        + str(target) + ' (SHA-256 ' + hashlib.sha256(encoded).hexdigest() + '). '
        'It contains the exact original source, head, discussions, diff, previous findings and receipts. '
        'Use its workspace for review commands and tests; kind intake remains read-only. '
        'Return the shared csm-review domain result. The monitor alone publishes. '
        'Use only the configured reviewer; do not delegate. Dispatch marker: ' + stage['id'] + '.')


def mq_update_stage(queue, job, stage_id, **changes):
    with queue.atomic():
        queue.check_running(job)
        stage = job['stages'][-1]
        if stage['id'] != stage_id or stage['state'] != 'running':
            raise RuntimeError('native acknowledgment belongs to a stale reviewer')
        stage.update(changes)
        queue.save(job)


def mq_codex_create(config, queue, job):
    record = queue.mr(job['repository_id'], job['iid'])
    snapshot = config['_workspace']
    wanted = {'cwd':snapshot['cwd'],'roots':snapshot['roots'],'project_id':snapshot['project_id']}
    previous = record['chats'].get('codex')
    if (previous and mq_codex_context(record,previous) == wanted
            and record.get('codex_instructions_version') == MQ_INSTRUCTIONS_VERSION):
        identifier = record['chats']['codex']
        if not record.get('codex_assigned'):
            monitor_native(config,'thread/name/set',{'threadId':identifier,
                'name':config['project_path'].split('/')[-1]+f" !{job['iid']} — Revisão automática"})
            if config.get('codex_project_name'):
                monitor_assign_app_project(config,identifier)
            with queue.atomic():
                record['codex_assigned'] = True
                queue.put_mr(record)
        return identifier
    selection = mq_native_selection(config,assignment=True)
    selection['config']['model_reasoning_effort'] = config['effort']
    # The consumer supplies authenticated context and owns writes via the existing credential.
    selection['config'][f"mcp_servers.{config['credential_mcp_server']}.enabled"] = False
    context = ({'projectId': config['codex_project_binding']['id'],
                'runtimeWorkspaceRoots': config['codex_project_binding']['roots']}
               if config.get('codex_project_name') else {})
    response = monitor_native(config, 'thread/start', {'cwd': config['cwd'], 'model': config['model'],
        'approvalPolicy':'never', 'threadSource': 'cli', 'ephemeral': False, 'serviceName': 'codex_stats_gitlab_monitor',
        'developerInstructions': mq_instructions(), **context, **selection})
    thread = response['thread']
    identifier = thread['id']
    if (not isinstance(identifier, str) or not re.fullmatch(r'[a-f0-9-]{36}', identifier)
            or thread.get('cwd') != config['cwd']):
        raise RuntimeError('new native chat identity mismatch')
    mq_verify_permission_selection(response)
    if config.get('codex_project_name'):
        if thread.get('projectId') != config['codex_project_binding']['id']:
            raise RuntimeError('new native chat project mismatch')
    if any(identifier in mq_owned_sessions(r) for r in queue.mrs()):
        raise RuntimeError('new native chat is already owned by another MR')
    # Save the acknowledged ID before app assignment; a failure never creates another chat.
    with queue.atomic():
        queue.check_running(job)
        record = queue.mr(job['repository_id'], job['iid'])
        if record['chats'].get('codex') != previous:
            raise RuntimeError('new native chat mapping changed')
        if previous:
            record.setdefault('codex_contexts',{})[previous] = mq_codex_context(record,previous)
        record['chats']['codex'] = identifier
        record['codex_context'] = wanted
        record.setdefault('codex_contexts',{})[identifier] = wanted
        record['codex_instructions_version'] = MQ_INSTRUCTIONS_VERSION
        record['codex_assigned'] = False
        queue.put_mr(record)
    monitor_native(config, 'thread/name/set', {'threadId': identifier,
        'name': config['project_path'].split('/')[-1] + f" !{job['iid']} — Revisão automática"})
    if config.get('codex_project_name'):
        monitor_assign_app_project(config, identifier)
    with queue.atomic():
        record = queue.mr(job['repository_id'], job['iid'])
        record['codex_assigned'] = True
        queue.put_mr(record)
    return identifier


def mq_codex_dispatch(config, queue, job, stage):
    session = mq_codex_create(config, queue, job)
    selection = mq_native_selection(config)
    response = monitor_native(config, 'thread/resume', {'threadId': session, 'excludeTurns': True,
        'runtimeWorkspaceRoots':config['_workspace']['roots'],'approvalPolicy':'never', **selection})
    mq_verify_permission_selection(response)
    thread = response['thread']
    if thread['status']['type'] != 'idle':
        raise RuntimeError('mapped Codex chat is not idle; no model input sent')
    mq_verify_codex_context(config,queue.mr(job['repository_id'],job['iid']),thread,session)
    mq_update_stage(queue, job, stage['id'], session=session, delivery='sending',
        review_deadline=mq_stamp()+config['review_timeout_seconds'])
    try:
        started = monitor_native(config, 'turn/start', {'threadId': session,
            'clientUserMessageId': stage['id'], 'input': [{'type':'text','text':stage['input']}],
            'approvalPolicy':'never', 'model': config['model'], 'effort': config['effort'], 'permissions': MQ_PERMISSION_PROFILE})
    except MonitorCycleYield as yielded:
        if not yielded.issued:
            mq_update_stage(queue,job,stage['id'],delivery='prepared')
        raise
    mq_update_stage(queue, job, stage['id'], turn_id=started['turn']['id'], delivery='accepted')


def mq_codex_items(config, session, turn):
    items, cursor = [], None
    for _ in range(config['max_history_pages']):
        params = {'threadId':session,'turnId':turn,'limit':100,'sortDirection':'asc'}
        if cursor is not None:
            params['cursor'] = cursor
        page = monitor_native(config, 'thread/items/list', params)
        if (not isinstance(page.get('data'), list) or 'nextCursor' not in page
                or page['nextCursor'] is not None and not isinstance(page['nextCursor'], str)
                or any(not isinstance(v, dict) or v.get('turnId') != turn
                       or not isinstance(v.get('item'), dict) for v in page['data'])):
            raise RuntimeError('incomplete native item page')
        items.extend(row['item'] for row in page['data'])
        cursor = page['nextCursor']
        if cursor is None:
            return items
    raise RuntimeError('native item page limit')


def mq_codex_observe(config, stage):
    turns = monitor_turns(config, stage['session'],stop_ids=[stage['turn_id']] if stage.get('turn_id') else [])
    matches = []
    for turn in turns:
        if stage.get('turn_id') and turn['id'] != stage['turn_id']:
            continue
        items = mq_codex_items(config, stage['session'], turn['id'])
        inputs = [i for i in items if i.get('type') == 'userMessage']
        texts = [c.get('text') for i in inputs for c in i.get('content', []) if c.get('type') == 'text']
        mixed = any(mq_texts(i.get('content'))[1] for i in inputs) or mq_automatic_items(items)
        if texts == [stage['input']] and len(inputs) == 1 and not mixed:
            if inputs[0].get('clientId') not in {None, stage['id']}:
                raise RuntimeError('native dispatch client identity changed')
            matches.append((turn, items))
        elif stage.get('turn_id'):
            if turn['status']=='inProgress':
                return {'terminal':False,'turn_id':turn['id']}
            return {'terminal':True,'error':{'message':'registered native input changed or became mixed'},'turn_id':turn['id']}
    if len(matches) > 1:
        raise RuntimeError('duplicate native dispatch identity')
    if not matches:
        return {'terminal':False,'unknown':True}
    turn, items = matches[0]
    if turn['status'] == 'inProgress':
        return {'terminal':False,'turn_id':turn['id']}
    if turn['status'] not in {'completed','failed','interrupted'}:
        raise RuntimeError('unknown native turn status')
    if turn['status'] != 'completed':
        return {'terminal':True,'error':{'message':turn.get('error') or turn['status']},'turn_id':turn['id']}
    finals = [i for i in items if i.get('type') == 'agentMessage' and i.get('phase') == 'final_answer']
    if len(finals) != 1:
        return {'terminal':True,'error':{'message':'missing or ambiguous final result'},'turn_id':turn['id']}
    return {'terminal':True,'text':finals[0]['text'],'anchor':finals[0]['id'],'turn_id':turn['id']}


def mq_claude_environment(config):
    environment = dict(os.environ)
    if Path(config['claude_home']).resolve() == (Path.home()/'.claude').resolve():
        # Setting even the default directory changes Claude's preferences-file selection.
        environment.pop('CLAUDE_CONFIG_DIR', None)
    else:
        environment['CLAUDE_CONFIG_DIR'] = config['claude_home']
    return environment


def mq_claude_command(config, arguments):
    import subprocess
    import tempfile
    operation = 'launch' if arguments[0] == '--bg' else arguments[0]
    timeout = mq_io_timeout(config,'native_timeout')
    with tempfile.TemporaryFile(mode='w+') as output, tempfile.TemporaryFile(mode='w+') as errors:
        try:
            completed = subprocess.run([config['claude_bin'], *arguments], cwd=config['cwd'],
                env=mq_claude_environment(config), stdin=subprocess.DEVNULL, stdout=output,
                stderr=errors, text=True, timeout=timeout)
        except OSError as failure:
            raise MonitorClaudeError(operation,str(failure),not_started=operation=='launch') from failure
        except subprocess.TimeoutExpired as failure:
            if mq_expired(config):
                raise MonitorCycleYield('cycle ended during Claude command',issued=operation in {'launch','stop'}) from failure
            raise MonitorClaudeError(operation,'command timed out; reconcile native execution') from failure
        output.seek(0); errors.seek(0)
        stdout, stderr = output.read(), errors.read()
    if completed.returncode:
        message = (stderr.strip() or stdout.strip())[:2000]
        rejection = f"Workspace not trusted. Run `claude` in {config['cwd']} once and accept the trust prompt, then retry."
        raise MonitorClaudeError(operation,message,returncode=completed.returncode,
            not_started=operation=='launch' and completed.returncode==1 and message==rejection)
    return stdout

def mq_claude_preflight(config):
    auth = json.loads(mq_claude_command(config,['auth','status','--json']))
    if not auth.get('loggedIn'):
        raise RuntimeError('Claude is not authenticated; use claude auth login')
    environment = mq_claude_environment(config)
    preferences = (Path(environment['CLAUDE_CONFIG_DIR'])/'.claude.json' if environment.get('CLAUDE_CONFIG_DIR')
                   else Path.home()/'.claude.json')
    saved = json.loads(preferences.read_text()) if preferences.is_file() else {}
    if not saved.get('projects',{}).get(config['cwd'],{}).get('hasTrustDialogAccepted'):
        raise RuntimeError('Claude workspace is not trusted in '+str(preferences)+'; open claude in '+config['cwd'])
    mq_claude_agents(config)


def mq_claude_agents(config):
    data = json.loads(mq_claude_command(config, ['agents','--json','--all']))
    if not isinstance(data,list):
        raise RuntimeError('invalid Claude background inventory')
    backgrounds = []
    for item in data:
        if not isinstance(item,dict) or item.get('kind') not in {'interactive','background'}:
            raise RuntimeError('invalid Claude session kind')
        if item['kind']=='interactive':
            continue
        if any(not isinstance(item.get(k),str) or not item[k] for k in ('id','sessionId','name','cwd','state')):
            raise RuntimeError('invalid Claude background identity')
        backgrounds.append(item)
    if (len({a['id'] for a in backgrounds})!=len(backgrounds)
            or len({a['sessionId'] for a in backgrounds})!=len(backgrounds)):
        raise RuntimeError('ambiguous Claude background inventory')
    return backgrounds

def mq_claude_dispatch(config, queue, job, stage):
    name = config['project_path'].split('/')[-1] + f" !{job['iid']} — Claude · " + stage['id']
    mq_update_stage(queue, job, stage['id'], name=name, delivery='sending',
        review_deadline=mq_stamp()+config['review_timeout_seconds'])
    arguments = mq_claude_arguments(config,stage['input'],name)
    if config.get('claude_model'):
        arguments += ['--model',config['claude_model']]
    if config.get('claude_effort'):
        arguments += ['--effort',config['claude_effort']]
    try:
        mq_claude_command(config, arguments)
    except MonitorCycleYield as yielded:
        if not yielded.issued:
            mq_update_stage(queue,job,stage['id'],delivery='prepared')
        raise
    mq_claude_accept(config, queue, job, stage)


def mq_claude_accept(config, queue, job, stage):
    matches = [a for a in mq_claude_agents(config) if a['name']==stage.get('name') and a['cwd']==config['cwd']]
    if len(matches)>1:
        raise RuntimeError('ambiguous Claude native dispatch acknowledgment')
    if not matches:
        return None
    native = matches[0]
    if (stage.get('session') and stage['session']!=native['sessionId']
            or stage.get('background_id') and stage['background_id']!=native['id']):
        raise RuntimeError('Claude native identity changed')
    with queue.atomic():
        queue.check_running(job)
        if any(r['repository_id']!=job['repository_id'] or r['iid']!=job['iid'] for r in queue.mrs()
               if native['sessionId'] in mq_owned_sessions(r)):
            raise RuntimeError('Claude session already belongs to another MR')
        stage.update(session=native['sessionId'],background_id=native['id'],delivery='accepted')
        record = queue.mr(job['repository_id'],job['iid'])
        previous = record['chats'].get('claude')
        if previous and previous!=native['sessionId'] and previous not in record.get('claude_history',[]):
            record.setdefault('claude_history',[]).append(previous)
        record.setdefault('claude_contexts',{})[native['sessionId']] = config['cwd']
        record['chats']['claude'] = native['sessionId']
        queue.put_mr(record)
        queue.save(job)
    return native

def mq_legacy_claude_rejection(config,job,stage):
    """Normalize the original wrapper's saved negative acknowledgment, not missing inventory."""
    rejection = f"Workspace not trusted. Run `claude` in {config['cwd']} once and accept the trust prompt, then retry."
    name = config['project_path'].split('/')[-1]+f" !{job['iid']} — Claude · "+stage['id']
    if (stage.get('error')!={'message':'Claude CLI failed: '+rejection}
            or stage.get('name')!=name or stage.get('delivery')!='sending'
            or any(stage.get(k) for k in ('session','background_id','turn_id'))):
        return None
    import shutil
    executable = shutil.which(config['claude_bin'])
    if not executable:
        return None
    path = Path(executable)
    resolved = path.resolve(strict=True)
    # The old attempt did not save operation/version fields. Only the unchanged, natively
    # verified installed version can authenticate its launch-only trust diagnostic.
    if any(p.lstat().st_ctime>stage['started_at'] for p in (path,resolved)):
        return None
    if mq_claude_command(config,['--version']).strip()!='2.1.289 (Claude Code)':
        return None
    st = resolved.stat()
    return {'message':rejection,'operation':'launch','not_started':True,
        'evidence':{'basis':'original exact launch-only trust rejection; unchanged native executable',
            'version':'2.1.289','executable':str(resolved),'device':st.st_dev,'inode':st.st_ino,
            'ctime_ns':st.st_ctime_ns,'size':st.st_size}}


def mq_claude_records(config, session):
    if not re.fullmatch(r'[a-f0-9-]{36}', session):
        raise RuntimeError('invalid native Claude session identity')
    root = Path(config['claude_home']) / 'projects'
    paths = list(root.glob('*/' + session + '.jsonl'))
    if len(paths) != 1:
        return []
    source = paths[0].resolve()
    if not source.is_relative_to(root.resolve()):
        raise RuntimeError('native Claude transcript escapes its root')
    if source.stat().st_size > config['max_response_bytes']:
        raise RuntimeError('native Claude transcript exceeds configured bound')
    records = []
    with source.open() as stream:
        for raw in stream:
            try:
                item = json.loads(raw)
            except json.JSONDecodeError:
                if not raw.endswith('\n'):
                    break  # Native append still in progress, never evidence of completion.
                raise RuntimeError('malformed native Claude transcript')
            if not isinstance(item,dict):
                raise RuntimeError('malformed native Claude record')
            if item.get('sessionId') == session and not item.get('isSidechain'):
                if item.get('type') in {'user','assistant'} and not isinstance(item.get('message'),dict):
                    raise RuntimeError('malformed native Claude message')
                records.append(item)
    return records


def mq_claude_final(records, source):
    """Follow one native input through tool results; group split blocks of its final message."""
    chain = {source['uuid']:(set(),set())}
    finals, seals, parents, positions = {}, [], {}, {}
    for position,record in enumerate(records):
        parent = chain.get(record.get('parentUuid'))
        if record.get('uuid')==source['uuid'] or parent is None:
            continue
        pending, seen = map(set,parent)
        kind = record.get('type')
        message = record.get('message',{})
        content = message.get('content',[])
        if kind=='user':
            if (not isinstance(content,list) or not content or any(
                    not isinstance(c,dict) or c.get('type')!='tool_result' for c in content)):
                continue
            identities = [c.get('tool_use_id') for c in content]
            if (any(not isinstance(i,str) or not i for i in identities)
                    or len(set(identities))!=len(identities) or not set(identities)<=pending):
                continue
            pending.difference_update(identities)
        elif kind=='assistant':
            if not isinstance(content,list) or any(not isinstance(c,dict) for c in content):
                continue
            calls = [c.get('id') for c in content if c.get('type')=='tool_use']
            if (any(not isinstance(i,str) or not i for i in calls)
                    or len(set(calls))!=len(calls) or set(calls)&seen):
                continue
            pending.update(calls); seen.update(calls)
            if record.get('isApiErrorMessage') or message.get('stop_reason')=='end_turn':
                identity = message.get('id')
                if not isinstance(identity,str) or not identity or pending:
                    continue
                finals.setdefault(identity,[]).append(record)
        if record.get('uuid'):
            if record['uuid'] in chain:
                raise RuntimeError('duplicate Claude native record identity')
            chain[record['uuid']] = (pending,seen)
            parents[record['uuid']] = record.get('parentUuid')
            positions[record['uuid']] = position
        if kind=='system' and record.get('subtype')=='turn_duration':
            seals.append(record['uuid'])
    if len(finals)>1:
        raise RuntimeError('ambiguous Claude terminal result')
    def descends(node,ancestor):
        while node in chain:
            if node==ancestor:return True
            node=parents.get(node)
        return False
    result = {'sealed':bool(seals)}
    if finals:
        blocks = next(iter(finals.values()))
        anchor = blocks[-1]['uuid']
        if any(positions[seal]<positions[anchor] and any(descends(seal,b['uuid']) for b in blocks)
               for seal in seals):
            raise RuntimeError('Claude final has blocks after completion')
        result.update(anchor=anchor,sealed=any(descends(seal,anchor) for seal in seals))
        if any(r.get('isApiErrorMessage') for r in blocks):
            result['error'] = {'message':next((r.get('error') for r in blocks if r.get('error')),'native Claude error')}
        else:
            result['text'] = '\n'.join(c['text'] for r in blocks for c in r['message']['content']
                if c.get('type')=='text' and isinstance(c.get('text'),str))
    return result


def mq_claude_url(records, stage):
    if sum(r.get('type')=='user' and r.get('message',{}).get('content')==stage.get('input')
           for r in records)!=1:
        return None
    return next((r['url'] for r in reversed(records) if r.get('type')=='system'
        and r.get('subtype')=='bridge_status' and isinstance(r.get('url'),str)
        and re.fullmatch(r'https://claude\.ai/code/session_[A-Za-z0-9_-]+',r['url'])),None)


def mq_claude_observe(config, stage):
    matches = [a for a in mq_claude_agents(config) if a['id'] == stage.get('background_id')
               and a['sessionId'] == stage['session'] and a.get('name') == stage.get('name')
               and a.get('cwd') == config['cwd']]
    if len(matches) != 1:
        return {'terminal':False,'unknown':True}
    native = matches[0]
    records = mq_claude_records(config, stage['session'])
    url = mq_claude_url(records,stage)
    link = {'remote_url':url} if url else {}
    sources = [r for r in records if r.get('type') == 'user' and r.get('message',{}).get('content') == stage['input']]
    if len(sources) > 1:
        raise RuntimeError('duplicate Claude original source')
    ended = native.get('state') in {'failed','stopped','done'}
    if not sources:
        if ended:
            return {'terminal':True,'error':{'message':'Claude ended without its registered source'},**link}
        return {'terminal':False,**link}
    source = sources[0]
    try:
        final = mq_claude_final(records,source)
    except RuntimeError as failure:
        if ended:return {'terminal':True,'error':{'message':str(failure)},**link}
        raise
    complete = final.get('text','').strip() or final.get('error')
    if not complete or not (final['sealed'] or ended):
        if ended:
            return {'terminal':True,'error':{'message':'Claude interrupted before a final result'},**link}
        return {'terminal':False,**link}
    return {'terminal':True,'source_id':source['uuid'],**{k:v for k,v in final.items() if k!='sealed'},**link}


def mq_claude_stop(config, native):
    if native['state'] not in {'failed','stopped','done'}:
        mq_claude_command(config,['stop',native['id']])
    settled = next((a for a in mq_claude_agents(config) if a['id']==native['id']
        and all(a[k]==native[k] for k in ('sessionId','name','cwd'))),None)
    return bool(settled and settled['state'] in {'failed','stopped','done'})

def mq_verify_input(queue,stage):
    target = queue.path.parent / 'inputs' / (stage['id']+'.json')
    monitor_private(target)
    data = target.read_bytes()
    expected = re.search(r'\(SHA-256 ([a-f0-9]{64})\)',stage['input'])
    if not expected or hashlib.sha256(data).hexdigest() != expected[1]:
        raise RuntimeError('registered immutable reviewer input changed')


def mq_protected_paths(config):
    return [config['codex_home'],config['claude_home'],str(Path(config['queue_file']).parent),
            str(Path(config['state_file']).parent),config['_config_path'],str(Path(__file__).resolve())]


def mq_permission_profile(config):
    from urllib.parse import urlsplit
    filesystem = {}
    if config.get('_workspace_write'):
        for root in config['_workspace']['roots']:
            filesystem[root] = 'write'
            for name in ('.git','.agents','.codex','.aws','.claude'):
                filesystem[str(Path(root)/name)] = 'write'
        filesystem.update({p:'write' for p in config['_workspace']['git_metadata']})
    filesystem.update({p:'read' for p in mq_protected_paths(config)})
    return {'extends':':read-only','filesystem':filesystem,
        'network':{'enabled':True,'allow_local_binding':True,
            'domains':{urlsplit(config['gitlab_url']).hostname:'allow','localhost':'allow','127.0.0.1':'allow','::1':'allow'},
            'unix_sockets':{config['socket']:'deny'}}}


def mq_verify_permission_selection(response):
    if response.get('activePermissionProfile') != {'id':MQ_PERMISSION_PROFILE,'extends':':read-only'}:
        raise RuntimeError('native conversation did not select the reviewer permission profile')


def mq_native_selection(config,*,assignment=False):
    import tomllib
    selection = {'permissions':MQ_PERMISSION_PROFILE,'config':{
        'permissions.'+MQ_PERMISSION_PROFILE:mq_permission_profile(config),
        'features.network_proxy':True}}
    servers = tomllib.loads((Path(config['codex_home'])/'config.toml').read_text()).get('mcp_servers',{})
    for name in servers:
        if not re.fullmatch(r'[A-Za-z0-9_-]+',name):
            raise RuntimeError('MCP server name cannot be addressed safely by native override')
        if name != 'codex_app' or not assignment:
            selection['config']['mcp_servers.'+name+'.enabled'] = False
    selection['config'][f"mcp_servers.{config['credential_mcp_server']}.enabled"] = False
    return selection


def mq_claude_arguments(config, text, name):
    from urllib.parse import urlsplit
    workspace = config['_workspace']
    writable = config.get('_workspace_write',False)
    settings = {}
    user_settings = Path(config['claude_home'])/'settings.json'
    if user_settings.exists():
        source = json.loads(user_settings.read_text())
        settings.update({k:source[k] for k in ('model','effortLevel','alwaysThinkingEnabled') if k in source})
    protected = mq_protected_paths(config)
    settings['sandbox'] = {'enabled':True,'failIfUnavailable':True,'autoAllowBashIfSandboxed':writable,
        'allowUnsandboxedCommands':False,
        'filesystem':{'allowWrite':workspace['git_metadata'] if writable else [],
            'denyWrite':protected if writable else [*protected,*workspace['roots'],*workspace['git_metadata']]},
        'network':{'allowedDomains':[urlsplit(config['gitlab_url']).hostname,'localhost','127.0.0.1','::1'],
                   'allowLocalBinding':True}}
    allowed = ['Read','Grep','Glob']
    if writable:
        allowed.append('Bash')
        for root in [*workspace['roots'],*workspace['git_metadata']]:
            allowed.extend(['Edit(/'+root+'/**)','Write(/'+root+'/**)'])
    else:
        allowed.extend(['Bash(codex-session-stats current --client claude --format json)',
            'Bash('+str(Path(__file__).resolve())+' monitor-gitlab --config '+config['_config_path']+' snapshot *)'])
    settings['permissions'] = {'deny':[kind+'(/'+p+'/**)' for p in protected for kind in ('Edit','Write')]
        +[kind+'(/'+p+')' for p in protected for kind in ('Edit','Write')]}
    arguments = ['--bg',text,'--name',name,'--remote-control',name,
        '--append-system-prompt',mq_instructions(),'--permission-mode','dontAsk',
        '--tools','Read,Grep,Glob,Bash,Edit,Write' if writable else 'Read,Grep,Glob,Bash',
        '--setting-sources','','--settings',json.dumps(settings),
        '--strict-mcp-config','--mcp-config','{"mcpServers":{}}']
    if len(workspace['roots']) > 1:
        arguments.extend(['--add-dir',*workspace['roots'][1:]])
    return [*arguments,'--allowedTools',*allowed]


def mq_position(context, position):
    if not isinstance(position, dict) or position.get('position_type') != 'text':
        raise RuntimeError('inline finding requires a text diff position')
    diff = context['diff']
    for key, value in [('head_sha', 'head_commit_sha'), ('base_sha', 'base_commit_sha'), ('start_sha', 'start_commit_sha')]:
        if position.get(key) != diff.get(value):
            raise RuntimeError('inline position SHA differs from authenticated diff')
    files = [d for d in diff['diffs'] if d.get('old_path') == position.get('old_path')
             and d.get('new_path') == position.get('new_path')]
    if len(files) != 1:
        raise RuntimeError('inline position file is absent or ambiguous')
    anchors = set()
    old = new = None
    for line in files[0].get('diff', '').splitlines():
        header = re.match(r'^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@', line)
        if header:
            old, new = int(header[1]), int(header[2])
        elif old is not None and line.startswith('+'):
            anchors.add((None,new)); new += 1
        elif old is not None and line.startswith('-'):
            anchors.add((old,None)); old += 1
        elif old is not None and line.startswith(' '):
            anchors.update({(old,new),(old,None),(None,new)}); old += 1; new += 1
    old_line, new_line = position.get('old_line'), position.get('new_line')
    if (old_line is not None and (type(old_line) is not int or old_line < 1)
            or new_line is not None and (type(new_line) is not int or new_line < 1)
            or (old_line,new_line) not in anchors):
        raise RuntimeError('inline position is outside the authenticated diff')
    allowed = {'position_type','base_sha','start_sha','head_sha','old_path','new_path','old_line','new_line'}
    if set(position) - allowed:
        raise RuntimeError('unsupported inline position fields')
    return dict(position)


def mq_thread(context, discussion):
    found = [t for t in context['threads'] if t['id'] == discussion]
    if len(found) != 1:
        raise RuntimeError('discussion is missing or ambiguous')
    return found[0]


def mq_resolution(api, queue, job, action, context, explanation=None):
    thread = mq_thread(context, action['discussion'])
    notes = [n for n in thread['notes'] if not n.get('system')]
    if not notes or not any(n.get('resolvable') and not n.get('resolved') for n in notes):
        raise RuntimeError('discussion is already resolved or is not resolvable')
    assessment = action.get('assessment', {})
    basis = action.get('basis')
    if basis not in {'verified_fix','bot_false_positive'} or assessment.get('complete') is not True:
        raise RuntimeError('resolution requires complete assessment and verified basis')
    evaluated = list(assessment.get('notes', []))
    if explanation is not None:
        if (explanation['state'] != 'confirmed' or explanation['head'] != context['head']
                or not any(n['id'] == explanation['note_id'] and n['body'] == explanation['body']
                           and n['author']['id'] == context['actor_id'] for n in notes)):
            raise RuntimeError('resolution explanation is not confirmed in this discussion/head')
        evaluated.append({'id': explanation['note_id'], 'revision':monitor_digest(explanation['body']),
                          'concerns':[], 'no_concern_reason':'Confirmed explanation for this batch.'})
    if len(evaluated) != len(notes) or {n.get('id') for n in evaluated} != {n['id'] for n in notes}:
        raise RuntimeError('resolution must assess every current non-system note')
    record = queue.mr(job['repository_id'], job['iid'])
    if basis == 'verified_fix' and (assessment.get('fix_commit') != context['head']
                                   or record.get('reviewed_head') == context['head']):
        raise RuntimeError('verified fix requires the actual newly reviewed fix commit')
    def bot(note):
        saved = next((e for e in queue.effects() if e.get('note_id') == note['id']
                      and e['repository_id'] == job['repository_id'] and e['iid'] == job['iid']
                      and e['state'] == 'confirmed' and e['body'] == note['body']), None)
        if saved and note['author']['id'] == context['actor_id']:
            return True
        author = api.get('/users/' + str(note['author']['id']))
        if author.get('id') != note['author']['id']:
            raise RuntimeError('bot metadata author identity changed')
        return author.get('bot') is True
    if basis == 'bot_false_positive' and not bot(notes[0]):
        raise RuntimeError('bot closure requires authenticated root automation')
    dispositions = []
    for raw in notes:
        item = next(n for n in evaluated if n['id'] == raw['id'])
        if item.get('revision') != monitor_digest(raw['body']):
            raise RuntimeError('resolution note revision changed')
        concerns = item.get('concerns', [])
        if not concerns and not item.get('no_concern_reason'):
            raise RuntimeError('resolution omitted note disposition')
        for concern in concerns:
            if concern.get('disposition') not in {'fixed','invalid'} or not concern.get('evidence'):
                raise RuntimeError('outstanding or uncertain concern prohibits resolution')
            if basis == 'bot_false_positive' and concern['disposition'] == 'invalid' and not bot(raw):
                raise RuntimeError('human disagreement cannot authorize resolution')
            dispositions.append(concern['disposition'])
    if ('fixed' if basis == 'verified_fix' else 'invalid') not in dispositions:
        raise RuntimeError('resolution lacks an evidenced required disposition')


def mq_effect_identity(job, action, kind=None):
    return monitor_digest([job['repository_id'],job['iid'],job['head'],kind or action['kind'],
                           action['key'],action.get('discussion'),action.get('position')])


def mq_batch(config, queue, job, result, context):
    if queue.mr(job['repository_id'],job['iid']).get('hold'):
        raise RuntimeError('unresolved human question prohibits public effects')
    if context['mr']['state'] != 'opened' or context['head'] != job['head']:
        raise RuntimeError('closed/merged MR or changed head prohibits new effects')
    mq_consolidation(job, result)
    if job['kind'] in {'human','intake'}:
        mq_human_assessment(result, mq_combined_source(job))
    api = MonitorGitLab(config)
    api.project()
    actions, existing_findings = [], []
    for action in result['actions']:
        if action['kind'] == 'finding':
            mq_position(context, action.get('position'))
            normalize = lambda text: re.sub(r'<!--\s*(?:csmq:|codex-stats-op:)[^>]*-->', '', text).strip()
            existing = [(t,n) for t in context['threads'] for n in t['notes']
                        if not n.get('system') and not n.get('resolved') and n.get('position')
                        and normalize(n['body']) == normalize(action['body'])
                        and all(n['position'].get(k) == action['position'].get(k)
                                for k in ('old_path','new_path','old_line','new_line'))]
            if existing:
                existing_findings.append({'key':action['key'],'discussion':existing[0][0]['id'],
                                          'note_id':existing[0][1]['id']})
                continue
        else:
            mq_thread(context, action['discussion'])
        if action['kind'] == 'resolve':
            mq_resolution(api, queue, job, action, context)
        key = mq_effect_identity(job, action)
        body = action['body'].strip() + '\n\n<!-- csmq:' + key + ' -->'
        effect = {'key':key,'job_id':job['id'],'repository_id':job['repository_id'],'iid':job['iid'],
            'head':job['head'],'kind':action['kind'],'discussion':action.get('discussion'),
            'target_discussion':action.get('discussion'), 'position':action.get('position'), 'body':body,'state':'prepared','actor_id':context['actor_id']}
        if action['kind'] == 'resolve':
            explanation = {**effect,'key':mq_effect_identity(job,action,'explanation'),'kind':'reply'}
            explanation['body'] = action['body'].strip() + '\n\n<!-- csmq:' + explanation['key'] + ' -->'
            effect['explanation_key'] = explanation['key']
            effect['assessment'] = action
            actions.append(explanation)
        actions.append(effect)
    for effect in actions:
        saved = queue.effect(effect['key'])
        if saved and any(saved.get(k)!=effect.get(k) for k in
                         ('repository_id','iid','head','kind','body','target_discussion','position')):
            raise RuntimeError('repeated semantic key changed its immutable public effect')
    with queue.atomic():
        queue.check_running(job)
        job['batch'] = {'original':context,'effects':actions,'result':result,'existing_findings':existing_findings}
        queue.save(job)
    return job['batch']


def mq_expected_context(queue, job):
    import copy
    expected = copy.deepcopy(job['batch']['original'])
    for planned in job['batch']['effects']:
        saved = queue.effect(planned['key'])
        if not saved or saved['state'] != 'confirmed':
            continue
        if saved['kind'] == 'resolve':
            for note in mq_thread(expected,saved['discussion'])['notes']:
                if note.get('resolvable'):
                    note['resolved'] = True
        elif saved.get('raw_note'):
            thread = next((t for t in expected['threads'] if t['id'] == saved['discussion']),None)
            if thread is None:
                thread = {'id':saved['discussion'],'notes':[]}
                expected['threads'].append(thread)
            if not any(n['id'] == saved['note_id'] for n in thread['notes']):
                thread['notes'].append(saved['raw_note'])
    return expected


def mq_send(api, method, route, payload):
    import urllib.request
    import urllib.error
    if method not in {'POST','PUT'} or not route.startswith('/') or route.startswith('//') or '..' in route:
        raise RuntimeError('invalid monitor publication route')
    request = urllib.request.Request(api.base + route, method=method,
        data=json.dumps(payload,ensure_ascii=False).encode(), headers={
            'PRIVATE-TOKEN':api._token,'Accept':'application/json','Content-Type':'application/json'})
    timeout = mq_io_timeout(api.config,'http_timeout')
    try:
        with mq_http_deadline(api.config,issued=True):
            with api.opener.open(request,timeout=timeout) as response:
                raw = response.read(api.config['max_response_bytes']+1)
                if len(raw) > api.config['max_response_bytes']:
                    raise RuntimeError('publication response exceeds byte bound; reconcile delivery')
                return json.loads(raw)
    except OSError as failure:
        if mq_expired(api.config):
            raise MonitorCycleYield('cycle ended after possible public send',issued=True) from failure
        raise


def mq_readback(config, queue, effect, context):
    if effect['kind'] == 'resolve':
        thread = mq_thread(context,effect['discussion'])
        notes = [n for n in thread['notes'] if n.get('resolvable')]
        return {'resolved':True} if notes and all(n.get('resolved')
            and n.get('resolved_by',{}).get('id') == effect['actor_id'] for n in notes) else None
    matches = [(t,n) for t in context['threads'] for n in t['notes']
               if n.get('body') == effect['body'] and n.get('author',{}).get('id') == effect['actor_id']
               and (effect['discussion'] is None or t['id'] == effect['discussion'])]
    if len(matches) > 1:
        raise RuntimeError('duplicate authenticated public effect read-back')
    if not matches:
        return None
    thread,note = matches[0]
    if effect['kind'] == 'finding' and note.get('position') != effect['position']:
        # Provider returns additional normalized position fields; compare the actual requested anchor.
        position = note.get('position', {})
        if any(position.get(k) != v for k,v in effect['position'].items()):
            raise RuntimeError('published inline position differs from its intent')
    return {'note_id':note['id'],'discussion':thread['id'],'raw_note':note}


def mq_apply(config, queue, job, verify_source):
    api = MonitorGitLab(config)
    api.project()
    for planned in job['batch']['effects']:
        saved = queue.effect(planned['key'])
        if saved and saved['state'] == 'confirmed':
            continue
        context = mq_context(config,job['iid'],with_diff=False)
        if saved and saved['state'] in {'sending','unknown'}:
            receipt = (mq_resolution_receipt(queue,job,saved,context) if saved['kind']=='resolve'
                       else mq_readback(config,queue,saved,context))
            if receipt is None:
                queue.park(job,'effect_unknown')
                return False
            with queue.atomic():
                queue.check_running(job)
                saved.update(state='confirmed',**receipt)
                queue.put_effect(saved)
            continue
        verify_source()
        mq_admit(config,job['repository_id'])
        expected = mq_expected_context(queue,job)
        if (context['actor_id'] != planned['actor_id'] or context['mr']['state'] != 'opened' or context['head'] != job['head']
                or mq_fingerprint(context) != mq_fingerprint(expected)):
            raise MonitorContextChanged('head/discussion changed before public send; reassessment required')
        if planned['kind'] == 'resolve':
            explanation = queue.effect(planned['explanation_key'])
            mq_resolution(api,queue,job,planned['assessment'],context,explanation)
        # Exact already-public findings are reused even after a fresh monitor start.
        receipt = mq_readback(config,queue,planned,context) if planned['kind'] != 'resolve' else None
        mq_budget(config)
        effect = dict(planned)
        with queue.atomic():
            queue.check_running(job)
            if receipt:
                effect.update(state='confirmed',**receipt)
            else:
                mq_admit(config,job['repository_id'])
                effect['state'] = 'sending'
            queue.put_effect(effect)
        if receipt:
            continue
        route = f"/projects/{job['repository_id']}/merge_requests/{job['iid']}/discussions"
        sent = False
        try:
            if effect['kind'] == 'finding':
                mq_send(api,'POST',route,{'body':effect['body'],'position':effect['position']})
            elif effect['kind'] == 'reply':
                mq_send(api,'POST',route+'/'+effect['discussion']+'/notes',{'body':effect['body']})
            else:
                mq_send(api,'PUT',route+'/'+effect['discussion'],{'resolved':True})
            sent = True
            observed = mq_context(config,job['iid'],with_diff=False)
            receipt = (mq_resolution_receipt(queue,job,effect,observed) if effect['kind']=='resolve'
                       else mq_readback(config,queue,effect,observed))
            if receipt is None:
                raise RuntimeError('public effect is not confirmed by authenticated read-back')
            with queue.atomic():
                queue.check_running(job)
                effect.update(state='confirmed',**receipt)
                queue.put_effect(effect)
        except MonitorCycleYield as yielded:
            if not sent and not yielded.issued:
                with queue.atomic():
                    queue.check_running(job)
                    effect['state'] = 'prepared'
                    queue.put_effect(effect)
            raise
        except Exception as error:
            with queue.atomic():
                queue.check_running(job)
                effect.update(state='unknown',error=type(error).__name__)
                queue.put_effect(effect)
            queue.park(job,'effect_unknown')
            return False
    return True


class MonitorContextChanged(RuntimeError):
    pass


def mq_resolution_receipt(queue,job,effect,context):
    receipt = mq_readback({},queue,effect,context)
    if receipt is None:
        return None
    import copy
    expected = copy.deepcopy(mq_expected_context(queue,job))
    for note in mq_thread(expected,effect['discussion'])['notes']:
        if note.get('resolvable'):
            note['resolved'] = True
    if (context['head'] != effect['head'] or context['actor_id'] != effect['actor_id']
            or mq_fingerprint(context) != mq_fingerprint(expected)):
        raise RuntimeError('observed resolution has changed head/discussion context; keep unsettled')
    return receipt


def mq_all_stages(queue):
    for job in queue.jobs():
        yield from job['stages']
        for previous in job.get('rounds', []):
            yield from previous['stages']


def mq_texts(content):
    if isinstance(content,str):
        return [content],False
    if not isinstance(content,list):
        return [],True
    texts = [c['text'] for c in content if isinstance(c,dict) and c.get('type') == 'text' and isinstance(c.get('text'),str)]
    return texts, len(texts) != len(content)


def mq_registered_source(queue, texts, client_ids=()):
    stages = list(mq_all_stages(queue))
    return (any(s['id'] in client_ids for s in stages)
            or any(s.get('input') and s['input'] in texts for s in stages))


def mq_verify_source(config,queue,source,repository,iid):
    record = queue.mr(repository,iid)
    provider,session = source['provider'],source['session']
    owned = mq_owned_sessions(record)
    if session not in owned:
        raise RuntimeError('human source is not in a chat owned by this MR')
    if provider == 'codex':
        native = monitor_native(config,'thread/read',{'threadId':session,'includeTurns':False})['thread']
        mq_verify_codex_context(config,record,native,session)
        if (native.get('cwd') != source['cwd'] or native.get('projectId') != source.get('project_id')):
            raise RuntimeError('human source workspace/project changed')
        items = mq_codex_items(config,session,source['turn_id'])
        inputs = [i for i in items if i.get('type') == 'userMessage']
        texts = [t for i in inputs for t in mq_texts(i.get('content'))[0]]
        mixed = any(mq_texts(i.get('content'))[1] for i in inputs) or mq_automatic_items(items)
        if len(inputs) != 1 or inputs[0].get('id') != source['source_id']:
            raise RuntimeError('human native source identity changed')
        automatic = mq_registered_source(queue,texts,[i.get('clientId') for i in inputs])
    else:
        records = mq_claude_records(config,session)
        found = [r for r in records if r.get('uuid') == source['source_id'] and r.get('type') == 'user']
        if (len(found) != 1 or found[0].get('cwd') != source['cwd']
                or source['cwd'] != record.get('claude_contexts',{}).get(session,config['cwd'])):
            raise RuntimeError('human native Claude source identity changed')
        texts,mixed = mq_texts(found[0]['message'].get('content'))
        automatic = mq_registered_source(queue,texts)
    if texts != source['texts'] or mixed or automatic or source.get('mixed') or source.get('automated'):
        raise RuntimeError('human source changed or contains automatic/mixed input')
    if '?' in '\n'.join(texts) or '\n'.join(texts).rstrip().endswith('w'):
        raise RuntimeError('question-only native input grants no mutable work')


def mq_verify_job_sources(config,queue,job):
    for source in [job['source'], *job.get('answers',[])]:
        if source.get('origin') == 'human':
            mq_verify_source(config,queue,source,job['repository_id'],job['iid'])


def mq_combined_source(job):
    sources = [job['source'],*job.get('answers',[])]
    return {'origin':job['source'].get('origin'), 'texts':[t for s in sources for t in s.get('texts',[])],
            'mixed':any(s.get('mixed') for s in sources),'automated':any(s.get('automated') for s in sources)}


def mq_rotated_sources(queue,key,values,identity):
    first = queue.meta(key)
    index = next((i for i,v in enumerate(values) if identity(v)==first),0)
    ordered = values[index:]+values[:index]
    for position,value in enumerate(ordered):
        following = ordered[(position+1)%len(ordered)]
        with queue.atomic():queue.set_meta(key,identity(following))
        yield value


def mq_human_candidates(config,queue,record):
    codex = list(dict.fromkeys([*record.get('codex_contexts',{}),record['chats'].get('codex')]))
    claude = list(dict.fromkeys([*record.get('claude_history',[]),record['chats'].get('claude')]))
    sessions = [('codex',s) for s in codex if s]+[('claude',s) for s in claude if s]
    key = f"human_next_session:{record['repository_id']}:{record['iid']}"
    for provider,session in mq_rotated_sources(queue,key,sessions,lambda v:':'.join(v)):
        try:
            yield from mq_session_candidates(config,queue,record,provider,session)
        except (OSError,RuntimeError,ValueError,KeyError) as failure:
            mq_diagnostic(queue,'human_session_error:'+provider+':'+session,failure)


def mq_session_candidates(config,queue,record,provider,session):
    if provider=='codex':
        native = monitor_native(config,'thread/read',{'threadId':session,'includeTurns':False})['thread']
        for turn in mq_intake_turns(config,queue,session):
            seen = 'human:'+session+':'+turn
            try:
                items = mq_codex_items(config,session,turn)
            except (OSError,RuntimeError,ValueError,KeyError) as failure:
                mq_diagnostic(queue,'human_source_error:'+session+':'+turn,failure)
                continue
            inputs = [i for i in items if i.get('type') == 'userMessage']
            texts = [t for i in inputs for t in mq_texts(i.get('content'))[0]]
            if not inputs or not texts:
                continue
            automatic = mq_registered_source(queue,texts,[i.get('clientId') for i in inputs])
            source = {'origin':'human','provider':'codex','session':session,'turn_id':turn,
                'source_id':inputs[0]['id'],'texts':texts,'cwd':native['cwd'],'project_id':native.get('projectId'),
                'mixed':len(inputs)!=1 or any(mq_texts(i.get('content'))[1] for i in inputs) or mq_automatic_items(items),
                'automated':automatic}
            finals = [i for i in items if i.get('type') == 'agentMessage' and i.get('phase') == 'final_answer']
            yield seen,source,finals[0]['text'] if len(finals)==1 else None
        return
    records = mq_claude_records(config,session)
    users = [(i,r) for i,r in enumerate(records) if r.get('type')=='user' and not r.get('isMeta')
             and r.get('uuid') and not queue.meta('human:'+session+':'+r['uuid'])]
    for index,row in mq_rotated_sources(queue,'human_next_source:'+session,users,lambda v:v[1]['uuid']):
        texts,mixed = mq_texts(row.get('message',{}).get('content'))
        if not texts:
            continue
        seen = 'human:'+session+':'+row['uuid']
        if queue.meta(seen):
            continue
        source = {'origin':'human','provider':'claude','session':session,'source_id':row['uuid'],
            'texts':texts,'cwd':row['cwd'],'mixed':mixed,'automated':mq_registered_source(queue,texts)}
        final = mq_claude_final(records[index+1:],row)
        if final['sealed']:
            yield seen,source,final.get('text') if not final.get('error') else None


def mq_intake_turns(config,queue,session):
    # Save each page before reading its items. A slow source rotates on the next cycle;
    # a slow later page never prevents processing the latest completed turn first.
    key = 'human_history:'+session
    state = queue.meta(key) or {'cursor':None,'pages':0,'pending':[],'final':False}
    refresh = state['pages'] and queue.meta('human_refresh:'+session) is not False
    if state['pages']:
        with queue.atomic():queue.set_meta('human_refresh:'+session,not refresh)
    if refresh:
        # New answers arrive at the head even while an old continuation is stalled.
        # Keep that short refresh separate from the durable historical cursor/pending IDs.
        page = monitor_turn_page(config,session)
        latest = [t['id'] for t in page['data'] if t['status']!='inProgress'
                  and not queue.meta('human:'+session+':'+t['id'])]
        for turn in mq_rotated_sources(queue,'human_latest_turn:'+session,latest,lambda t:t):
            yield turn
        state = queue.meta(key) or state
    while True:
        mq_budget(config)
        if not state['pending']:
            if state['final'] or state['pages'] >= config['max_history_pages']:
                with queue.atomic():queue.set_meta(key,None)
                if not state['final']:
                    raise RuntimeError('native thread history exceeds configured page bound')
                return
            page = monitor_turn_page(config,session,state['cursor'])
            state.update(cursor=page['nextCursor'],pages=state['pages']+1,final=page['nextCursor'] is None,
                pending=[t['id'] for t in page['data'] if t['status']!='inProgress'])
            with queue.atomic():queue.set_meta(key,state)
            continue
        turn = state['pending'].pop(0)
        with queue.atomic():queue.set_meta(key,state)
        if not queue.meta('human:'+session+':'+turn):
            yield turn
        # A sufficient answer may have yielded while verifying its question order.
        state = queue.meta(key) or {'cursor':None,'pages':0,'pending':[],'final':False}

def mq_reset_round(queue,job,reason):
    with queue.atomic():
        queue.check_running(job)
        if any(s['state']=='running' for s in job['stages']):
            raise RuntimeError('cannot reset a nonterminal native round')
        if any(e.get('job_id')==job['id'] and e['state'] not in {'prepared','confirmed','cancelled'}
               for e in queue.effects()):
            raise RuntimeError('unsettled public effect prohibits round reset')
        for effect in queue.effects():
            if effect.get('job_id')==job['id'] and effect['state']=='prepared':
                effect.update(state='cancelled',cancelled_reason=reason)
                queue.put_effect(effect)
        job.setdefault('rounds',[]).append({'reason':reason,'stages':job['stages'],'batch':job['batch'],
                                          'workspace':job.get('workspace')})
        job.update(stages=[],batch=None,outcome=None,needs_round_reset=False,workspace=None)
        queue.save(job)


def mq_accept_answer(config,queue,record,source,result):
    hold = record.get('hold')
    if not hold:
        return False
    mq_verify_source(config,queue,source,record['repository_id'],record['iid'])
    mq_human_assessment(result,source,hold)
    try:
        mq_answer_after_question(config,queue,source,hold)
    except MonitorCycleYield:
        if source['provider']=='codex':
            key = 'human_history:'+source['session']
            state = queue.meta(key) or {'cursor':None,'pages':0,'pending':[],'final':False}
            if source['turn_id'] not in state['pending']:
                state['pending'].append(source['turn_id'])
            with queue.atomic():queue.set_meta(key,state)
        raise
    with queue.atomic():
        current = queue.mr(record['repository_id'],record['iid'])
        if current.get('hold') != hold:
            raise RuntimeError('question changed before sufficient-answer registration')
        pending = current.setdefault('pending_answers',[])
        if not any(a['source']['source_id']==source['source_id'] and a['source']['session']==source['session'] for a in pending):
            pending.append({'source':source,'result':result,'anchor':hold['anchor']})
        queue.put_mr(current)
        job = queue.job(hold['job_id'])
        if job and job['state']=='pending' and job['wait_reason']=='human':
            job.update(wait_reason='answer_ready',retry_at=0)
            queue.save(job)
    return True


def mq_intake(config,queue,record):
    for seen,source,text in mq_human_candidates(config,queue,record):
        joined = '\n'.join(source['texts'])
        if source['automated'] or source['mixed'] or '?' in joined or joined.rstrip().endswith('w'):
            with queue.atomic():
                queue.set_meta(seen,{'disposition':'no_authority'})
            continue
        mq_admit(config,record['repository_id'])
        mq_verify_source(config,queue,source,record['repository_id'],record['iid'])
        context = mq_context(config,record['iid'],with_diff=False)
        result = None
        if text:
            try:
                result = mq_parse_result(text,record['repository_id'],record['iid'],context['head'])
            except (RuntimeError,ValueError):
                result = None
        record = queue.mr(record['repository_id'],record['iid'])
        if result and (result.get('assessment') or {}).get('kind') == 'answer' and record.get('hold'):
            mq_accept_answer(config,queue,record,source,result)
        elif result and (result['outcome']=='noop' or (result.get('assessment') or {}).get('kind')=='explanation'):
            pass
        else:
            kind = 'intake'
            if result and (result.get('assessment') or {}).get('kind') == 'action':
                mq_human_assessment(result,source)
                kind = 'human'
            queue.enqueue(record['repository_id'],record['iid'],source_key=seen,kind=kind,
                head=context['head'],source=source,context=context,prepared=result)
        with queue.atomic():
            queue.set_meta(seen,{'disposition':'observed'})


def mq_inventory(config,queue):
    projects = mq_repositories(config)
    first = queue.meta('inventory_next_repository')
    index = next((i for i,p in enumerate(projects) if p['id']==first),0)
    ordered = projects[index:]+projects[:index]
    count = 0
    for project in ordered:
        with queue.atomic():
            position = projects.index(project)
            queue.set_meta('inventory_next_repository',projects[(position+1)%len(projects)]['id'])
        key = 'inventory_cursor:'+str(project['id'])
        cursor = queue.meta(key) or {'page':1,'pending':[],'final':False}
        try:
            scoped = mq_repository(config,project['id'])
            api = MonitorGitLab(scoped)
            api.project()
            route = f"/projects/{project['id']}/merge_requests?state=opened&order_by=created_at&sort=asc"
            while True:
                mq_budget(config)
                if not cursor['pending']:
                    if cursor['final']:
                        with queue.atomic():queue.set_meta(key,None)
                        break
                    page,final = next(api.pages(route,start_page=cursor['page']))
                    cursor = {'page':cursor['page']+1,'pending':[int(row['iid']) for row in page],'final':final}
                    with queue.atomic():queue.set_meta(key,cursor)
                    if not cursor['pending']:
                        continue
                if count>=config['max_mrs']:
                    raise MonitorCycleYield('MR inventory cycle cap')
                mq_budget(config)
                iid = cursor['pending'].pop(0)
                # Advance before bounded I/O: a persistently slow MR cannot hide later MRs.
                with queue.atomic():queue.set_meta(key,cursor)
                count += 1
                try:
                    mq_admit(config,project['id'])
                    context = mq_context(scoped,iid,with_diff=False)
                    if context['mr']['state']!='opened':
                        continue
                    record = queue.mr(project['id'],context['iid'])
                    owned = [e for e in queue.effects() if e['repository_id']==project['id'] and e['iid']==context['iid']]
                    notes = [monitor_note(n,t['id']) for t in context['threads'] for n in t['notes']
                        if not n.get('system') and not any(e.get('body')==n['body'] and e.get('actor_id')==n['author']['id'] for e in owned)]
                    signature = monitor_digest([{k:n[k] for k in ('id','discussion','revision','author_id')} for n in notes])
                    fresh_start = 'observed_notes' not in record
                    generation = record.get('observation_generation',0)+1
                    changed = record.get('observed_head')!=context['head'] or record.get('observed_notes')!=signature or fresh_start
                    if changed:
                        code = record.get('observed_head')!=context['head'] or fresh_start
                        source = {'origin':'automatic','head':context['head']} if code else {'origin':'automatic','notes':signature}
                        queue.enqueue(project['id'],context['iid'],
                            source_key=f"observation:{project['id']}:{context['iid']}:{generation}:{context['head']}:{signature}",
                            kind='code' if code else 'discussion',head=context['head'],source=source,context=context)
                        with queue.atomic():
                            mq_admit(config,project['id'])
                            fresh = queue.mr(project['id'],context['iid'])
                            fresh.update(observed_head=context['head'],observed_notes=signature,
                                observation_generation=generation,title=context['mr']['title'])
                            queue.put_mr(fresh)
                except (OSError,RuntimeError,ValueError) as failure:
                    mq_diagnostic(queue,f"inventory_error:{project['id']}:{iid}",failure)
        except MonitorDeferred as failure:
            mq_diagnostic(queue,'inventory_error:'+str(project['id']),failure)
            with queue.atomic():queue.set_meta(key,None)
        except (OSError,RuntimeError,ValueError) as failure:
            mq_diagnostic(queue,'inventory_error:'+str(project['id']),failure)
    return True


def mq_question(queue,job,stage,result):
    with queue.atomic():
        queue.check_running(job)
        record = queue.mr(job['repository_id'],job['iid'])
        question = {'job_id':job['id'],'anchor':result['question'],'native_anchor':stage.get('anchor'),
            'turn_id':stage.get('turn_id'),'stage_id':stage['id'],
            'provider':stage['reviewer'],'session':stage['session'],'question':result['question'],
            'scope':job.get('scope') or {'effects':['finding','reply','resolve'],
                'discussions':[t['id'] for t in job['context']['threads']]}}
        job.setdefault('questions',[]).append(question)
        if not record.get('hold'):
            record['hold'] = question
        elif record['hold']['job_id']==job['id']:
            record.setdefault('held_questions',[]).append(question)
        queue.put_mr(record)
        queue.save(job)


def mq_release_answer(config,queue,job):
    record = queue.mr(job['repository_id'],job['iid'])
    hold = record.get('hold')
    if not hold:
        return False
    ready = next((a for a in record.get('pending_answers',[]) if a['anchor']==hold['anchor']),None)
    if not ready:
        return False
    mq_verify_source(config,queue,ready['source'],job['repository_id'],job['iid'])
    mq_human_assessment(ready['result'],ready['source'],hold)
    mq_answer_after_question(config,queue,ready['source'],hold)
    with queue.atomic():
        queue.check_running(job)
        current = queue.mr(job['repository_id'],job['iid'])
        if current.get('hold') != hold:
            raise RuntimeError('question changed before release')
        job.setdefault('answers',[]).append(ready['source'])
        current.setdefault('hold_history',[]).append({**hold,'answer':ready['source']})
        waiting = current.get('held_questions',[])
        current['hold'] = waiting.pop(0) if waiting else None
        if current['hold'] is None:
            job['needs_round_reset'] = True
        current['pending_answers'].remove(ready)
        queue.put_mr(current)
        queue.save(job)
    if not current['hold']:
        mq_reset_round(queue,job,'sufficient human answers')
    return True


def mq_step(config,queue):
    job = queue.reserve({p['id'] for p in mq_repositories(config)})
    if job is None:
        return False
    enabled = job['repository_id'] in {p['id'] for p in mq_repositories(config)}
    scoped = (mq_repository(config,job['repository_id']) if enabled else
              {**config,'project_id':job['repository_id'],'_project_id':job['repository_id'],
               'project_path':job['repository_path']})
    if job.get('workspace'):
        scoped = mq_workspace_config(scoped,job)
    if job['stages'] and job['stages'][-1]['state']=='running':
        stage = job['stages'][-1]
        mq_verify_input(queue,stage)
        if stage['delivery']=='prepared':
            return mq_launch_stage(scoped,queue,job,stage)
        expired = mq_stamp() >= stage.get('review_deadline',stage['started_at']+config['review_timeout_seconds'])
        if expired and not stage.get('cancel_requested_at'):
            mq_update_stage(queue,job,stage['id'],cancel_requested_at=mq_stamp())
        if stage['reviewer']=='claude':
            # Also repairs an interrupted old acknowledgment/ownership registration.
            if mq_claude_accept(scoped,queue,job,stage) is None:
                rejection = mq_legacy_claude_rejection(scoped,job,stage)
                if rejection:
                    queue.stage_end(job,stage['id'],error=rejection,terminal=True)
                    return True
                if expired:
                    mq_diagnostic(queue,'consumer_error','review timeout; exact Claude delivery remains unacknowledged')
                return False
            observed = mq_claude_observe(scoped,stage)
        else:
            observed = mq_codex_observe(scoped,stage)
        updates = {k:v for k,v in observed.items() if k in {'anchor','turn_id','source_id','remote_url'}}
        if updates:
            mq_update_stage(queue,job,stage['id'],**updates)
        if not observed['terminal']:
            if expired and mq_cancel_stage(scoped,stage):
                queue.stage_end(job,stage['id'],error={'message':'review timed out; exact native execution stopped'},terminal=True)
                return True
            return False
        result,error = None,observed.get('error')
        if error is None:
            try:
                result = mq_parse_result(observed['text'],job['repository_id'],job['iid'],job['head'])
                if job['source'].get('origin')=='automatic' and result['outcome']=='noop':
                    raise RuntimeError('automatic review requires complete or a real question')
            except (RuntimeError,ValueError) as failure:
                error = {'message':str(failure)}
        queue.stage_end(job,stage['id'],result=result,error=error,terminal=True)
        if result and result['outcome']=='question':
            mq_question(queue,job,stage,result)
        return True
    if job.get('needs_round_reset'):
        mq_reset_round(queue,job,'recover sufficient-answer round reset')
        return True
    for stage in job['stages']:
        if (stage['state']=='succeeded' and stage['result']['outcome']=='question'
                and not any(q['stage_id']==stage['id'] for q in job.get('questions',[]))):
            mq_question(queue,job,stage,stage['result'])
            return True
    record = queue.mr(job['repository_id'],job['iid'])
    if (record.get('hold') and record['hold']['job_id']==job['id'] and record.get('pending_answers')
            and queue.next_reviewer(job) is None):
        if mq_release_answer(scoped,queue,job):
            return True
    if job.get('resumed_from')=='all_failed' and job['outcome']=='retry':
        mq_reset_round(queue,job,'bounded reviewer retry')
    if not job['stages']:
        context = mq_context(scoped,job['iid'])
        if context['mr']['state'] != 'opened':
            queue.finish(job,'MR closed or merged')
            return True
        if context['head'] != job['head'] and (job['kind']=='code' or job.get('coalesced_jobs')):
            queue.finish(job,'superseded by a new head')
            return True
        mq_verify_job_sources(scoped,queue,job)
        with queue.atomic():
            queue.check_running(job)
            job['context'] = context
            if job['kind'] in {'human','intake'}:
                job['head'] = context['head']
            if not job.get('scope') and job['prepared'] and (job['prepared'].get('assessment') or {}).get('kind')=='action':
                job['scope'] = mq_human_assessment(job['prepared'],job['source'])
            queue.save(job)
    if not enabled and not job.get('batch'):
        queue.park(job,'repository_removed')
        return True
    next_reviewer = queue.next_reviewer(job)
    if next_reviewer is not None:
        scoped = mq_workspace(scoped,queue,job)
        stage = queue.stage_start(job,next_reviewer,'')
        return mq_launch_stage(scoped,queue,job,stage)
    record = queue.mr(job['repository_id'],job['iid'])
    if record.get('hold') and record['hold']['job_id']!=job['id'] and job['kind']=='intake':
        result = queue.review_result(job)
        if result and (result.get('assessment') or {}).get('kind')=='answer':
            mq_accept_answer(scoped,queue,record,job['source'],result)
            queue.finish(job,'sufficient answer registered; original hold preserved until reserved')
        elif result and (result.get('assessment') or {}).get('kind')=='action':
            mq_human_assessment(result,job['source'])
            queue.park(job,'held_request')
        else:
            queue.finish(job,'no sufficient answer; original question remains open')
        return True
    if record.get('hold'):
        queue.park(job,'human')
        return True
    successes = [s for s in job['stages'] if s['state']=='succeeded']
    if successes and successes[-1]['result']['outcome']=='noop':
        queue.finish(job,'explanation; no mutable work')
        return True
    result = queue.review_result(job)
    if result is None:
        with queue.atomic():
            queue.check_running(job)
            job['outcome'] = 'retry'
            queue.save(job)
        queue.park(job,'all_failed',retry_at=mq_stamp()+config['interval_minutes']*60)
        return True
    mq_verify_job_sources(scoped,queue,job)
    for stage in job['stages']:
        mq_verify_input(queue,stage)
    if job['kind'] in {'human','intake'}:
        scope = mq_human_assessment(result,mq_combined_source(job))
        if job.get('scope') and (not set(scope['effects']) <= set(job['scope']['effects'])
                or not set(scope['discussions']) <= set(job['scope']['discussions'])):
            raise RuntimeError('continuation broadened original human scope')
    if job['batch'] is None:
        current = mq_context(scoped,job['iid'])
        if mq_fingerprint(current) != mq_fingerprint(job['context']):
            mq_reset_round(queue,job,'context changed before publication')
            return True
        try:
            mq_batch(scoped,queue,job,result,current)
        except (RuntimeError,ValueError) as error:
            with queue.atomic():
                queue.check_running(job)
                job.update(validation_error=str(error),last_error={'at':mq_stamp(),'error':str(error)[:3000]})
                queue.save(job)
            queue.park(job,'retry',retry_at=mq_stamp()+config['interval_minutes']*60)
            return True
    try:
        if mq_apply(scoped,queue,job,lambda:mq_verify_public_sources(scoped,queue,job)):
            queue.finish(job,'reviewed',reviewed=job['kind']=='code')
    except MonitorContextChanged:
        mq_reset_round(queue,job,'context changed after confirmed effects; reassess without resending')
    return True


def mq_launch_stage(config,queue,job,stage):
    if not stage['input']:
        text = mq_input(queue,job,stage,job['context'])
        mq_update_stage(queue,job,stage['id'],input=text)
    try:
        mq_admit(config,job['repository_id'])
        mq_verify_job_sources(config,queue,job)
        if stage['reviewer']=='claude':
            mq_claude_dispatch(config,queue,job,stage)
        else:
            mq_codex_dispatch(config,queue,job,stage)
    except (OSError,RuntimeError) as failure:
        if stage['delivery']=='prepared' or isinstance(failure,MonitorNativeRejected) or (
                isinstance(failure,MonitorClaudeError) and failure.not_started):
            queue.stage_end(job,stage['id'],error={'message':str(failure)},terminal=True)
        else:
            # An issued native input with lost acknowledgment is not a known failed execution.
            mq_update_stage(queue,job,stage['id'],error={'message':str(failure),
                **({'operation':failure.operation,'returncode':failure.returncode} if isinstance(failure,MonitorClaudeError) else {})})
    return True


def mq_automatic_items(items):
    return any(i.get('type') == 'functionCallOutput' and i.get('name') in
               {'gitlab_monitor_event','gitlab_monitor_human_request'} for i in items)


def mq_cancel_stage(config,stage):
    if stage['reviewer']=='claude' and stage.get('background_id'):
        native = next((a for a in mq_claude_agents(config) if a['id']==stage['background_id']
            and a['sessionId']==stage['session'] and a['name']==stage.get('name') and a['cwd']==config['cwd']),None)
        return bool(native and mq_claude_stop(config,native))
    if stage['reviewer']=='codex' and stage.get('turn_id'):
        monitor_native(config,'turn/interrupt',{'threadId':stage['session'],'turnId':stage['turn_id']})
        return bool(mq_codex_observe(config,stage).get('terminal'))
    return False

def mq_verify_public_sources(config,queue,job):
    mq_verify_job_sources(config,queue,job)
    for stage in job['stages']:
        mq_verify_input(queue,stage)
        if stage['state']=='succeeded':
            if stage['reviewer'] == 'codex':
                native = monitor_native(config,'thread/read',{'threadId':stage['session'],'includeTurns':False})['thread']
                mq_verify_codex_context(config,queue.mr(job['repository_id'],job['iid']),native,stage['session'])
            observed = mq_claude_observe(config,stage) if stage['reviewer']=='claude' else mq_codex_observe(config,stage)
            if (not observed.get('terminal') or observed.get('error')
                    or observed.get('anchor')!=stage.get('anchor')
                    or mq_parse_result(observed['text'],job['repository_id'],job['iid'],job['head'])!=stage['result']):
                raise RuntimeError('native final result changed before publication')


def mq_answer_after_question(config,queue,source,hold):
    if source['provider']==hold['provider'] and source['session']==hold['session']:
        if source['provider']=='codex':
            items = mq_codex_items(config,source['session'],hold['turn_id'])
            if not any(i.get('id')==hold['native_anchor'] and hold['question'] in i.get('text','') for i in items):
                raise RuntimeError('question native anchor changed')
            # Only these exact native IDs matter. Retain cursor/order evidence across
            # bounded ticks, and reread original source/question items on every use.
            key = 'human_answer_order:'+monitor_digest(json.dumps([source,hold],sort_keys=True))
            proof = queue.meta(key) or {'cursor':None,'pages':0,'answer_seen':False,'done':False}
            while not proof['done']:
                if proof['pages'] >= config['max_history_pages']:
                    with queue.atomic():queue.set_meta(key,None)
                    raise RuntimeError('native question order exceeds configured page bound')
                page = monitor_turn_page(config,source['session'],proof['cursor'])
                for turn in page['data']:
                    if turn['id']==hold['turn_id']:
                        if not proof['answer_seen'] or source['turn_id']==hold['turn_id']:
                            raise RuntimeError('answer must follow its native question')
                        proof['done'] = True
                        break
                    if turn['id']==source['turn_id']:
                        proof['answer_seen'] = True
                proof.update(cursor=page['nextCursor'],pages=proof['pages']+1)
                if not proof['done'] and page['nextCursor'] is None:
                    raise RuntimeError('answer must follow its native question')
                with queue.atomic():queue.set_meta(key,proof)
        else:
            records = mq_claude_records(config,source['session'])
            ids = [r.get('uuid') for r in records]
            if (hold['native_anchor'] not in ids or source['source_id'] not in ids
                    or ids.index(source['source_id']) <= ids.index(hold['native_anchor'])):
                raise RuntimeError('answer must follow its native question')
        return
    # Another execution is a valid answer surface only if its saved input carried this hold.
    stages = [s for s in mq_all_stages(queue) if s.get('session')==source['session']]
    for stage in stages:
        mq_verify_input(queue,stage)
        data = json.loads((queue.path.parent/'inputs'/(stage['id']+'.json')).read_text())
        if data.get('hold')==hold:
            return
    raise RuntimeError('answer does not belong to the original or a registered question continuation')


def mq_lock(config, name, *, blocking=False):
    import fcntl
    root = Path(config['queue_file']).parent
    root.mkdir(mode=0o700,parents=True,exist_ok=True)
    monitor_private(root,directory=True)
    path = root / (name+'.lock')
    descriptor = os.open(path,os.O_CREAT|os.O_WRONLY|os.O_NOFOLLOW,0o600)
    try:
        monitor_private(path)
        fcntl.flock(descriptor,fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def mq_diagnostic(queue,key,error):
    with queue.atomic():
        queue.set_meta(key,{'at':mq_stamp(),'error':str(error)[:3000]})


def mq_scan(config,queue):
    import time
    # Separate limited portions keep both human intake and inventory moving across ticks.
    remaining = max(0,config['_cycle_deadline']-time.monotonic())
    intake = {**config,'_cycle_deadline':time.monotonic()+remaining/3}
    intake['_io_guard'] = lambda:mq_budget(intake)
    intake['_native_guard'] = lambda:mq_budget(intake)
    records = [r for r in queue.mrs() if r['repository_id'] in {p['id'] for p in mq_repositories(config)}]
    first = queue.meta('intake_next_mr')
    index = next((i for i,r in enumerate(records) if [r['repository_id'],r['iid']]==first),0)
    ordered = records[index:]+records[:index]
    try:
        for record in ordered:
            mq_budget(intake)
            with queue.atomic():
                following = records[(records.index(record)+1)%len(records)]
                queue.set_meta('intake_next_mr',[following['repository_id'],following['iid']])
            try:
                mq_intake(mq_repository(intake,record['repository_id']),queue,record)
            except (OSError,RuntimeError,ValueError) as failure:
                mq_diagnostic(queue,f"intake_error:{record['repository_id']}:{record['iid']}",failure)
    except MonitorCycleYield:
        pass
    due = mq_stamp()-(queue.meta('last_inventory') or 0)>=config['interval_minutes']*60
    if monitor_is_open(config) and due:
        inventory = {**config,'_cycle_deadline':time.monotonic()+max(0,config['_cycle_deadline']-time.monotonic())/2}
        inventory['_io_guard'] = lambda:mq_budget(inventory)
        inventory['_native_guard'] = lambda:mq_budget(inventory)
        try:
            if mq_inventory(inventory,queue):
                with queue.atomic():queue.set_meta('last_inventory',mq_stamp())
        except MonitorCycleYield:
            pass
        except (OSError,RuntimeError,ValueError) as failure:
            mq_diagnostic(queue,'scan_error',failure)
    with queue.atomic():queue.set_meta('last_scan',mq_stamp())


def mq_drain(config,queue):
    # Only ready transitions. Never wait for external execution or drain indefinitely.
    seen = config.setdefault('_observed_attempts',set())
    for _ in range(64):
        mq_budget(config)
        active = queue.jobs('running')
        if active and any(s['state']=='running' and s['id'] in seen for s in active[0]['stages']):
            return
        progress = mq_consume(config,queue)
        active = queue.jobs('running')
        if active and any(s['state']=='running' for s in active[0]['stages']):
            seen.update(s['id'] for s in active[0]['stages'] if s['state']=='running')
            return
        if not progress:
            return


def mq_tick(path):
    import time
    config = mq_config(Path(path))
    try:
        consumer = mq_lock(config,'consumer')
    except BlockingIOError:
        return {'cycle':'busy','writes_performed':False}
    queue = None
    try:
        queue = MonitorQueue(config)
        config['_cycle_deadline'] = time.monotonic()+config['cycle_seconds']
        config['_io_guard'] = lambda:mq_budget(config)
        config['_native_guard'] = lambda:mq_budget(config)
        # Existing terminal work/publications/next reviewer precede potentially slow intake.
        mq_drain(config,queue)
        mq_scan(config,queue)
        mq_drain(config,queue)
        return {'cycle':'checked','queue_file':config['queue_file']}
    except MonitorCycleYield:
        return {'cycle':'checked','yielded':'cycle budget','queue_file':config['queue_file']}
    finally:
        if queue is not None:
            queue.close()
        os.close(consumer)


def mq_status(config):
    if not Path(config['queue_file']).exists():
        return {'queue_file':config['queue_file'],'initialized':False,'reviewers':config['reviewers']}
    queue = MonitorQueue(config,readonly=True)
    try:
        return {'queue_file':config['queue_file'],'initialized':True,'reviewers':config['reviewers'],
            'parallel':1,'projects':mq_repositories(config),'jobs':[mq_job_status(j,config) for j in queue.jobs()],
            'mrs':queue.mrs(),
            'diagnostics':{r['key']:json.loads(r['value']) for r in queue.db.execute(
                "SELECT key,value FROM metadata WHERE key LIKE '%error%' OR key IN ('last_inventory','last_scan','wake')")}}
    finally:
        queue.close()


def mq_snapshot(config,iid,filename=None,ref=None,discussion=None):
    from urllib.parse import quote
    if filename is None:
        context = mq_context(config,iid)
        if discussion is not None:
            context['threads'] = [mq_thread(context,discussion)]
        return context
    if (not ref or not re.fullmatch(r'[a-f0-9]{40,64}',ref) or filename.startswith('/')
            or any(p in {'','..','.'} for p in filename.split('/')) or '\\' in filename):
        raise RuntimeError('file snapshot requires a canonical repository path and exact SHA')
    context = mq_context(config,iid)
    allowed = {context['head'],*context['mr'].get('diff_refs',{}).values()}
    if ref not in allowed:
        raise RuntimeError('file ref is not the authenticated current MR head/base/start')
    api = MonitorGitLab(config)
    api.project()
    result = api.get(f"/projects/{config['project_id']}/repository/files/{quote(filename,safe='')}?ref={ref}")
    if result.get('file_path') != filename or result.get('encoding') != 'base64' or result.get('ref') != ref:
        raise RuntimeError('repository file identity/ref mismatch')
    import base64
    content = base64.b64decode(result['content'],validate=True)
    if result.get('content_sha256') and hashlib.sha256(content).hexdigest() != result['content_sha256']:
        raise RuntimeError('repository file digest mismatch')
    return {'repository_id':config['project_id'],'iid':iid,'head':context['head'],
            'path':filename,'ref':ref,'content':content.decode('utf-8')}


def mq_recover(config,identifier):
    # Read-back only. It never invents a native acknowledgement or resends an uncertain write.
    lock = mq_lock(config,'consumer')
    queue = MonitorQueue(config)
    try:
        job = queue.job(identifier)
        if not job or job['state'] != 'pending' or job['wait_reason']!='effect_unknown':
            raise RuntimeError('recover accepts only a job awaiting public-effect read-back')
        scoped = mq_repository(config,job['repository_id'])
        context = mq_context(scoped,job['iid'],with_diff=False)
        uncertain = [e for e in queue.effects() if e.get('job_id')==identifier and e['state'] not in {'prepared','confirmed','cancelled'}]
        receipts = [(effect,(mq_resolution_receipt(queue,job,effect,context) if effect['kind']=='resolve'
                            else mq_readback(scoped,queue,effect,context))) for effect in uncertain]
        if any(receipt is None for effect,receipt in receipts):
            raise RuntimeError('effect remains unconfirmed; no resend or completion permitted')
        with queue.atomic():
            if queue.job(identifier) != job:
                raise RuntimeError('recovery job changed')
            for effect,receipt in receipts:
                effect.update(state='confirmed',**receipt)
                queue.put_effect(effect)
            job.update(wait_reason=None,retry_at=0)
            queue.save(job)
        return {'reconciled':True,'job':identifier,'effects':len(receipts)}
    finally:
        queue.close(); os.close(lock)


def mq_main():
    parser = argparse.ArgumentParser(prog='codex-session-stats monitor-gitlab',description=
        'One durable FIFO and one consumer; each configured reviewer runs in order.')
    parser.add_argument('--config',type=Path,default=Path(os.environ.get('XDG_CONFIG_HOME','~/.config')).expanduser()/'codex-session-stats/gitlab-monitor.json')
    commands = parser.add_subparsers(dest='action',required=True)
    setup = commands.add_parser('configure',help='create private configuration, never overwrite')
    setup.add_argument('--project-url',required=True)
    setup.add_argument('--project-id',required=True,type=positive_integer)
    setup.add_argument('--mcp-server',default='gitlab')
    setup.add_argument('--analysis-config',type=Path,help='new analysis TOML; default beside JSON')
    commands.add_parser('initialize',help='initialize a fresh queue; never read predecessor state/chats')
    commands.add_parser('tick',help='perform one bounded queue cycle and exit')
    commands.add_parser('status',help='read fresh persisted queue state offline')
    commands.add_parser('instructions',help='print the shared reviewer result contract')
    preflight = commands.add_parser('preflight',help='read-only account, project and permission checks')
    preflight.add_argument('--check-only',action='store_true')
    snapshot = commands.add_parser('snapshot',help='read exact authenticated MR/file context; no queue mutation')
    snapshot.add_argument('--mr',required=True,type=positive_integer)
    snapshot.add_argument('--project',type=positive_integer)
    snapshot.add_argument('--discussion')
    snapshot.add_argument('--file')
    snapshot.add_argument('--ref')
    select = commands.add_parser('select-project',help='bind named project only for fresh chats')
    select.add_argument('--name',required=True)
    recover = commands.add_parser('recover',help='reconcile an uncertain effect by authenticated read-back only')
    recover.add_argument('--job',required=True)
    launch = commands.add_parser('launch-app',help='launch Codex GUI with its existing native relay')
    launch.add_argument('--app',type=Path,required=True)
    launch.add_argument('--codex',type=Path,required=True)
    launch.add_argument('app_args',nargs=argparse.REMAINDER)
    arguments = parser.parse_args(sys.argv[2:])
    try:
        path = Path(os.path.abspath(arguments.config.expanduser()))
        if arguments.action=='instructions':
            print(mq_instructions()); return 0
        if arguments.action=='configure':
            data = monitor_default_config(arguments.project_url,arguments.project_id,arguments.mcp_server)
            target = (arguments.analysis_config or path.with_name('analysis.toml')).expanduser().absolute()
            if path.exists() or target.exists():
                raise RuntimeError('configuration already exists; no files overwritten')
            values = {**{k:data.pop(k) for k in (*MONITOR_TOML_PROJECT,*MONITOR_TOML_SCHEDULE)},
                'model':data.pop('model'),'model_reasoning_effort':data.pop('effort'),
                'workspace':'~','parallel':1,'reviewers':['claude','codex']}
            data.pop('cwd')
            data['analysis_config'] = os.path.relpath(target,path.parent)
            for directory in (path.parent,target.parent):
                directory.mkdir(mode=0o700,parents=True,exist_ok=True)
            with os.fdopen(os.open(target,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600),'w') as stream:
                stream.write(''.join(key+' = '+json.dumps(value,ensure_ascii=False)+'\n' for key,value in values.items()))
            with os.fdopen(os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600),'w') as stream:
                json.dump(data,stream,ensure_ascii=False,indent=2); stream.write('\n')
            result = {'configured':True,'config':str(path)}
        else:
            config = mq_config(path,diagnostic=arguments.action=='status')
            if arguments.action=='launch-app':
                extra = arguments.app_args[1:] if arguments.app_args[:1]==['--'] else arguments.app_args
                monitor_launch_app(config,path,arguments.app,arguments.codex,extra)
            elif arguments.action=='tick':
                result = mq_tick(path)
            elif arguments.action=='status':
                result = mq_status(config)
            elif arguments.action=='initialize':
                queue = MonitorQueue(config)
                try:
                    result = {'initialized':True,'queue_file':config['queue_file']}
                finally:
                    queue.close()
            elif arguments.action=='snapshot':
                projects = mq_repositories(config)
                repository = arguments.project or (projects[0]['id'] if len(projects)==1 else None)
                if repository is None:
                    raise RuntimeError('snapshot requires --project when multiple repositories are enabled')
                result = mq_snapshot(mq_repository(config,repository),arguments.mr,arguments.file,arguments.ref,arguments.discussion)
            elif arguments.action=='recover':
                result = mq_recover(config,arguments.job)
            elif arguments.action=='select-project':
                binding = monitor_resolve_project(config,arguments.name)
                if arguments.name != config.get('codex_project_name'):
                    raise RuntimeError('set codex_project_name in analysis TOML before binding its exact project')
                if Path(config['queue_file']).exists():
                    queue = MonitorQueue(config,readonly=True)
                    try:
                        if any(r['chats'] for r in queue.mrs()):
                            raise RuntimeError('fresh queue already owns chats; project changes never reassign them')
                    finally:
                        queue.close()
                raw = json.loads(path.read_text())
                raw['codex_project_binding'] = {**binding,'existing_threads':{}}
                monitor_runtime_write(path,raw)
                result = {'selected':binding,'existing_chats_changed':False}
            elif arguments.action=='preflight':
                for project in mq_repositories(config):
                    MonitorGitLab(mq_repository(config,project['id'])).project()
                if 'codex' in config['reviewers']:
                    if config.get('codex_project_name'):
                        project = monitor_resolve_project(config,config['codex_project_name'])
                        if project['id'] != config['codex_project_binding']['id']:
                            raise RuntimeError('configured native project identity changed')
                if 'claude' in config['reviewers']:
                    mq_claude_preflight(config)
                result = {'ready':True,'reviewers':config['reviewers'],'parallel':1,'writes_performed':False}
        print(json.dumps(result,ensure_ascii=False,indent=2))
        return 0
    except (OSError,RuntimeError,ValueError,KeyError,sqlite3.Error) as failure:
        print('codex-session-stats monitor-gitlab: '+str(failure),file=sys.stderr)
        return 1


def mq_job_status(job, config=None):
    def stage_status(stage):
        value = {k:stage.get(k) for k in ('id','reviewer','state','session','turn_id','delivery','error','name','remote_url')}
        if config and stage['reviewer']=='claude' and stage.get('session') and not value['remote_url']:
            try:
                value['remote_url'] = mq_claude_url(mq_claude_records(config,stage['session']),stage)
            except (OSError,RuntimeError,ValueError) as error:
                value['remote_url_error'] = str(error)[:300]
        return value
    fields = ('id','sequence','repository_id','iid','kind','head','state','wait_reason','retry_at','outcome','validation_error',
        'admission','coalesced_jobs','coalesced_into','target_event','last_error')
    return {**{k:job.get(k) for k in fields},'reviewers':job['reviewers'],
        'source':{k:job['source'].get(k) for k in ('origin','provider','session','source_id','turn_id')},
        'stages':[stage_status(stage) for stage in job['stages']],
        'rounds':[{'reason':r['reason'],'stages':[stage_status(stage) for stage in r['stages']]}
                  for r in job.get('rounds',[])]}


def mq_consume(config,queue):
    try:
        return mq_step(config,queue)
    except (OSError,RuntimeError,ValueError) as failure:
        mq_diagnostic(queue,'consumer_error',failure)
        active = queue.jobs('running')
        if active:
            job = active[0]
            with queue.atomic():
                queue.check_running(job)
                job['last_error'] = {'at':mq_stamp(),'error':str(failure)[:3000]}
                queue.save(job)
            if not any(s['state']=='running' for s in job['stages']):
                uncertain = any(e.get('job_id')==job['id'] and e['state'] not in {'prepared','confirmed','cancelled'}
                                for e in queue.effects())
                queue.park(job,'effect_unknown' if uncertain else 'retry',
                    retry_at=0 if uncertain else mq_stamp()+config['interval_minutes']*60)
                return True  # Parking terminal work is progress; visit other MRs this cycle.
        # Unknown native work retains capacity. A known terminal failure never starves other MRs.
        return False


if __name__ == "__main__":
    raise SystemExit(main())
