+/*
+ * Native Secret Service queue regression: only human interaction is simulated.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "config.h"
+#include "gkd-secret-types.h"
+#include "test-service.h"
+#include "egg/egg-testing.h"
+
+#define GCR_API_SUBJECT_TO_CHANGE
+#include <gcr/gcr-base.h>
+
+#define COLLECTION "/org/freedesktop/secrets/collection/test"
+
+/* Keep a real GCR conversation pending until the test supplies a human response. */
+typedef struct { GObject parent; GHashTable *properties; } HumanPrompt;
+typedef GObjectClass HumanPromptClass;
+static GTask *pending_password;
+static guint password_count;
+static void human_prompt_iface (GcrPromptIface *iface);
+G_DEFINE_TYPE_WITH_CODE (HumanPrompt, human_prompt, G_TYPE_OBJECT,
+                        G_IMPLEMENT_INTERFACE (GCR_TYPE_PROMPT, human_prompt_iface))
+
+static void
+value_free (gpointer data)
+{
+	g_value_unset (data);
+	g_free (data);
+}
+
+static void
+human_get (GObject *object, guint id, GValue *value, GParamSpec *spec)
+{
+	GValue *stored = g_hash_table_lookup (((HumanPrompt *)object)->properties, spec->name);
+	if (stored)
+		g_value_copy (stored, value);
+	else
+		g_param_value_set_default (spec, value);
+}
+
+static void
+human_set (GObject *object, guint id, const GValue *value, GParamSpec *spec)
+{
+	GValue *stored = g_new0 (GValue, 1);
+	g_value_init (stored, G_VALUE_TYPE (value));
+	g_value_copy (value, stored);
+	g_hash_table_replace (((HumanPrompt *)object)->properties, g_strdup (spec->name), stored);
+}
+
+static void
+human_finalize (GObject *object)
+{
+	g_hash_table_unref (((HumanPrompt *)object)->properties);
+	G_OBJECT_CLASS (human_prompt_parent_class)->finalize (object);
+}
+
+static void
+human_prompt_class_init (HumanPromptClass *klass)
+{
+	gpointer iface = g_type_default_interface_ref (GCR_TYPE_PROMPT);
+	guint count, i;
+	GParamSpec **properties = g_object_interface_list_properties (iface, &count);
+	klass->get_property = human_get;
+	klass->set_property = human_set;
+	klass->finalize = human_finalize;
+	for (i = 0; i < count; i++)
+		g_object_class_override_property (klass, i + 1, properties[i]->name);
+	g_free (properties);
+	g_type_default_interface_unref (iface);
+}
+
+static void
+human_prompt_init (HumanPrompt *self)
+{
+	self->properties = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, value_free);
+}
+
+static void
+human_password (GcrPrompt *prompt, GCancellable *cancel,
+                GAsyncReadyCallback callback, gpointer data)
+{
+	g_assert_null (pending_password);
+	pending_password = g_task_new (prompt, cancel, callback, data);
+	password_count++;
+}
+
+static const gchar *
+human_password_finish (GcrPrompt *prompt, GAsyncResult *result, GError **error)
+{
+	return g_task_propagate_pointer (G_TASK (result), error);
+}
+
+static void
+human_confirm (GcrPrompt *prompt, GCancellable *cancel,
+               GAsyncReadyCallback callback, gpointer data)
+{
+	g_assert_not_reached ();
+}
+
+static GcrPromptReply
+human_confirm_finish (GcrPrompt *prompt, GAsyncResult *result, GError **error)
+{
+	g_assert_not_reached ();
+	return GCR_PROMPT_REPLY_CANCEL;
+}
+
+static void
+human_prompt_iface (GcrPromptIface *iface)
+{
+	iface->prompt_password_async = human_password;
+	iface->prompt_password_finish = human_password_finish;
+	iface->prompt_confirm_async = human_confirm;
+	iface->prompt_confirm_finish = human_confirm_finish;
+}
+
+typedef struct {
