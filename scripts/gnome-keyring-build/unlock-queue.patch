+typedef struct {
+	TestService service;
+	GcrSystemPrompter *prompter;
+	GPtrArray *completed;
+	GPtrArray *clients;
+	GArray *subscriptions;
+	gchar *other;
+} Test;
+
+static gboolean
+expired (gpointer unused)
+{
+	g_error ("unlock queue did not reach the required terminal state");
+	return G_SOURCE_REMOVE;
+}
+
+/* Deadlines bound failure; arrival of the actual event controls progress. */
+#define WAIT_FOR(condition) G_STMT_START { \
+	guint deadline = g_timeout_add_seconds (5, expired, NULL); \
+	while (!(condition)) g_main_context_iteration (NULL, TRUE); \
+	g_source_remove (deadline); \
+} G_STMT_END
+
+static GVariant *
+call (Test *test, GDBusConnection *client, const gchar *path,
+      const gchar *interface, const gchar *method, GVariant *args, const gchar *type)
+{
+	GError *error = NULL;
+	GVariant *result = g_dbus_connection_call_sync (client, test->service.bus_name,
+		path, interface, method, args, G_VARIANT_TYPE (type),
+		G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, NULL, &error);
+	g_assert_no_error (error);
+	g_assert_nonnull (result);
+	return result;
+}
+
+static gboolean
+locked (Test *test, const gchar *path)
+{
+	GVariant *reply = call (test, test->service.connection, path,
+		"org.freedesktop.DBus.Properties", "Get",
+		g_variant_new ("(ss)", SECRET_COLLECTION_INTERFACE, "Locked"), "(v)");
+	GVariant *value;
+	gboolean result;
+	g_variant_get (reply, "(v)", &value);
+	result = g_variant_get_boolean (value);
+	g_variant_unref (value);
+	g_variant_unref (reply);
+	return result;
+}
+
+static void
+completion_free (gpointer data)
+{
+	Completion *result = data;
+	g_free (result->path);
+	g_strfreev (result->unlocked);
+	g_free (result);
+}
+
+static void
+completed (GDBusConnection *connection, const gchar *sender, const gchar *path,
+           const gchar *interface, const gchar *signal, GVariant *args, gpointer data)
+{
+	Test *test = data;
+	Completion *result = g_new0 (Completion, 1);
+	GVariant *value;
+	guint i;
+	for (i = 0; i < test->completed->len; i++)
+		g_assert_cmpstr (((Completion *)g_ptr_array_index (test->completed, i))->path, !=, path);
+	result->path = g_strdup (path);
+	g_variant_get (args, "(bv)", &result->dismissed, &value);
+	result->unlocked = g_variant_dup_objv (value, NULL);
+	g_variant_unref (value);
+	g_ptr_array_add (test->completed, result);
+}
+
+static GDBusConnection *
+client_new (Test *test)
+{
+	GError *error = NULL;
+	GDBusConnection *client = g_dbus_connection_new_for_address_sync (
+		g_getenv ("DBUS_SESSION_BUS_ADDRESS"),
+		G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+		NULL, NULL, &error);
+	guint subscription;
+	g_assert_no_error (error);
+	subscription = g_dbus_connection_signal_subscribe (client, test->service.bus_name,
+		SECRET_PROMPT_INTERFACE, "Completed", NULL, NULL, G_DBUS_SIGNAL_FLAGS_NONE,
+		completed, test, NULL);
+	g_ptr_array_add (test->clients, client);
+	g_array_append_val (test->subscriptions, subscription);
+	return client;
+}
+
+static void
+setup (Test *test, gconstpointer unused)
+{
+	GError *error = NULL;
+	GDBusConnection *bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &error);
+	g_assert_no_error (error);
+	g_assert_null (pending_password);
+	password_count = 0;
+	test->completed = g_ptr_array_new_with_free_func (completion_free);
+	test->clients = g_ptr_array_new_with_free_func (g_object_unref);
+	test->subscriptions = g_array_new (FALSE, FALSE, sizeof (guint));
+	test->prompter = gcr_system_prompter_new (GCR_SYSTEM_PROMPTER_SINGLE, human_prompt_get_type ());
+	gcr_system_prompter_register (test->prompter, bus);
+	test->service.mock_prompter = g_dbus_connection_get_unique_name (bus);
+	test_service_setup (&test->service);
+	g_assert_true (locked (test, COLLECTION));
+	g_object_unref (bus);
+}
+
+static void
+teardown (Test *test, gconstpointer unused)
+{
+	guint i;
+	/* Consume callbacks already delivered before detaching the assertions. */
+	while (g_main_context_iteration (NULL, FALSE));
+	g_assert_null (pending_password);
+	for (i = 0; i < test->clients->len; i++)
+		g_dbus_connection_signal_unsubscribe (g_ptr_array_index (test->clients, i),
+			g_array_index (test->subscriptions, guint, i));
+	test_service_teardown (&test->service);
+	gcr_system_prompter_unregister (test->prompter, TRUE);
+	g_object_unref (test->prompter);
+	g_ptr_array_unref (test->clients);
+	g_array_unref (test->subscriptions);
+	g_ptr_array_unref (test->completed);
+	g_free (test->other);
+}
+
+static gchar *
+admit (Test *test, GDBusConnection *client, const gchar **collections)
+{
+	GVariant *reply = call (test, client, SECRET_SERVICE_PATH, SECRET_SERVICE_INTERFACE,
+		"Unlock", g_variant_new ("(^ao)", collections), "(aoo)");
+	GVariant *unlocked;
+	gchar *prompt;
+	g_variant_get (reply, "(@aoo)", &unlocked, &prompt);
+	g_assert_cmpuint (g_variant_n_children (unlocked), ==, 0);
+	g_assert_cmpstr (prompt, !=, "/");
+	g_variant_unref (unlocked);
+	g_variant_unref (reply);
+	reply = call (test, client, prompt, SECRET_PROMPT_INTERFACE, "Prompt",
+		g_variant_new ("(s)", ""), "()");
+	g_variant_unref (reply);
+	return prompt;
+}
+
+static void
+answer (const gchar *password)
+{
+	GTask *task;
+	WAIT_FOR (pending_password != NULL);
+	task = g_steal_pointer (&pending_password);
+	g_task_return_pointer (task, (gpointer)password, NULL);
+	g_object_unref (task);
+}
+
+static void
+expect_completion (Test *test, guint index, const gchar *path, gboolean dismissed,
+                   const gchar **unlocked)
+{
+	Completion *result;
+	guint i;
+	WAIT_FOR (test->completed->len > index);
+	result = g_ptr_array_index (test->completed, index);
+	g_assert_cmpstr (result->path, ==, path);
+	g_assert_cmpint (result->dismissed, ==, dismissed);
+	for (i = 0; unlocked && unlocked[i]; i++)
+		g_assert_cmpstr (result->unlocked[i], ==, unlocked[i]);
+	g_assert_null (result->unlocked[i]);
+}
+
+static void
+cancel_many (Test *test, gconstpointer data)
+{
+	guint count = GPOINTER_TO_UINT (data), i;
+	const gchar *paths[] = { COLLECTION, NULL };
+	gchar *prompts[5];
+	for (i = 0; i < count; i++) {
+		prompts[i] = admit (test, client_new (test), paths);
+		if (i == 0) WAIT_FOR (pending_password != NULL);
+	}
+	for (i = 0; i < count; i++) {
+		answer (NULL);
+		expect_completion (test, i, prompts[i], TRUE, NULL);
+		g_free (prompts[i]);
+	}
+	g_assert_cmpuint (password_count, ==, count);
+	g_assert_true (locked (test, COLLECTION));
+	g_assert_cmpuint (test->completed->len, ==, count);
+}
+
+static void
+success_shared (Test *test, gconstpointer unused)
+{
+	const gchar *paths[] = { COLLECTION, NULL };
+	gchar *prompts[3];
+	guint i;
+	for (i = 0; i < 3; i++) {
+		prompts[i] = admit (test, client_new (test), paths);
+		if (i == 0) WAIT_FOR (pending_password != NULL);
+	}
+	answer ("booo");
+	for (i = 0; i < 3; i++) {
+		expect_completion (test, i, prompts[i], FALSE, paths);
+		g_free (prompts[i]);
+	}
+	g_assert_cmpuint (password_count, ==, 1);
+	g_assert_false (locked (test, COLLECTION));
+	g_assert_cmpuint (test->completed->len, ==, 3);
+}
+
+static void
+create_other (Test *test)
+{
+	GVariantBuilder attributes;
+	GVariant *reply;
+	g_variant_builder_init (&attributes, G_VARIANT_TYPE ("a{sv}"));
+	g_variant_builder_add (&attributes, "{sv}", SECRET_COLLECTION_INTERFACE ".Label",
+		g_variant_new_string ("Other"));
+	reply = call (test, test->service.connection, SECRET_SERVICE_PATH, INTERNAL_SERVICE_INTERFACE,
+		"CreateWithMasterPassword", g_variant_new ("(a{sv}@(oayays))", &attributes,
+		 test_service_build_secret (&test->service, "booo")), "(o)");
+	g_variant_get (reply, "(o)", &test->other);
+	g_variant_unref (reply);
+	reply = call (test, test->service.connection, SECRET_SERVICE_PATH, SECRET_SERVICE_INTERFACE,
+		"LockService", g_variant_new ("()"), "()");
+	g_variant_unref (reply);
+	g_assert_true (locked (test, test->other));
+}
+
+static void
+mixed_collections (Test *test, gconstpointer unused)
+{
+	const gchar *both[] = { COLLECTION, NULL, NULL };
+	const gchar *only_other[] = { NULL, NULL };
+	gchar *first, *second;
+	create_other (test);
+	both[1] = only_other[0] = test->other;
+	first = admit (test, client_new (test), both);
+	WAIT_FOR (pending_password != NULL);
+	second = admit (test, client_new (test), only_other);
+	answer ("booo");
+	answer ("booo");
+	expect_completion (test, 0, first, FALSE, both);
+	expect_completion (test, 1, second, FALSE, only_other);
+	g_assert_false (locked (test, COLLECTION));
+	g_assert_false (locked (test, test->other));
+	g_assert_cmpuint (password_count, ==, 2);
+	g_free (first);
+	g_free (second);
+}
+
+static void
+dismiss (Test *test, GDBusConnection *client, const gchar *path)
+{
+	GVariant *reply = call (test, client, path, SECRET_PROMPT_INTERFACE,
+		"Dismiss", NULL, "()");
+	g_variant_unref (reply);
+}
+
+static void
+dismiss_queued (Test *test, gconstpointer unused)
+{
+	const gchar *paths[] = { COLLECTION, NULL };
+	GDBusConnection *a = client_new (test), *b = client_new (test);
+	gchar *first = admit (test, a, paths), *middle, *last, *fresh;
+	WAIT_FOR (pending_password != NULL);
+	middle = admit (test, b, paths);
+	last = admit (test, a, paths);
+	dismiss (test, b, middle);
+	expect_completion (test, 0, middle, TRUE, NULL);
+	g_assert_cmpuint (password_count, ==, 1);
+	answer (NULL);
+	expect_completion (test, 1, first, TRUE, NULL);
+	answer (NULL);
+	expect_completion (test, 2, last, TRUE, NULL);
+	fresh = admit (test, a, paths);
+	answer (NULL);
+	expect_completion (test, 3, fresh, TRUE, NULL);
+	g_assert_true (locked (test, COLLECTION));
+	g_assert_cmpuint (password_count, ==, 3);
+	g_free (first); g_free (middle); g_free (last); g_free (fresh);
+}
+
+static void
+dismiss_active (Test *test, gconstpointer data)
+{
+	gboolean accept = GPOINTER_TO_INT (data);
+	const gchar *both[] = { COLLECTION, NULL, NULL };
+	const gchar *other[] = { NULL, NULL };
+	GDBusConnection *a = client_new (test), *b = client_new (test);
+	gchar *first, *second;
+	create_other (test);
+	both[1] = other[0] = test->other;
+	first = admit (test, a, both);
+	WAIT_FOR (pending_password != NULL);
+	second = admit (test, b, other);
+	dismiss (test, a, first);
+	expect_completion (test, 0, first, TRUE, NULL);
+	g_assert_cmpuint (password_count, ==, 1);
+	answer (accept ? "booo" : NULL);
+	answer (NULL);
+	expect_completion (test, 1, second, TRUE, NULL);
+	g_assert_cmpint (locked (test, COLLECTION), ==, !accept);
+	g_assert_true (locked (test, test->other));
+	g_assert_cmpuint (password_count, ==, 2);
+	g_assert_cmpuint (test->completed->len, ==, 2);
+	g_free (first); g_free (second);
+}
+
+static void
+disconnect_client (Test *test, gconstpointer data)
+{
+	gboolean active = GPOINTER_TO_INT (data);
+	const gchar *paths[] = { COLLECTION, NULL };
+	GDBusConnection *gone = client_new (test), *live = client_new (test);
+	gchar *first = admit (test, active ? gone : live, paths);
+	gchar *queued, *last;
+	GError *error = NULL;
+	WAIT_FOR (pending_password != NULL);
+	queued = admit (test, gone, paths);
+	last = admit (test, live, paths);
+	g_assert_true (g_dbus_connection_close_sync (gone, NULL, &error));
+	g_assert_no_error (error);
+	/* NameHasOwner from the same bus establishes that the disconnect reached it.
+	 * Its NameOwnerChanged precedes the subsequent daemon call on that bus. */
+	{
+		GVariant *reply = g_dbus_connection_call_sync (live, "org.freedesktop.DBus",
+			"/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
+			g_variant_new ("(s)", g_dbus_connection_get_unique_name (gone)),
+			G_VARIANT_TYPE ("(b)"), 0, 5000, NULL, &error);
+		gboolean owned;
+		g_assert_no_error (error);
+		g_variant_get (reply, "(b)", &owned);
+		g_assert_false (owned);
+		g_variant_unref (reply);
+	}
+	g_assert_true (locked (test, COLLECTION));
+	answer (NULL);
+	if (!active) expect_completion (test, 0, first, TRUE, NULL);
+	answer (NULL);
+	expect_completion (test, active ? 0 : 1, last, TRUE, NULL);
+	g_assert_cmpuint (password_count, ==, 2);
+	g_assert_cmpuint (test->completed->len, ==, active ? 1 : 2);
+	g_assert_true (locked (test, COLLECTION));
+	g_free (first); g_free (queued); g_free (last);
+}
+
+int
+main (int argc, char **argv)
+{
+	g_test_init (&argc, &argv, NULL);
+	g_test_add ("/unlock/cancel-one", Test, GUINT_TO_POINTER (1), setup, cancel_many, teardown);
+	g_test_add ("/unlock/cancel-two", Test, GUINT_TO_POINTER (2), setup, cancel_many, teardown);
+	g_test_add ("/unlock/cancel-three", Test, GUINT_TO_POINTER (3), setup, cancel_many, teardown);
+	g_test_add ("/unlock/cancel-five", Test, GUINT_TO_POINTER (5), setup, cancel_many, teardown);
+	g_test_add ("/unlock/success-shared", Test, NULL, setup, success_shared, teardown);
+	g_test_add ("/unlock/mixed-collections", Test, NULL, setup, mixed_collections, teardown);
+	g_test_add ("/unlock/dismiss-queued", Test, NULL, setup, dismiss_queued, teardown);
+	g_test_add ("/unlock/dismiss-active-cancel", Test, NULL, setup, dismiss_active, teardown);
+	g_test_add ("/unlock/dismiss-active-accept", Test, GINT_TO_POINTER (1), setup, dismiss_active, teardown);
+	g_test_add ("/unlock/disconnect-queued", Test, NULL, setup, disconnect_client, teardown);
+	g_test_add ("/unlock/disconnect-active", Test, GINT_TO_POINTER (1), setup, disconnect_client, teardown);
+	return egg_tests_run_with_loop ();
+}
