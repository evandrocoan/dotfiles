+		"Prompt", g_variant_new ("(s)", ""), G_VARIANT_TYPE_UNIT, &error);
+	g_assert_no_error (error);
+	g_variant_unref (reply);
+	while (results.count < 2) g_main_context_iteration (NULL, TRUE);
+	reply = call (test, paths[0], "org.freedesktop.DBus.Properties", "Get",
+		g_variant_new ("(ss)", SECRET_COLLECTION_INTERFACE, "Locked"),
+		G_VARIANT_TYPE ("(v)"), &error);
+	g_assert_no_error (error);
+	g_variant_get (reply, "(v)", &unlocked);
+	g_assert_true (g_variant_get_boolean (unlocked));
+	g_variant_unref (unlocked);
+	g_variant_unref (reply);
+	g_assert_cmpuint (results.count, ==, 2);
+	g_source_remove (deadline);
+	g_dbus_connection_signal_unsubscribe (test->client, subscription);
