+
+static void
+unlock_completed (GDBusConnection *connection, const gchar *sender,
+                  const gchar *path, const gchar *interface, const gchar *signal,
+                  GVariant *args, gpointer data)
+{
+	UnlockResults *results = data;
+	gboolean dismissed;
+	GVariant *unlocked;
+	g_assert_cmpuint (results->count, <, results->paths->len);
+	g_assert_cmpstr (path, ==, g_ptr_array_index (results->paths, results->count));
+	g_variant_get (args, "(bv)", &dismissed, &unlocked);
+	g_assert_true (dismissed);
+	g_assert_true (g_variant_is_of_type (unlocked, G_VARIANT_TYPE ("ao")));
+	g_assert_cmpuint (g_variant_n_children (unlocked), ==, 0);
+	g_variant_unref (unlocked);
+	results->count++;
+}
+
+static void
+test_unlock_failure (Test *test, gconstpointer data)
+{
+	Fault fault = GPOINTER_TO_INT (data);
+	const gchar *paths[] = { SECRET_COLLECTION_PREFIX "/test", NULL };
+	GError *error = NULL;
+	GVariant *reply, *unlocked;
+	UnlockResults results = { g_ptr_array_new_with_free_func (g_free), 0 };
+	guint subscription, deadline, i;
+	gchar *prompt;
+
+	subscription = g_dbus_connection_signal_subscribe (test->client,
+		g_dbus_connection_get_unique_name (test->server), SECRET_PROMPT_INTERFACE,
+		"Completed", NULL, NULL, G_DBUS_SIGNAL_FLAGS_NONE, unlock_completed, &results, NULL);
+	deadline = g_timeout_add_seconds (5, unlock_deadline, NULL);
+	for (i = 0; i < 2; i++) {
+		reply = call (test, SECRET_SERVICE_PATH, SECRET_SERVICE_INTERFACE, "Unlock",
+			g_variant_new ("(^ao)", paths), G_VARIANT_TYPE ("(aoo)"), &error);
+		g_assert_no_error (error);
+		g_variant_get (reply, "(@aoo)", &unlocked, &prompt);
+		g_assert_cmpuint (g_variant_n_children (unlocked), ==, 0);
+		g_assert_cmpstr (prompt, !=, "/");
+		g_ptr_array_add (results.paths, prompt);
+		g_variant_unref (unlocked);
+		g_variant_unref (reply);
+	}
+
+	/* Arm only after admission's empty-password probes have finished. */
+	test->fault = fault;
+	test->drop_session_on_locked = fault == FAULT_OPEN;
+	if (fault == FAULT_OPEN)
+		g_test_expect_message (NULL, G_LOG_LEVEL_WARNING, "couldn't open pkcs11 session for secret service: *");
+	else if (fault == FAULT_CREDENTIAL)
+		g_test_expect_message (NULL, G_LOG_LEVEL_WARNING, "couldn't create credential for collection: *");
+	reply = call (test, g_ptr_array_index (results.paths, 0), SECRET_PROMPT_INTERFACE,
+		"Prompt", g_variant_new ("(s)", ""), G_VARIANT_TYPE_UNIT, &error);
+	g_assert_no_error (error);
+	g_variant_unref (reply);
+	while (results.count < 1) g_main_context_iteration (NULL, TRUE);
+	g_test_assert_expected_messages ();
+	g_assert_cmpuint (test->injections, ==, 1);
+	test->fault = FAULT_NONE;
