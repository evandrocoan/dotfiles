[Unit]
Description=Consume the shared GitLab MR review FIFO
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-session-stats monitor-gitlab tick
TimeoutStartSec=14min
KillMode=process
TimeoutStopSec=15s
UMask=0077
StandardOutput=journal
StandardError=journal
