# URL of your ExcaliDash instance (no trailing slash)
EXCALIDASH_URL=http://localhost:6767

# API key generated in ExcaliDash Settings → API Keys
# Required scopes: drawings:write, collections:read
EXCALIDASH_API_KEY=

# GitLab MCP authentication
GITLAB_API_URL=https://gitlab.example.com
GITLAB_PERSONAL_ACCESS_TOKEN=
